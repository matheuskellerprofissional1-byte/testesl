        and not condStringItems:find("target", 1, true) and not condStringItems:find("goal", 1, true) then
        val = math.max(val or 0, loopItemInfbTemp)
      elseif type(loopItemInfbTemp) == "table" then
        local localInfdFinal = scanDescendantParts(loopItemInfbTemp, secondArg)

