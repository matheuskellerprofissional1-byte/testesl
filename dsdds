      drinkTestConfig.postDrinkLandingWitness = {
        character = sixthCheckCondition,
        origin = localInfdNext.Position,
        expectedClearance = localInfdNext.Position.Y - drinkSolidTerrain,
        colliders = emptyTableWork,
        startedAt = tick(),
        untilAt = tick() + 12,
        evidence = 0,
        firstEvidenceAt = 0,
        lastSampleAt = 0,
        attempts = 0,
      }
    end

    return true
  end

  if drinkTestAbove then
    drinkTestAbove = checkConditionaOther(0.85)

    if not drinkTestAbove and sixthCheckCondition == localPlayer.Character and localInfdNext and localHealthEject and localHealthEject.Health > 0 then
      Settings.drinkTestGhostCharacter(sixthCheckCondition, true)
      Settings.drinkTestSetTransitPhysics(sixthCheckCondition, localHealthEject, true)

      sixthCheckCondition:SetAttribute("MovementDisabled", true)
      local respawnLocation = Settings.drinkSolidTerrainSurfaceYield(ejectTransformData, conditionValueType, localInfdNext.Position.Y)

      local ejectLocalValue = typeof(respawnLocation) == "number" and respawnLocation + terrainEmbedExpected + 4
        or localInfdNext.Position.Y + terrainEmbedExpected + 10

      checkConditionaNext(Vector3.new(ejectTransformData, ejectLocalValue, conditionValueType), 16)
      drinkTestAbove = Settings.drinkTestAboveTerrainConfirmed()

      if drinkTestAbove then
        drinkTestAbove = checkConditionaOther(1.15)
      end
    end
  end

  if not drinkTestAbove then
    Settings.drinkTestGhostCharacter(sixthCheckCondition, true)
    Settings.drinkTestSetTransitPhysics(sixthCheckCondition, localHealthEject, true)

    sixthCheckCondition:SetAttribute("MovementDisabled", true)

    localInfdNext.AssemblyLinearVelocity = Vector3.new(
      0, math.max(35, Settings.safeMovementSpeed(sixthCheckCondition) * 0.75), 0
    )
  end

  drinkTestConfig.hardExitConfirmed = drinkTestAbove
  drinkTestConfig.hardExitBusy = false

  Settings.drinkDiagLog("hard_exit_end", "confirmed=" .. tostring(drinkTestAbove))
  Settings.drinkDiagSampleSafe(true)

  return drinkTestAbove
end

