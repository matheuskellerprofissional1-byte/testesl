  if pcallResultWater and typeof(pcallResultWater) == "cFrame" and typeof(waterOperationSuccess) == "Vector3" then
    local waterBoundedValue = math.clamp(math.max(waterOperationSuccess.X, waterOperationSuccess.Z) * 0.28, 1.5, 5.5)
    local newResultNew = pcallResultWater.Position - Vector3.new(0, waterOperationSuccess.Y * 0.38, 0)
    local waterNewResult = pcallResultWater.Position - Vector3.new(0, math.max(0, waterOperationSuccess.Y * 0.5 - 0.75), 0)

    if conditionCheckCondition(newResultNew, waterBoundedValue, 3) or conditionCheckCondition(waterNewResult, waterBoundedValue, 2.25) then
      return true
    end
  end

  if Settings.isDirectWaterContact(secondArg) then
    return true
  end

  local mainWaterPartNext = workspace:FindFirstChild("MainWaterPart")

  if mainWaterPartNext and mainWaterPartNext:IsA("BasePart") then
    if Settings.drinkMainWaterSurface
      and Settings.drinkMainWaterSurface(mainWaterPartNext, secondArg.Position.X, secondArg.Position.Z) then
      local characterObjectSpace = mainWaterPartNext.cFrame:PointToObjectSpace(secondArg.Position)
      local waterSizeValue = mainWaterPartNext.Size * 0.5
      local waterRootClearance = Settings.movementRootClearance(firstArg)

      if math.abs(characterObjectSpace.X) <= waterSizeValue.X + 1.5
        and math.abs(characterObjectSpace.Z) <= waterSizeValue.Z + 1.5
        and characterObjectSpace.Y <= waterSizeValue.Y + waterRootClearance + 1
        and characterObjectSpace.Y >= -waterSizeValue.Y - waterRootClearance - 2 then
        return true
      end
    end
  end

  return false
end

