function Settings.dynamicMovementSpeed(conditionFindMove, secondArg, ...)
  conditionFindMove = conditionFindMove or localPlayer.Character
  local movementAcceleration = Settings.rawMovementAcceleration(conditionFindMove)
  local growthRatio = Settings.movementGrowthRatio(conditionFindMove)
  local speedBoundedValue = 0.3 + 0.7 * growthRatio

  local locaSwimmingMove = secondArg == "Swimming"
      and (isDinoLifePlaceId and Settings.safeMovementAnimalKey(conditionFindMove) == "brachiosaurus" and 1 or 0.82)
    or 1

  if movementAcceleration and movementAcceleration > 0 then
    if Settings.isDinoRexMovementCharacter(conditionFindMove) then
      local speedMovementHumanoid = conditionFindMove and conditionFindMove:FindFirstChildOfClass("Humanoid")

      local speedHeavyWalk = Settings.heavyWalk and Settings.heavyWalk.character == conditionFindMove
        and tonumber(Settings.heavyWalk.originalWalkSpeed)

      local limitValue16 = math.max(
        movementAcceleration, speedHeavyWalk or speedMovementHumanoid and tonumber(speedMovementHumanoid.WalkSpeed) or 0
      )

      local speedClampedValue = math.clamp(1.08 + 0.16 * growthRatio, 1.08, 1.24)
      return limitValue16 * locaSwimmingMove * speedClampedValue, movementAcceleration, growthRatio
    end

    if animalNameResolver.isCharacter(conditionFindMove) then
      return math.min(movementAcceleration * (0.6 + 0.4 * growthRatio) * locaSwimmingMove, movementAcceleration), movementAcceleration, growthRatio
    end

    if Settings.isFlyingMovementCharacter(conditionFindMove) then
      local 9Property = movementAcceleration * speedBoundedValue * locaSwimmingMove * 0.9
      return math.min(9Property, movementAcceleration * 0.92), movementAcceleration, growthRatio
    end

    if utilityHelper(conditionFindMove) then
      local stageScale = movementAcceleration * Settings.giraffeMovementStageScale(growthRatio) * locaSwimmingMove
      return math.min(stageScale, movementAcceleration * 0.98), movementAcceleration, growthRatio
    end

    local 95Property = growthRatio >= 0.95
    local speedMovementLocalValue = 95Property and 1.1 or speedBoundedValue
    local speedMovej = movementAcceleration * locaSwimmingMove * speedMovementLocalValue
    local speedCondition = 95Property and movementAcceleration * 1.12 or movementAcceleration * speedBoundedValue
    return math.min(speedMovej, speedCondition), movementAcceleration, growthRatio
  end

  local ofClass2 = conditionFindMove and conditionFindMove:FindFirstChildOfClass("Humanoid")

  local speedNum2 = ofClass2 and tonumber(ofClass2.WalkSpeed)
    or Settings.isFlyingMovementCharacter(conditionFindMove) and 12 or 16

  speedNum2 = math.max(1, speedNum2)

  return speedNum2 * speedBoundedValue * locaSwimmingMove * 0.9, 0, growthRatio
end

