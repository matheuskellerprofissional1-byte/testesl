    function authorityRef.CriticalPreemption(firstArg, secondArg, thirdArg, preemptionAllowed, ...)
      preemptionAllowed = preemptionAllowed or mmbaiAuthority.Blackboard

      if not secondArg or secondArg == "None" or secondArg == thirdArg then
        return false, nil
      end

      local resultPreemption, resultPreemption, resultPreemption, preemptionVitalsResult = firstArg:Vitals(preemptionAllowed)
