    local testAtResult = cFrame.lookAt(localSpot.stand, localSpot.stand + vectorhMore, Vector3.yAxis)
    local toObjectSpace
    pcall(function(...) toObjectSpace = testTestSmoothMove.cFrame:ToObjectSpace(testPlayerCharacter:GetPivot()) end)

