function Settings.dinoSemiAquatic(firstArg, ...)
  if typeof(firstArg) ~= "Vector3" then
    return nil, nil
  end

  local gameTerrainWaterHeightAt = Settings.gameTerrainWaterHeightAt
      and Settings.gameTerrainWaterHeightAt(firstArg)
    or nil

  if type(gameTerrainWaterHeightAt) == "number" then
    return gameTerrainWaterHeightAt, "Terrain"
  end

  local y = nil
  local nilRef11 = nil
  local mainWaterPart = workspace:FindFirstChild("MainWaterPart")

  if mainWaterPart and mainWaterPart:IsA("BasePart") then
    local pointToObjectSpace = mainWaterPart.cFrame:PointToObjectSpace(firstArg)

    if math.abs(pointToObjectSpace.X) <= mainWaterPart.Size.X * 0.5
      and math.abs(pointToObjectSpace.Z) <= mainWaterPart.Size.Z * 0.5 then
      y = mainWaterPart.cFrame:PointToWorldSpace(Vector3.new(
        pointToObjectSpace.X, mainWaterPart.Size.Y * 0.5, pointToObjectSpace.Z
      )).Y

      nilRef11 = "MainWaterPart"
    end
  end

  if type(y) ~= "number" and Settings.gameWaterSurfaceHeightAt then
    y, nilRef11 = Settings.gameWaterSurfaceHeightAt(firstArg)
  end

  if type(y) ~= "number" then
    return nil, nil
  end

  local landSlopeTerrainHeightAt = Settings.landSlopeTerrainHeightAt
      and Settings.landSlopeTerrainHeightAt(firstArg, y)
    or nil

  if type(landSlopeTerrainHeightAt) == "number" and landSlopeTerrainHeightAt >= y - 0.35 then
    return nil, nil
  end

  return y, nilRef11 or "Global"
end

