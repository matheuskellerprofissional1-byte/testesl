    strLitInf = drinkTestMore.lastError
    return false
  end

  if firstArg == true then
    Settings.drinkDiagBegin(localPlayer.Character)
    Settings.drinkDiagLog("preflight", "manual HUD request accepted; automatic mode remains surface")
  end

  if postureInvalid or Settings.questGrowthReset.exclusive or Settings.questGrowthReset.busy or mmbaiConfig.active then
    strLitInf = "Underground Drink unavailable: another safety/reset controller is active"
    Settings.drinkDiagFinish(strLitInf)
