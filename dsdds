      localInfdNext.cFrame = cFrame.new(localInfdNext.Position.X, limitCalc7 + 0.04, localInfdNext.Position.Z) * rotationProperty
      localInfdNext.AssemblyLinearVelocity = Vector3.zero
      localInfdNext.AssemblyAngularVelocity = Vector3.zero

