      end

      Settings.drinkDiagLog("hover", "virtual floor and sole started")
    else
      Settings.drinkTestSetTransitPhysics(sixthCheckCondition, localHealthEject, false)
      sixthCheckCondition:SetAttribute("MovementDisabled", false)

      localInfdNext.AssemblyLinearVelocity = Vector3.zero
      localInfdNext.AssemblyAngularVelocity = Vector3.zero

      isFalseInf = false
    end

    local limitValue55 = tick() + math.max(1.15, tonumber(firstArg) or 0.8)

    while Settings.alive and tick() < limitValue55 do
      local conditionSupervisorPermit, conditionSupervisorPermit, local = handleChar()

      if conditionSupervisorPermit ~= sixthCheckCondition or not conditionSupervisorPermit or not local or local.Health <= 0 then
        if safeMovementAnimalKeyConfig3 then
          Settings.elephantHoverStop()
        end

        return false
      end

      localInfdNext = conditionSupervisorPermit
      localHealthEject = local

      if safeMovementAnimalKeyConfig3 then
        local elephantHoverConfig = Settings.elephantHover

        local local = Settings.drinkSolidTerrainSurfaceYield(
          localInfdNext.Position.X, localInfdNext.Position.Z, localInfdNext.Position.Y
        )

        if not elephantHoverConfig or elephantHoverConfig.character ~= sixthCheckCondition or not elephantHoverConfig.floor
          or not elephantHoverConfig.floor.Parent or not elephantHoverConfig.sole
          or not elephantHoverConfig.sole.Parent or type(local) ~= "number" then
          Settings.elephantHoverStop()
          return false
        end

        if elephantHoverConfig.update then
          elephantHoverConfig.update()
        end

        if localInfdNext.Position.Y < local + elephantHoverConfig.baseClearance * elephantHoverConfig.scale - 0.35 then
          Settings.drinkDiagLog("hover", "clearance correction did not hold")
          Settings.elephantHoverStop()
          return false
        end
      end

      if not Settings.drinkTestGhostCharacter(sixthCheckCondition, false) then
        if safeMovementAnimalKeyConfig3 then
          Settings.elephantHoverStop()
        end

        return false
      end

      if localInfdNext.Position.Y < GameConfig.dangeryForhelper or Settings.drinkIsBuriedUnderTerrain(localInfdNext) then
        if safeMovementAnimalKeyConfig3 then
          Settings.elephantHoverStop()
        end

        return false
      end

      if Settings.terrainEmbedMeasure then
        local local = Settings.terrainEmbedMeasure(sixthCheckCondition, localInfdNext, localHealthEject)

        if local and local.embedded == true then
          if safeMovementAnimalKeyConfig3 then
            Settings.elephantHoverStop()
          end

          return false
        end
      end

      runService.Heartbeat:Wait()
    end

    if isNotJungleLife and Settings.safeMovementAnimalKey(sixthCheckCondition) == "elephant" and type(drinkSolidTerrain) == "number"
      and not Settings.elephantHover then
      local emptyTableWork = {}

      for loopIdxInfbMore, loopItemInfbQuery in ipairs(drinkTestConfig.collisionSnapshot or {}) do
        if loopItemInfbQuery.canCollide == true and loopItemInfbQuery.part and loopItemInfbQuery.part.Parent then
          emptyTableWork[#emptyTableWork + 1] = { part = loopItemInfbQuery.part, collisionGroup = loopItemInfbQuery.collisionGroup }
        end
