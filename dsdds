function Settings.carcassIntentionalWater(firstArg, secondArg, ...)
  local carcassWaterTransitConfig2 = Settings.carcassWaterTransit

  if not carcassWaterTransitConfig2 or carcassWaterTransitConfig2.active ~= true or not (isNotJungleLife or isDinoLifePlaceId)
    or not firstArg or not secondArg or firstArg ~= localPlayer.Character
    or carcassWaterTransitConfig2.character ~= firstArg or isTargetValid(firstArg) or recoveryBlocked then
    if carcassWaterTransitConfig2 and carcassWaterTransitConfig2.active then
      Settings.carcassWaterTransitReset()
    end

    return false
  end

  local locaFindCarcass = localParentGlobal

  if not locaFindCarcass or locaFindCarcass ~= carcassWaterTransitConfig2.target or not locaFindCarcass.Parent then
    Settings.carcassWaterTransitReset()
    return false
  end

  local activeTargetPart = carcassWaterTransitConfig2.targetPart

  if not activeTargetPart or not activeTargetPart.Parent or not activeTargetPart:IsDescendantOf(locaFindCarcass) then
    activeTargetPart = locaFindCarcass:FindFirstChild("HumanoidRootPart")
      or locaFindCarcass:FindFirstChildWhichIsA("BasePart", true)

    carcassWaterTransitConfig2.targetPart = activeTargetPart
  end

  if not activeTargetPart or not activeTargetPart.Parent then
    Settings.carcassWaterTransitReset()
    return false
  end

  if not (safeMoveOff or Settings.safeMove and Settings.safeMove.active and Settings.safeMove.reason == "foodPercent"
      or Settings.survivalArbiter and Settings.survivalArbiter.owner == "foodPercent"
      or Settings.MMBAI and Settings.MMBAI.Authority and Settings.MMBAI.Authority.currentOwner == "Food")
    and not (isDinoLifePlaceId and Settings.dinoCarcassWaterCrossingActive(firstArg, secondArg)) then
    if tick() - (carcassWaterTransitConfig2.lastProgressAt or 0) > 1.6 then
      Settings.carcassWaterTransitReset()
      return false
    end
  end

  local magnitudebYield = Vector3.new(
    activeTargetPart.Position.X - secondArg.Position.X, 0, activeTargetPart.Position.Z - secondArg.Position.Z
  ).Magnitude

  local activeCurrentTimestamp = tick()

  if isDinoLifePlaceId and Settings.dinoCarcassWaterCrossingUpdate(firstArg, secondArg) then
    return activeCurrentTimestamp - (tonumber(carcassWaterTransitConfig2.enteredWaterAt) or activeCurrentTimestamp) <= 180
  end

  if magnitudebYield < (carcassWaterTransitConfig2.lastDistance or math.huge) - 0.65 then
    carcassWaterTransitConfig2.lastDistance = magnitudebYield
    carcassWaterTransitConfig2.lastProgressAt = activeCurrentTimestamp
  elseif magnitudebYield < (carcassWaterTransitConfig2.lastDistance or math.huge) then
    carcassWaterTransitConfig2.lastDistance = magnitudebYield
  end

  return activeCurrentTimestamp - (carcassWaterTransitConfig2.lastProgressAt or 0) <= 6.5
    and activeCurrentTimestamp - (carcassWaterTransitConfig2.startedAt or activeCurrentTimestamp) <= 75
end

