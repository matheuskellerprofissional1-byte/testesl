function Settings.survivalDualCriticalChoice(firstArg, secondArg, ...)
  firstArg = tonumber(firstArg) or 100
  secondArg = tonumber(secondArg) or 100
  local choiceCharacterRef = Settings.survivalLowVitalPriority(firstArg, secondArg, localPlayer.Character)

  if choiceCharacterRef then
    return choiceCharacterRef
  end

  local choiceSurvivalThreshold = Settings.slotParkingAudit10() or 45

  if not Settings.autoEat or not Settings.autoDrink or firstArg > choiceSurvivalThreshold or secondArg > choiceSurvivalThreshold then
    return nil
  end

  local choiceFirstChoice = Settings.carnivoreFoodFirstChoice(firstArg, secondArg)

  if choiceFirstChoice then
    return choiceFirstChoice
  end

  if Settings.dinoVerifiedDrinkContinuity(firstArg, secondArg) then
    return "waterPercent"
  end

  if isDinoLifePlaceId and Settings.carcassStaleWater == localPlayer.Character
    and tick() < (tonumber(Settings.carcassStaleWaterHandoffUntil) or 0) and secondArg < 70
    and firstArg + 8 >= secondArg then
    return "waterPercent"
  end

  if firstArg + 2 < secondArg then
    return "foodPercent"
  elseif secondArg + 2 < firstArg then
    return "waterPercent"
  end

  local survivalArbiterSetting = Settings.survivalArbiter and Settings.survivalArbiter.owner

  if survivalArbiterSetting == "foodPercent" or survivalArbiterSetting == "waterPercent" then
    return survivalArbiterSetting
  end

  return firstArg <= secondArg and "foodPercent" or "waterPercent"
end

function Settings.survivalCriticalVitalOwner(firstArg, secondArg, ...)
  local foodLevel4 = firstArg and tonumber(firstArg:GetAttribute("Food")) or secondArg and tonumber(secondArg.foodPercent)
    or 100

  local waterAttribute = firstArg and tonumber(firstArg:GetAttribute("Water"))
    or secondArg and tonumber(secondArg.waterPercent) or 100

  local ownerVitalPriority = Settings.survivalLowVitalPriority(foodLevel4, waterAttribute, firstArg)

  if ownerVitalPriority then
    return ownerVitalPriority, foodLevel4, waterAttribute
  end

  local ownerSurvivalThreshold = Settings.slotParkingAudit10()
  local characterbQuery = firstArg or localPlayer.Character

  local questSwimPendingNow = not ownerSurvivalThreshold
      and isDinoLifePlaceId
      and Settings.autoQuests == true
      and characterbQuery ~= nil
      and isValidQuestTarget(characterbQuery)
      and (Settings.characterDinoZone(characterbQuery)
        or Settings.questSwimPendingNow and Settings.questSwimPendingNow())
    or false

  local condSurvival2 = ownerSurvivalThreshold or 80
  local criticalCondition = ownerSurvivalThreshold or 70

  local dinoHerbivoreEmergency = Settings.dinoHerbivoreEmergency and Settings.dinoHerbivoreEmergency(
    firstArg or localPlayer.Character, foodLevel4, waterAttribute
  ) or nil

  if dinoHerbivoreEmergency then
    return dinoHerbivoreEmergency, foodLevel4, waterAttribute
  end

  local ownerDietType = Settings.carnivoreFoodFirstChoice(foodLevel4, waterAttribute)

  if ownerDietType then
    return ownerDietType, foodLevel4, waterAttribute
  end

  if Settings.savannahFlamingoDrinkDue(firstArg, foodLevel4, waterAttribute, false) then
    return "waterPercent", foodLevel4, waterAttribute
  end

  local ownerCriticalChoice = Settings.survivalDualCriticalChoice(foodLevel4, waterAttribute)

  if ownerCriticalChoice then
    return ownerCriticalChoice, foodLevel4, waterAttribute
  end

  if Settings.autoEat and Settings.autoDrink and foodLevel4 < condSurvival2 and waterAttribute < criticalCondition then
    return foodLevel4 / condSurvival2 <= waterAttribute / criticalCondition and "foodPercent" or "waterPercent", foodLevel4, waterAttribute
  end

  if Settings.autoDrink and waterAttribute < criticalCondition then
    return "waterPercent", foodLevel4, waterAttribute
  end

  if Settings.autoEat and foodLevel4 < condSurvival2 then
    return "foodPercent", foodLevel4, waterAttribute
  end

  return nil, foodLevel4, waterAttribute
end

function Settings.survivalCriticalVital(firstArg, blackboard, ...)
