function Settings.createNextSlot(...)
  if not forChildInglobal1 or not waitInvokeGlobal then
    return false
  end

  if type(Settings.growthNewPendingSlot) == "table" then
    local growthNewPendingSlot = Settings.growthNewPendingSlot
    local characterNameTarget = growthNewPendingSlot.CharacterName

    local findSaved = type(characterNameTarget) == "string" and Settings.slotNameFindSaved(characterNameTarget)
      or nil

    if findSaved then
      if checkConditionaPrior(findSaved, true, true) then
        Settings.growthNewPendingSlot = nil
        return true
      end

      strLitInf = "Grow New Slots: exact created slot is awaiting spawn confirmation"
      return false
    end

    if tick() - (tonumber(growthNewPendingSlot.requestedAt) or tick()) < 20 then
      strLitInf = "Grow New Slots: waiting for the created slot to replicate"
      return false
    end

    if type(characterNameTarget) == "string" then
      Settings.slotNameReject(characterNameTarget, 900)
    end

    Settings.growthNewPendingSlot = nil
    strLitInf = "Grow New Slots: unconfirmed creation expired; retrying safely"
    return false
  end

  local slotNestFindOwn, slotNestFindOwn, reachedLimit = Settings.growNewCountReachedLimit()

  if slotNestFindOwn then
    strLitInf = string.format(
      "Grow New complete: Character Limit reached (%d/%d); preparing AFK Coin", slotNestFindOwn, reachedLimit
    )

    return false
  end

  local characterForQuery = localPlayer.Character

  if not characterForQuery then
    return false
  end

  local characterNameUpper = characterForQuery:GetAttribute("CharacterName")

  local slotFindSaved = type(characterNameUpper) == "string" and Settings.slotNameFindSaved(characterNameUpper)
    or nil

  if not Settings.atSlotSwitchPoint()
    and not Settings.switchPrepareCurrentSlot("Growth: staging current animal before creating next slot") then
    return false
