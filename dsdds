        recoverylevelProperty = secondArg.name .. ":L" .. triggerRuntimeState.recoveryLevel

        blackboardTrigger.recoveryLevel = triggerRuntimeState.recoveryLevel

        blackboardTrigger.currentAction = "Recovery L" .. triggerRuntimeState.recoveryLevel .. " - "
