  local function checkConditionaRef(firstArg, ...)
    if firstArg == localPlayer then
      return true
    end

    if type(firstArg) == "number" then
      return firstArg == localPlayer.UserId
    end

    if type(firstArg) == "string" then
      return firstArg == tostring(localPlayer.UserId) or firstArg:lower() == localPlayer.Name:lower()
    end

    if type(firstArg) == "table" then
      local numValTarget = tonumber(firstArg.UserId or firstArg.userId or firstArg.PlayerUserId
        or firstArg.playerUserId)

      if numValTarget and numValTarget == localPlayer.UserId then
