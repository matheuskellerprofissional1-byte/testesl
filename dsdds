  local movementDisabled = assistCharacterValue:GetAttribute("MovementDisabled")
  local mmbLandSlopeFlyGyro = Instance.new("BodyGyro")
  local mmbLandSlopeFlyPosition = Instance.new("BodyPosition")
  mmbLandSlopeFlyGyro.Name = "MMB_LandSlopeFlyGyro"
  mmbLandSlopeFlyPosition.Name = "MMB_LandSlopeFlyPosition"

  mmbLandSlopeFlyGyro.P = 65000
  mmbLandSlopeFlyGyro.MaxTorque = Vector3.new(900000000, 900000000, 900000000)

  mmbLandSlopeFlyPosition.P = 18000
  mmbLandSlopeFlyPosition.D = 3000
  mmbLandSlopeFlyPosition.MaxForce = Vector3.new(900000000, 900000000, 900000000)

