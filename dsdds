  local slotAnimalName = characterForQuery:GetAttribute("AnimalName") or "Elephant"
  local newSlotGender = Settings.newSlotGender or characterForQuery:GetAttribute("Gender") or "Female"
  local skin = characterForQuery:GetAttribute("Skin") or "Default"
  local currentTimestampnCopy = tick()

  if not Settings.spawnSlotResetToMenu(characterForQuery) then
    strLitInf = "Grow New Slots: reset was not confirmed; retrying later"
    return false
  end

  local currentTimestampXi = 2 - (tick() - currentTimestampnCopy)

  if currentTimestampXi > 0 then
    task.wait(currentTimestampXi)
  end

  if isDinoLifePlaceId and Settings.growNewProbeCharacterCapacity then
    if Settings.growNewProbeCharacterCapacity(4) == true then
      local characterLimit = Settings.growNewKnownCharacterLimit()

      strLitInf = characterLimit and string.format(
        "Grow New complete: Character Limit (%d) confirmed; preparing AFK Coin", characterLimit
      ) or "Grow New complete: Character Limit confirmed; preparing AFK Coin"

      Settings.growNewRestoreAfterFull(
        slotFindSaved, "Grow New Character Limit confirmed; restored final slot"
      )

      return false
    end
  end

  for icRef = 1, 6 do
    local slotName = Settings.uniqueSlotName()

    if not slotName then
      strLitInf = "Grow New Slots: no safe unique name available"
      return false
    end

    local slotDataTable = {
      CharacterName = slotName,
      AnimalName = slotAnimalName,
      Gender = newSlotGender,
      Skin = skin,
      GrowthPercentage = 0,
    }

    strLitInf = string.format("Grow New Slots: creating %s (%s)", slotName, slotAnimalName)

    local slotNestFindOwn, slotOperationSuccess = pcall(
      forChildInglobal1.InvokeServer, forChildInglobal1, slotDataTable.CharacterName, slotDataTable.AnimalName,
      slotDataTable.Gender, slotDataTable.Skin
    )

    if not slotNestFindOwn or slotOperationSuccess == false then
      if (isDinoLifePlaceId and Settings.growNewProbeCharacterCapacity and Settings.growNewProbeCharacterCapacity(2)
          or false)
        == true then
        Settings.growthNewPendingSlot = nil

        Settings.growNewRestoreAfterFull(
          slotFindSaved, "CreateRemote rejected because Character Limit is full"
        )

        strLitInf = "Grow New complete: Character Limit confirmed; AFK Coin is next"
        return false
      end

      Settings.slotNameReject(slotName, 900)
      strLitInf = string.format("Name %s was rejected; generating another safe name", slotName)
      task.wait(0.35)
      continue
    end

    Settings.growthNewPendingSlot = slotDataTable
    Settings.growthNewPendingSlot.requestedAt = tick()

    local slotCurrentTimestamp = tick() + 6
    local findSaved2

    repeat
      task.wait(0.25)
      findSaved2 = Settings.slotNameFindSaved(slotName)
    until findSaved2 or tick() >= slotCurrentTimestamp

    if not findSaved2 then
      if (isDinoLifePlaceId and Settings.growNewProbeCharacterCapacity and Settings.growNewProbeCharacterCapacity(2)
          or false)
        == true then
        Settings.growthNewPendingSlot = nil

        Settings.growNewRestoreAfterFull(
          slotFindSaved, "Create replication absent because Character Limit is full"
        )

        strLitInf = "Grow New complete: no slot created because Character Limit is full"
        return false
      end

      strLitInf = string.format("Name %s is awaiting delayed SavedCharacters replication", slotName)
      return false
    end

    if isDinoLifePlaceId and Settings.growNewCapacity then
      Settings.growNewCapacity.confirmedFull = false
      Settings.growNewCapacity.reason = "slot_created"
      Settings.growNewCapacity.confirmedCount = nil
    end

    Settings.slotNameReserve(slotName, 60)

    for icSource = 1, 3 do
      if checkConditionaPrior(Settings.slotNameFindSaved(slotName) or findSaved2, true, true) then
        Settings.growthNewPendingSlot = nil
        return true
      end

      strLitInf = string.format("New slot %s exists; retrying exact spawn (%d/3)", slotName, icSource)
      task.wait(1)
    end

    return false
  end

  strLitInf = "Grow New Slots: all safe-name attempts were rejected; will retry"
  return false
end

