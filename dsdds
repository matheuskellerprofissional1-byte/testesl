  secondArg = tonumber(secondArg) or tonumber(firstArg:GetAttribute("Food")) or 100
  thirdArg = tonumber(thirdArg) or tonumber(firstArg:GetAttribute("Water")) or 100
  local choiceStateFlag = Settings.autoEat == true and secondArg <= 80
  local choiceAutoDrinkSetting = Settings.autoDrink == true and thirdArg <= 70

  if not choiceStateFlag and not choiceAutoDrinkSetting then
    return nil
  end

  if choiceStateFlag and not choiceAutoDrinkSetting then
    return "foodPercent"
  end

  if choiceAutoDrinkSetting and not choiceStateFlag then
    return "waterPercent"
  end

  local timeAuthorityDino = Settings.MMBAI and Settings.MMBAI.Authority

  if thirdArg < 45 and secondArg > 12 and secondArg + 8 >= thirdArg and timeAuthorityDino
    and timeAuthorityDino.currentOwner == "Water"
    and tick() - (tonumber(timeAuthorityDino.currentSince) or tick()) < 45 then
    return "waterPercent"
