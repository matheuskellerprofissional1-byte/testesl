        and not (Settings.questIsFlyingAnimalName(secondBestItem.AnimalName)
          and (Settings.questBlockFlying or (Settings.questPendingLandCount or 0) > 0))

      local conditionalResultZeta = not questGroupSameanimal and packBesti
        and Settings.questGroup.findOwnedSlot(secondArg, secondBestItem.AnimalName)

      local packStateFlag = not questGroupSameanimal and packBesti and not conditionalResultZeta
        and #secondArg < (Settings.questSlots.maxSlots or 40)

      if questGroupSameanimal or conditionalResultZeta or packStateFlag then
        local packMemberCount = Settings.questGroup.memberCount(secondBestItem)
        local packPackName = Settings.questGroup.getMMbPackName(secondBestItem)
        local locPack = packPackName ~= nil
        local bestStrValFindbestserverpack = tostring(bestLoopKey)

        if not bestDataTableaValue
          or questGroupSameanimal and not bestDataTableaValue.sameSpecies
          or questGroupSameanimal == bestDataTableaValue.sameSpecies and locPack and not bestDataTableaValue.is
          or questGroupSameanimal == bestDataTableaValue.sameSpecies and locPack == bestDataTableaValue.is and packMemberCount > bestDataTableaValue.count
          or questGroupSameanimal == bestDataTableaValue.sameSpecies and locPack == bestDataTableaValue.is and packMemberCount == bestDataTableaValue.count
            and bestStrValaValue < bestDataTableaValue.idText then
          bestDataTableaValue = {
            packId = bestLoopKey,
            pack = secondBestItem,
            count = packMemberCount,
            animalName = secondBestItem.AnimalName,
            sameSpecies = questGroupSameanimal,
            slot = questGroupSameanimal and nil or conditionalResultZeta,
            needsCreate = packStateFlag == true,
            is = locPack,
            mmbName = packPackName,
            idText = bestStrValaValue,
          }
        end
      end
    end
  end

  return bestDataTableaValue
end

function Settings.questGroup.findOwnedPack(firstArg, ...)
  if not firstArg then
    return nil
  end

  local packCurrentPack = Settings.questGroup.getCurrentPack(firstArg)

  if packCurrentPack and Settings.questGroup.samePlayer(packCurrentPack.Owner, localPlayer) then
    return packCurrentPack
  end

  if type(firstArg.GetData) ~= "function" then
    return nil
  end

  local pcallResultPack, packOperationSuccess = pcall(firstArg.GetData)

  if not pcallResultPack or type(packOperationSuccess) ~= "table" then
    return nil
  end

  for ownedLoopKey, ownedLoopItem in pairs(packOperationSuccess) do
    if type(ownedLoopItem) == "table" and ownedLoopItem.Owner
      and Settings.questGroup.samePlayer(ownedLoopItem.Owner, localPlayer) then
      return ownedLoopItem
    end
  end
end

function Settings.questGroup.openOwnedPackAutoAccept(firstArg, secondArg, ...)
  if not firstArg or not secondArg then
    return false
  end

  if not Settings.questGroup.samePlayer(secondArg.Owner, localPlayer) then
    return false
  end

  if secondArg.JoinRequirements == "AutoAccept" then
    return true
  end

  if type(firstArg.SetJoinRequirements) ~= "function" then
    return false
  end

  local pcallResultAccept, acceptOperationSuccess = pcall(firstArg.SetJoinRequirements, "AutoAccept")

  if not pcallResultAccept or acceptOperationSuccess == false then
    pcallResultAccept, acceptOperationSuccess = pcall(firstArg.SetJoinRequirements, firstArg, "AutoAccept")
  end

  return pcallResultAccept and acceptOperationSuccess ~= false
end

function Settings.questGroup.tryCreateMMbPack(firstArg, secondArg, ...)
  if not firstArg or type(firstArg.CreateGroup) ~= "function" or type(secondArg) ~= "string"
    or secondArg == "" then
    return false
  end

  local packOwnedPack = Settings.questGroup.findOwnedPack(firstArg)

  if packOwnedPack then
    Settings.questGroup.disabledFlag = false
    Settings.questGroup.createFailures = 0
    Settings.questGroup.openOwnedPackAutoAccept(firstArg, packOwnedPack)

    return true
  end

  if Settings.questGroup.disabledFlag then
    Settings.questGroup.statusText = "KITTY co-op: waiting for group creation confirmation"
    return false
  end

  if tick() - (Settings.questGroup.lastCreateAttemptAt or 0) < 2.5 then
    return false
  end

  local questGroupNextmmbgroupname = Settings.questGroup.nextMMbGroupName(firstArg)

  if not questGroupNextmmbgroupname then
    Settings.questGroup.statusText = "KITTY co-op: no free MmBx name found"
    return false
  end

  Settings.questGroup.disabledFlag = true
  Settings.questGroup.lastCreateAttemptAt = tick()
  Settings.questGroup.lastMMbCreateName = questGroupNextmmbgroupname
  Settings.questGroup.statusText = "KITTY co-op: creating " .. questGroupNextmmbgroupname .. " · " .. secondArg

  task.spawn(function(...)
    local packCallResult = pcall(firstArg.CreateGroup, questGroupNextmmbgroupname)
    local packTimestamp = tick() + 3.5
    local ownedPack2

    repeat
      task.wait(0.2)
      ownedPack2 = Settings.questGroup.findOwnedPack(firstArg)
    until ownedPack2 or tick() >= packTimestamp

    if not ownedPack2 then
      local packOperationSuccess = pcall(firstArg.CreateGroup, firstArg, questGroupNextmmbgroupname)
      packTimestamp = tick() + 3.5

      repeat
        task.wait(0.2)
        ownedPack2 = Settings.questGroup.findOwnedPack(firstArg)
      until ownedPack2 or tick() >= packTimestamp
    end

    if ownedPack2 then
      Settings.questGroup.createFailures = 0
      Settings.questGroup.lastCreateVerifiedAt = tick()
      Settings.questGroup.disabledFlag = false
      Settings.questGroup.openOwnedPackAutoAccept(firstArg, ownedPack2)
      Settings.questGroup.inviteMatchingPlayers(firstArg, secondArg)

      local packPackName = Settings.questGroup.getMMbPackName(ownedPack2) or questGroupNextmmbgroupname

      if Settings.questGroup.packNameLooksFiltered(ownedPack2) then
        Settings.questGroup.markMMbNameBad(questGroupNextmmbgroupname)
        Settings.questGroup.flightFilteredNameRepair = false

        helper(function(...) Settings.questGroup.repairFilteredOwnedPack(firstArg, ownedPack2, secondArg) end)
        return
      end

      Settings.questGroup.statusText = "KITTY co-op created: " .. packPackName .. " · AutoAccept"
      strLitInf = "GroupTime: MMB group ready (" .. packPackName .. ")"
      Settings.questForceFastRecheckUntil = tick() + 20
      return
    end

    Settings.questGroup.disabledFlag = false
    Settings.questGroup.createFailures = (Settings.questGroup.createFailures or 0) + 1

    Settings.questGroup.statusText = string.format(
      "KITTY co-op: creation failed (%d); retrying", Settings.questGroup.createFailures
    )

    strLitInf = "GroupTime: CreateGroup did not produce a pack; retry scheduled"
  end)

  return false
end

function Settings.questGroup.tryRenameOwnedPack(firstArg, secondArg, ...)
  if not firstArg or type(secondArg) ~= "string" or secondArg == "" then
    return false
  end

  for renameLoopIdx, renameLoopItem in ipairs({
    "RenameGroup", "SetGroupName", "ChangeGroupName", "UpdateGroupName",
  }) do
    local locaFunctionPack = firstArg[renameLoopItem]

    if type(locaFunctionPack) == "function" then
      local pcallResultPack, operationSuccessV2 = pcall(locaFunctionPack, secondArg)

      if not pcallResultPack or operationSuccessV2 == false then
        pcallResultPack, operationSuccessV2 = pcall(locaFunctionPack, firstArg, secondArg)
      end

      if pcallResultPack and operationSuccessV2 ~= false then
        return true
      end
    end
  end

  return false
end

function Settings.questGroup.repairFilteredOwnedPack(firstArg, secondArg, thirdArg, ...)
  if not firstArg or not secondArg or not Settings.questGroup.samePlayer(secondArg.Owner, localPlayer)
    or Settings.questGroup.flightFilteredNameRepair then
    return false
  end

  if not Settings.questGroup.ownedPackNameFiltered(secondArg) then
    Settings.questGroup.filteredNameRepairAttempts = 0
    return false
  end

  if tick() - (Settings.questGroup.filteredNameLastRepairAt or 0) < 2 then
    return false
  end

  local lastMMbCreateName = Settings.questGroup.getMMbPackName(secondArg)
    or Settings.questGroup.lastMMbCreateName

  Settings.questGroup.markMMbNameBad(lastMMbCreateName)
  local groupName = Settings.questGroup.nextMMbGroupName(firstArg)

  if not groupName then
    Settings.questGroup.statusText = "KITTY co-op: filtered name detected; waiting for another safe name"
    return false
  end

  Settings.questGroup.flightFilteredNameRepair = true
  Settings.questGroup.filteredNameLastRepairAt = tick()

  Settings.questGroup.filteredNameRepairAttempts = (Settings.questGroup.filteredNameRepairAttempts or 0)
    + 1

  Settings.questGroup.statusText = "KITTY co-op: #### detected; replacing group name with " .. groupName

  strLitInf = "GroupTime: filtered group name detected; rotating to a safe MMB name"

  pcall(Settings.questGroup.openOwnedPackAutoAccept, firstArg, secondArg)
  pcall(Settings.questGroup.inviteMatchingPlayers, firstArg, thirdArg)

  task.spawn(function(...)
    if Settings.questGroup.tryRenameOwnedPack(firstArg, groupName) then
      task.wait(0.75)
      local ownedPack = Settings.questGroup.findOwnedPack(firstArg)
      local questGroupGetmmbpackname = ownedPack and Settings.questGroup.getMMbPackName(ownedPack) or nil

      if ownedPack and questGroupGetmmbpackname and questGroupGetmmbpackname:lower() == groupName:lower()
        and not Settings.questGroup.ownedPackNameFiltered(ownedPack) then
        Settings.questGroup.lastMMbCreateName = questGroupGetmmbpackname
        Settings.questGroup.flightFilteredNameRepair = false
        Settings.questGroup.filteredNameRepairAttempts = 0
        Settings.questGroup.openOwnedPackAutoAccept(firstArg, ownedPack)
        Settings.questGroup.inviteMatchingPlayers(firstArg, thirdArg)
        Settings.questGroup.statusText = "KITTY co-op name verified: " .. questGroupGetmmbpackname .. " · AutoAccept"

        return
      end
    end

    local packOwnedPack = Settings.questGroup.findOwnedPack(firstArg)

    if packOwnedPack and Settings.questGroup.samePlayer(packOwnedPack.Owner, localPlayer) then
      local disband = firstArg.Disband

      if type(disband) == "function" then
        local pcallResultPack, operationSuccess2 = pcall(disband)

        if not pcallResultPack or operationSuccess2 == false then
          pcall(disband, firstArg)
        end
      end
    end

    local packCurrentTimestamp = tick() + 3

    repeat
      task.wait(0.2)
    until not Settings.questGroup.findOwnedPack(firstArg) or tick() >= packCurrentTimestamp

    Settings.questGroup.flightFilteredNameRepair = false
    Settings.questGroup.disabledFlag = false
    Settings.questGroup.lastCreateAttemptAt = 0
    Settings.questGroup.lastActionAt = 0

    if Settings.alive and not Settings.questGroup.findOwnedPack(firstArg) then
      Settings.questGroup.tryCreateMMbPack(firstArg, thirdArg)
    end
  end)

  return true
end

function Settings.questGroup.currentAnimalEnsure(firstArg, secondArg, ...)
