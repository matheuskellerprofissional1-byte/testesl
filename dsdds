  local trapUnderMainWater, trapWaterPart = Settings.isUnderMainWaterPart(secondArg)

  if not trapUnderMainWater or not trapWaterPart or not trapWaterPart.part then
    return false, trapWaterPart, 0
  end

  local trapHeavyAnimalType = math.max(0, (tonumber(trapWaterPart.worldSpace) or secondArg.Position.Y) - secondArg.Position.Y)
  local limitValue3 = math.max(2.2, Settings.movementRootClearance(firstArg))

  local drinkIsBuriedUnderTerrain = Settings.drinkIsBuriedUnderTerrain
      and Settings.drinkIsBuriedUnderTerrain(secondArg)
    or false

  local hippoMaxVal1 = trapWaterPart.part.CanCollide == true and trapHeavyAnimalType >= math.max(1.2, limitValue3 * 0.45)
  local absResult = trapHeavyAnimalType >= 0.8 and math.abs(secondArg.cFrame.UpVector.Y) <= 0.42
  return drinkIsBuriedUnderTerrain or hippoMaxValaValue or absResult, trapWaterPart, trapHeavyAnimalType
