      if secondArg.type == "Run"
        and Settings.questLandwWatch
        and (Settings.questLandwWatch.executionStatus == "Replanning"
          or Settings.questLandwWatch.executionStatus == "Avoiding obstacle")
        and tick() - (Settings.questLandwWatch.executionStatusAt or 0) <= 8 then
        return "waiting for bounded Land Travel repair"
      end

      return nil
    end

    function mmbaiUserIntent.QuestTracker.Diagnosis(firstArg, secondArg, thirdArg, ...)
      if secondArg.supported == false then
