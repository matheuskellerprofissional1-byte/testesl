function Settings.landSlopeFindClimbTarget(firstArg, secondArg, thirdArg, ...)
  if not firstArg or not secondArg or typeof(thirdArg) ~= "Vector3" then
    return nil
  end

  local vectorbQuery = Vector3.new(thirdArg.X, 0, thirdArg.Z)

  if vectorbQuery.Magnitude <= 0.05 then
    return nil
  end

  vectorbQuery = vectorbQuery.Unit
  local targetTransformData = Settings.landSlopeTerrainHeightAt(secondArg.Position, secondArg.Position.Y)

  if type(targetTransformData) ~= "number" then
    return nil
  end

  local targetLocalValue = -math.huge
  local targetFind = targetTransformData
  local targetFinda

  for findLoopIdxValue, findLoopItemValue in ipairs({ 8, 12, 18, 26, 34, 44, 54 }) do
    local posiPositionTarget = secondArg.Position + vectorbQuery * findLoopItemValue
    local landSlopeTerrain = Settings.landSlopeTerrainHeightAt(posiPositionTarget, secondArg.Position.Y)

    if type(landSlopeTerrain) == "number" then
      local locaTarget2 = landSlopeTerrain - targetTransformData
      local targetFindc = landSlopeTerrain - targetFind
      local limitValue29 = locaTarget2 / math.max(findLoopItemValue, 1)

      if locaTarget2 >= 9 and limitValue29 >= 0.34 or targetFindc >= 8 then
        local vectorbRef = Vector3.new(posiPositionTarget.X, landSlopeTerrain, posiPositionTarget.Z)

        if Settings.landSlopeLandingColumnClear(firstArg, vectorbRef) then
          local 3Property = locaTarget2 * 1.8 + findLoopItemValue * 0.3

          if 3Property > targetLocalValue then
            targetLocalValue = 3Property
            targetFinda = vectorbRef
          end
        end
      end

      targetFind = landSlopeTerrain
    end
  end

  return targetFinda, targetTransformData
end

function Settings.runLowTerrainSlopeAssist(firstArg, ...)
  if type(firstArg) ~= "table" then
