  if secondArg <= 25 and thirdArg <= 25 then
    if thirdArg + 2 < secondArg then
      return "waterPercent"
    end

    if secondArg + 2 < thirdArg then
      return "foodPercent"
    end
  end

  local choiceHerbivore = secondArg / 80
  local choiceHerbivorea = thirdArg / 70

  if math.abs(choiceHerbivore - choiceHerbivorea) <= 0.035 then
