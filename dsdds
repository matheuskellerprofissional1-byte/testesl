    return false
  end

  local playerPack = Settings.questGroup.getExplicitPlayerPack(firstArg, localPlayer)
  local byId = secondArg ~= nil and Settings.questGroup.getPackById(firstArg, secondArg) or nil

  if playerPack then
    if not byId then
      return secondArg == nil
    end

    if playerPack == byId then
      return true
    end

    if Settings.questGroup.samePackRecord and Settings.questGroup.samePackRecord(playerPack, byId) then
      return true
    end
  end

  if byId and Settings.questGroup.teamFallbackAllowed(localPlayer) then
    local confirmedTeamName = Settings.questGroup.getPlayerMMbTeamName(localPlayer)
    local confirmedPackName = Settings.questGroup.getMMbPackName(byId)

    if type(confirmedTeamName) == "string" and type(confirmedPackName) == "string" and confirmedTeamName:lower() == confirmedPackName:lower() then
      return true
    end
  end

  return false
end

function Settings.questGroup.membershipConfirmWait(firstArg, secondArg, thirdArg, ...)
  local confirmationClampedValue = tick() + math.clamp(tonumber(thirdArg) or 1.25, 0.35, 2)

  repeat
    if Settings.questGroup.membershipConfirmed(firstArg, secondArg) then
      Settings.questGroup.joinVerifyTargetId = secondArg
      Settings.questGroup.joinVerifyResult = "confirmed"
      return true
    end

    task.wait(0.1)
  until tick() >= confirmationClampedValue

  Settings.questGroup.joinVerifyTargetId = secondArg
  Settings.questGroup.joinVerifyResult = "unconfirmed"

  return false
end

function Settings.questGroup.packInviteContainsPlayer(firstArg, ...)
  if type(firstArg) ~= "table" then
