      and tick() < (Settings.questMoveInteract.stationaryEatRetryAfter or 0) then
      return "waterPercent"
    end

    if autoDrink then
      local chooseArbiterc = firstArg / chooseLocalValue
      return secondArg / conditionalResultAux < chooseArbiterc and "waterPercent" or "foodPercent"
    end

    local characterbValue = localPlayer.Character

    if characterbValue then
