      )
    end

    if Settings.savannahFlamingoDrinkDue(currentPlayerChar, foodLevel2, waterLevel2, noCarcassAvailable == true) then
      noCarcassAvailable = true
      Settings.survivalPriorityTakeover("waterPercent", currentPlayerChar, "Flamingo Food demand uses Drinking")

      if Settings.MMBAI and type(Settings.MMBAI.RequestWorker) == "function" then
        pcall(
          Settings.MMBAI.RequestWorker, Settings.MMBAI, "AutoDrink", "Flamingo feeding through waterPercent",
          0.01
        )
      end

      strLitInf = string.format("Flamingo: drinking for Food (%d%%)", math.floor(foodLevel2))
    end

    return
  end

  do
    local iteratedValue = Settings.slotParkingAudit10()

    if iteratedValue and currentPlayerChar and foodLevel2 >= iteratedValue then
      if Settings.slotParkingAudit5 then
        Settings.slotParkingAudit5(currentPlayerChar, foodLevel2, waterLevel2)
      end

      return
    end
  end

  local questGrowthMature = isNotJungleLife and Settings.autoQuests == true and currentPlayerChar
      and isValidQuestTarget(currentPlayerChar) and Settings.questGrowthMature
      and Settings.questGrowthMature(currentPlayerChar)
    or false

  local completedSavannahCarnivore = Settings.completedSavannahCarnivore and Settings.completedSavannahCarnivore(
    currentPlayerChar, foodLevel2, questGrowthMature
  ) or false

  if isNotJungleLife
