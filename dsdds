function Settings.questZoneDrinkApply(firstArg, ...)
  local questZoneDrinkOverride = Settings.questZoneDrinkOverride

  if not questZoneDrinkOverride or type(firstArg) ~= "string" or firstArg == "" then
    return
  end

  if Settings.undergroundDrinkMaintenance then
    local stateProperty = not questZoneDrinkOverride.active

    questZoneDrinkOverride.active = true
    questZoneDrinkOverride.zone = firstArg

    questZoneDrinkOverride.startedAt = questZoneDrinkOverride.startedAt > 0
        and questZoneDrinkOverride.startedAt
      or tick()

    Settings.autoDrinkMode = "surface"
    Settings.autoDrinkPreferredMode = "surface"

    if Settings.drinkTest.active then
      Settings.drinkTest.cancelRequested = true
    end

    if stateProperty then
      strLitInf = "Survive in Zone: exposed-waterPercent search; Below Terrain under maintenance"
    end

    Settings.questZoneDrinkRender()
    return
  end

  if not questZoneDrinkOverride.active then
    if Settings.autoDrinkMode == "surface" or Settings.autoDrinkMode == "underground" then
      Settings.autoDrinkPreferredMode = Settings.autoDrinkMode
    end
  end

  questZoneDrinkOverride.active = true
  questZoneDrinkOverride.zone = firstArg

  questZoneDrinkOverride.startedAt = questZoneDrinkOverride.startedAt > 0
      and questZoneDrinkOverride.startedAt
    or tick()

  if animalNameResolver.isCharacter(localPlayer.Character) then
    Settings.autoDrinkMode = "surface"
    strLitInf = "Survive in Zone: Crocodile cannot use Underground Drink"
    Settings.questZoneDrinkRender()
    return
  end

  if Settings.autoDrinkMode ~= "underground" then
    Settings.autoDrinkMode = "underground"
    Settings.drinkTest.retryAfter = 0

    if Settings.safeMove and Settings.safeMove.active and Settings.safeMove.reason == "waterPercent" then
      Settings.safeMove.cancelToken = Settings.safeMove.cancelToken + 1
    end

    Settings.drinkSearch.currentWaterPoint = nil
    Settings.drinkSearch.failedCount = 0
    Settings.drinkSearch.retryAfter = 0
    Settings.drinkProgressReset()

    strLitInf = "Survive in Zone: Underground Drink temporarily forced"
  end

  Settings.questZoneDrinkRender()
end

function Settings.questZoneDrinkRelease(firstArg, ...)
  local questZoneDrinkOverride = Settings.questZoneDrinkOverride

  if not questZoneDrinkOverride or not questZoneDrinkOverride.active then
    return
  end

  questZoneDrinkOverride.active = false
  questZoneDrinkOverride.zone = nil
  questZoneDrinkOverride.startedAt = 0

  local autoDrinkPreferredMode = Settings.autoDrinkPreferredMode

  if Settings.undergroundDrinkMaintenance then
    autoDrinkPreferredMode = "surface"
    Settings.autoDrinkPreferredMode = "surface"
  end

  if autoDrinkPreferredMode ~= "surface" and autoDrinkPreferredMode ~= "underground" then
    autoDrinkPreferredMode = "surface"
    Settings.autoDrinkPreferredMode = autoDrinkPreferredMode
  end

  if Settings.undergroundDrinkMaintenance or animalNameResolver.isCharacter(localPlayer.Character) then
    Settings.autoDrinkMode = "surface"
  else
    Settings.autoDrinkMode = autoDrinkPreferredMode
  end

  if Settings.autoDrinkMode == "surface" and Settings.drinkTest and Settings.drinkTest.active then
    Settings.drinkTest.cancelRequested = true
    strLitInf = "Survive in Zone ended; restoring Surface Water after safe vertical exit"
  elseif firstArg == "zone_complete" or firstArg == "zone_inactive" then
    strLitInf = "Survive in Zone ended; restored Auto Drink preference"
  end

  Settings.questZoneDrinkRender()
end

