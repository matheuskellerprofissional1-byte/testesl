  mmbLandSlopeFlyPosition.Position = root.Position
  mmbLandSlopeFlyGyro.Parent = root
  mmbLandSlopeFlyPosition.Parent = root

  landSlopeAssist.busy = true
  landSlopeAssist.character = assistCharacterValue
  landSlopeAssist.bodyPosition = mmbLandSlopeFlyPosition
  landSlopeAssist.bodyGyro = mmbLandSlopeFlyGyro
  landSlopeAssist.startedAt = tick()

  pcall(function(...)
    assistStateFlag.PlatformStand = true
    assistStateFlag.AutoRotate = false
  end)

  assistCharacterValue:SetAttribute("MovementDisabled", true)
  local assistTransformData = root.Position
  local assistTimestamp = tick()
  local assistMagnitudeValue = Vector3.new(assistSlopeFindClimb.X - root.Position.X, 0, assistSlopeFindClimb.Z - root.Position.Z).Magnitude
  local assistHeavyAnimalType = Settings.isCrocOrHippoMovementCharacter(assistCharacterValue)

  local clampedValueRunlowterrainslopeassist2 = tick() + math.clamp(
    assistMagnitudeValue / math.max(limitCalc4, 1) + (assistHeavyAnimalType and 4.5 or 2.5), assistHeavyAnimalType and 4.5 or 2.5,
    assistHeavyAnimalType and 15 or 9
  )

  local constrainedValue9 = math.clamp(Settings.movementFootprint(assistCharacterValue) * 0.42, 3.5, assistHeavyAnimalType and 7 or 5.5)

  landSlopeAssist.bestActualDistance = assistMagnitudeValue
  landSlopeAssist.bestActualGroundYield = climbTarget
  landSlopeAssist.lastPhysicalProgressAt = tick()
  landSlopeAssist.landingStableSince = 0

  local lowIsFalse = false

  local assistSlopeFindClimb, assistOperationSuccess = pcall(function(...)
    while Settings.alive and assistCharacterValue.Parent and root.Parent and assistStateFlag.Parent
      and assistStateFlag.Health > 0 and firstArg.token == Settings.safeMove.cancelToken and tick() < clampedValueRunlowterrainslopeassist2 do
      if Settings.safeMoveRunRouteCheck(
        firstArg.options or {}, assistCharacterValue, root, assistStateFlag, firstArg.respawnLocation
      ) then
        break
      end

      if Settings.questGrowthReset.exclusive or localGlobal and purpose ~= "herbivore_food_recovery"
        or mmbaiConfig.active
        or Settings.landSlopeForeignFlyActive(root, mmbLandSlopeFlyPosition, mmbLandSlopeFlyGyro) then
        break
      end

      local vectorbSource = Vector3.new(assistSlopeFindClimb.X - assistTransformData.X, 0, assistSlopeFindClimb.Z - assistTransformData.Z)
      local vectorbTarget = Vector3.new(assistSlopeFindClimb.X - root.Position.X, 0, assistSlopeFindClimb.Z - root.Position.Z)
      local assistHeightAt = Settings.landSlopeTerrainHeightAt(root.Position, root.Position.Y)
      local currentTimestampNext = tick()

      if type(assistHeightAt) == "number" then
        if vectorbTarget.Magnitude
            < (tonumber(landSlopeAssist.bestActualDistance) or math.huge) - 0.65
          or assistHeightAt > (tonumber(landSlopeAssist.bestActualGroundYield) or climbTarget) + 0.55 then
          landSlopeAssist.bestActualDistance = math.min(tonumber(landSlopeAssist.bestActualDistance)
            or math.huge, vectorbTarget.Magnitude)

          landSlopeAssist.bestActualGroundYield = math.max(tonumber(landSlopeAssist.bestActualGroundYield)
            or climbTarget, assistHeightAt)

          landSlopeAssist.lastPhysicalProgressAt = currentTimestampNext
        end

        if assistHeightAt >= climbTarget + 6 and Settings.landSlopeLandingColumnClear(
          assistCharacterValue, Vector3.new(root.Position.X, assistHeightAt, root.Position.Z)
        ) and vectorbTarget.Magnitude <= constrainedValue9 then
          if (landSlopeAssist.landingStableSince or 0) <= 0 then
            landSlopeAssist.landingStableSince = currentTimestampNext
          elseif currentTimestampNext - landSlopeAssist.landingStableSince >= 0.22 then
            lowIsFalse = true
            break
          end
        else
          landSlopeAssist.landingStableSince = 0
        end
      end

      local constrainedValue9 = math.clamp(currentTimestampNext - assistTimestamp, 0.0083333333333333, 0.05)
      assistTimestamp = currentTimestampNext
      local assistMinResult = math.min(vectorbSource.Magnitude, limitCalc4 * constrainedValue9)
      local 05Property = vectorbSource.Magnitude > 0.05 and assistTransformData + vectorbSource.Unit * assistMinResult or assistTransformData
      local assistPosition = Settings.landSlopeTerrainHeightAt(05Property, assistTransformData.Y)

      if type(assistPosition) ~= "number" then
        break
      end

      local vectorbUpper = Vector3.new(05Property.X, assistPosition + lowMaxValue, 05Property.Z)
      local assistLowc = vectorbUpper - assistTransformData

      if assistLowc.Magnitude > limitCalc4 * constrainedValue9 then
        vectorbUpper = assistTransformData + assistLowc.Unit * (limitCalc4 * constrainedValue9)
      end

      assistTransformData = vectorbUpper
      mmbLandSlopeFlyPosition.Position = assistTransformData
      local objPosition2 = Vector3.new(assistSlopeFindClimb.X - root.Position.X, 0, assistSlopeFindClimb.Z - root.Position.Z)

      if objPosition2.Magnitude > 0.15 then
        mmbLandSlopeFlyGyro.cFrame = cFrame.lookAt(
          root.Position, root.Position + objPosition2.Unit, Vector3.yAxis
        )
      end

      local assistLinearVelocity = root.AssemblyLinearVelocity

      if assistLinearVelocity.Magnitude > limitCalc4 then
        root.AssemblyLinearVelocity = assistLinearVelocity.Unit * limitCalc4
      end

      root.AssemblyAngularVelocity = Vector3.zero
      utilityHelper("Running")
      strLitInf = string.format("Steep Terrain: low assist climbing at <= Acceleration (%.0f)", limitCalc4)
      runService.Heartbeat:Wait()
    end
  end)

  local active = Settings.landSlopeForeignFlyActive(
    root, mmbLandSlopeFlyPosition, mmbLandSlopeFlyGyro
  ) or localGlobal and purpose ~= "herbivore_food_recovery" or mmbaiConfig.active or Settings.questGrowthReset.exclusive

  pcall(function(...)
    if mmbLandSlopeFlyPosition and mmbLandSlopeFlyPosition.Parent then
      mmbLandSlopeFlyPosition:Destroy()
    end
  end)

  pcall(function(...)
    if mmbLandSlopeFlyGyro and mmbLandSlopeFlyGyro.Parent then
      mmbLandSlopeFlyGyro:Destroy()
    end
  end)

  landSlopeAssist.bodyPosition = nil
  landSlopeAssist.bodyGyro = nil
  landSlopeAssist.character = nil
  landSlopeAssist.busy = false
  landSlopeAssist.bestActualDistance = nil
  landSlopeAssist.bestActualGroundYield = nil
  landSlopeAssist.lastPhysicalProgressAt = nil
  landSlopeAssist.landingStableSince = nil
  landSlopeAssist.retryAt = tick() + (lowIsFalse and 1.5 or 4)

  if not active and root and root.Parent then
    local assistLinearVelocity = root.AssemblyLinearVelocity

    if assistLinearVelocity.Magnitude > limitCalc4 then
      root.AssemblyLinearVelocity = assistLinearVelocity.Unit * limitCalc4
    end

    root.AssemblyAngularVelocity = Vector3.zero
  end

  if not active then
    pcall(function(...)
      assistStateFlag.PlatformStand = platformStand == true
      assistStateFlag.AutoRotate = autoRotate ~= false

      if not assistStateFlag.PlatformStand then
        assistStateFlag:ChangeState(Enum.HumanoidStateType.GettingUp)
      end
    end)

    if movementDisabled == nil then
      assistCharacterValue:SetAttribute("MovementDisabled", false)
    else
      assistCharacterValue:SetAttribute("MovementDisabled", movementDisabled)
    end
  end

  if lowIsFalse then
    strLitInf = "Steep Terrain: low assist OFF; upper Terrain reached"
    return true
  end

  if not assistSlopeFindClimb then
    strLitInf = "Steep Terrain assist error: " .. tostring(assistOperationSuccess)
  end

  return false
end

function Settings.dinoCurrentPhysical(firstArg, secondArg, thirdArg, ...)
  if not isDinoLifePlaceId or not firstArg or firstArg ~= localPlayer.Character or not secondArg or isTargetValid(firstArg) then
    return false, false, 0, nil
  end

  local evidenceBoundedValue = math.max(4, Settings.movementFootprint(firstArg))
  local evidenceBodySize = Settings.movementBodySize(firstArg)
  local vectorbWork

  if typeof(thirdArg) == "Vector3" then
    vectorbWork = Vector3.new(thirdArg.X - secondArg.Position.X, 0, thirdArg.Z - secondArg.Position.Z)
  end

  if not vectorbWork or vectorbWork.Magnitude <= 0.05 then
    vectorbWork = Vector3.new(secondArg.cFrame.LookVector.X, 0, secondArg.cFrame.LookVector.Z)
  end

  if vectorbWork.Magnitude <= 0.05 then
    vectorbWork = Vector3.new(0, 0, -1)
  else
    vectorbWork = vectorbWork.Unit
  end

  local vectorbTemp = Vector3.new(-vectorbWork.Z, 0, vectorbWork.X)
  local ignoreList = Settings.movementObstacleIgnoreList(firstArg, false)

  if type(ignoreList) ~= "table" then
    ignoreList = { firstArg }
  end

  if activeCarcass and activeCarcass.Parent then
    ignoreList[#ignoreList + 1] = activeCarcass
  end

  local evidenceRaycastParams = RaycastParams.new()
  evidenceRaycastParams.FilterType = Enum.RaycastFilterType.Exclude
  evidenceRaycastParams.FilterDescendantsInstances = ignoreList
  evidenceRaycastParams.IgnoreWater = true

  local function survivalHandleSurvival(firstArg, secondArg, thirdArg, ...)
    if typeof(secondArg) ~= "Vector3" or secondArg.Magnitude <= 0.05 then
      return nil
    end

    local raycastResultCached = workspace:Raycast(firstArg, secondArg.Unit * thirdArg, evidenceRaycastParams)

    if not raycastResultCached then
      return nil
    end

    if Settings.movementIsDinoWaterMossVisual
      and Settings.movementIsDinoWaterMossVisual(raycastResultCached.Instance) then
      return nil
    end

    if raycastResultCached.Instance ~= workspace.Terrain and raycastResultCached.Instance:IsA("BasePart")
      and raycastResultCached.Instance.CanCollide ~= true then
      return nil
    end

    if raycastResultCached.Instance == workspace.Terrain then
      if raycastResultCached.Material == Enum.Material.Water then
        return nil
      end

      if raycastResultCached.Normal.Y > 0.58 then
        return nil
      end
    end

