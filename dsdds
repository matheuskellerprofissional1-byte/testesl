  local survivalArbiter = Settings.survivalArbiter
  local reason = Settings.safeMove and Settings.safeMove.active and Settings.safeMove.reason or nil
  local stateFlag = Settings.autoEat == true and secondArg < 80
  local pendingStateFlag = Settings.autoDrink == true and thirdArg < 70

  local pendingAutoEatSetting = Settings.autoEat == true
    and secondArg < 92
    and (survivalArbiter and survivalArbiter.owner == "foodPercent" or reason == "foodPercent"
      or reason == "herbivore_food_recovery")

  local autoDrinkSetting = Settings.autoDrink == true
    and thirdArg < 98
    and (survivalArbiter and survivalArbiter.owner == "waterPercent" or reason == "waterPercent"
      or reason == "water_search")

  if stateFlag and pendingStateFlag then
    return secondArg / 80 <= thirdArg / 70 and "foodPercent" or "waterPercent", secondArg, thirdArg
  end

  if pendingStateFlag then
    return "waterPercent", secondArg, thirdArg
  end

  if stateFlag then
    return "foodPercent", secondArg, thirdArg
  end

  if autoDrinkSetting then
    return "waterPercent", secondArg, thirdArg
  end

