      end

      local obsoleteTimestamp = tick()

      if obsoleteTimestamp - numLitSource >= 0.3 then
        numLitSource = obsoleteTimestamp

        if not Settings.grassCandidateVerified(ignored.Position, firstArg) then
          return true, "grass_invalid"
        end
      end

      local distPosCheckconditionref = Vector3.new(firstArg.X - ignored.Position.X, 0, firstArg.Z - ignored.Position.Z).Magnitude

      local distanceVec21 = Vector3.new(
        ignored.Position.X - destinationPoint.X, 0, ignored.Position.Z - destinationPoint.Z
      ).Magnitude

      local clampValQuery = math.clamp(Settings.movementFootprint(ignored) * 1.5, 0, 36)

      local obsoleteBoundedValue = (Settings.prideRockObstacleCache.commitSign or Settings.safeMove.savannahNoGoRoute
            or Settings.safeMove.prideRockWaypoint)
          and obsoleteTimestamp - (Settings.safeMove.lastProgressAt or 0) <= 1.6
          and math.max(35, clampValQuery * 2)
        or 0

      local maxValOther = zoneDistance + math.max(28, zoneDistance * 0.45) + clampValQuery + obsoleteBoundedValue
      local refMaxValue = math.max(55, zoneDistance * 1.75 + 25 + clampValQuery + obsoleteBoundedValue)

      if distPosCheckconditionref > maxValOther or distanceVec21 > refMaxValue then
        return true, "grass_detour"
      end

      return false
    end,
  }

  if tonumber(secondArg) and secondArg > 0 then
    dataTableV3.maxSpeed = secondArg
  end

  if thirdArg and Settings.foodSearchResultObsolete(thirdArg, fourthArg) then
    return false, "grass_search_obsolete"
  end

  local local = isPositionReachable(firstArg, 8, firstArg, dataTableV3)
  local routeInterruptReason = Settings.safeMove.routeInterruptReason

  if routeInterruptReason == "grass_prompt" then
    return true, "prompt"
  end

  if routeInterruptReason == "grass_invalid" or routeInterruptReason == "grass_detour" then
    return false, routeInterruptReason
  end

  return local, local and "respawnLocation" or routeInterruptReason or "blocked"
end

function Settings.dinoHerbivoreGrassSpawnUsable(firstArg, secondArg, ...)
  if not isDinoLifePlaceId or not firstArg or not firstArg.Parent or not firstArg:IsA("BasePart")
    or not Settings.isDinoHerbivore(secondArg) then
    return false
  end

  local lowerResult = tostring(firstArg.Name or ""):lower()

  if lowerResult:find("aquatic", 1, true) or lowerResult:find("waterPercent", 1, true)
    or lowerResult:find("ocean", 1, true) or lowerResult:find("river", 1, true) then
    return false
  end

  local dinoHerbivoreRockAvoidMargin = Settings.dinoHerbivoreRockAvoidMargin
      and Settings.dinoHerbivoreRockAvoidMargin(secondArg)
    or 10

  if Settings.movementDinoRockPointForbidden
    and Settings.movementDinoRockPointForbidden(firstArg.Position, secondArg, dinoHerbivoreRockAvoidMargin) then
    return false
  end

  if Settings.dinoRestrictedBasin
    and Settings.dinoRestrictedBasin(firstArg.Position, secondArg, dinoHerbivoreRockAvoidMargin) then
    return false
  end

  local raycastSource = workspace:Raycast(
    firstArg.Position + Vector3.new(0, 100, 0), Vector3.new(0, -240, 0), raycastParams
  )

  return raycastSource ~= nil and raycastSource.Material ~= Enum.Material.Water
end

function Settings.dinoHerbivoreGrass(firstArg, ...)
  if not isDinoLifePlaceId or not Settings.autoEat then
    return false, "unsupported"
  end

  local eatAvailable, dinoPosition2 = handleChar()

  if not eatAvailable or not dinoPosition2 or not Settings.isDinoHerbivore(eatAvailable) then
    return false, "not_dino_herbivore"
  end

  local dinoHerbivoreSurvival = Settings.dinoHerbivoreSurvival

  if dinoHerbivoreSurvival.grassTransitActive then
    return false, "already_searching"
  end

  local transitDietType = tonumber(eatAvailable:GetAttribute("Food")) or 100
  local waterAttributenBackup = tonumber(eatAvailable:GetAttribute("Water")) or 100
  local herbivoreCount = tonumber(firstArg) or 92

  if transitDietType >= herbivoreCount then
    return true, "fed"
  end

  if Settings.autoDrink and waterAttributenBackup < 70 and not Settings.dinoHerbivoreFoodEmergency(eatAvailable, transitDietType, waterAttributenBackup) then
    return false, "water_priority"
  end

  if not helperPositionUtil4(dinoPosition2.Position) and Settings.grassEatAvailable(eatAvailable) then
    if Settings.dinoHerbivoreStart2(eatAvailable, dinoPosition2, dinoPosition2.Position) then
      return true, "prompt"
    end

    helperPositionUtil(dinoPosition2.Position, 12, 14)
    Settings.forceStopEatingSubState(eatAvailable, "Dino local Grass had no Food progress")
  end

  local nestRocks = Settings.dinoGrassSearchNestRocks()
  local herbivoreEmptyTable = {}
  local currentTimestampEleven = tick()

  if dinoHerbivoreSurvival.grassCharacter ~= eatAvailable then
    dinoHerbivoreSurvival.grassCharacter = eatAvailable
    dinoHerbivoreSurvival.grassSpawnVisited = {}
  end

  for herbivoreLoopIdxValue, herbivoreLoopItem in ipairs(nestRocks) do
    if (herbivoreLoopItem.Name == "NestRock" or herbivoreLoopItem.Name == "NestRockA")
      and Settings.dinoHerbivoreGrassSpawnUsable(herbivoreLoopItem, eatAvailable) then
      local distanceVec14 = Vector3.new(
        herbivoreLoopItem.Position.X - dinoPosition2.Position.X, 0, herbivoreLoopItem.Position.Z - dinoPosition2.Position.Z
      ).Magnitude

      if distanceVec14 >= 35 then
        local conditionalResultPrev = dinoHerbivoreSurvival.grassSpawnVisited[herbivoreLoopItem] or 0

        herbivoreEmptyTable[#herbivoreEmptyTable + 1] = {
          part = herbivoreLoopItem,
          index = herbivoreLoopIdxValue,
          distance = distanceVec14,
          lastVisit = conditionalResultPrev,
          fresh = currentTimestampEleven - conditionalResultPrev >= 75,
        }
      end
    end
  end

  if #herbivoreEmptyTable == 0 then
    return false, "no_safe_NestRock1_or_NestRock2"
  end

  table.sort(herbivoreEmptyTable, function(ignored, ignored, ...)
    if ignored.fresh ~= ignored.fresh then
      return ignored.fresh
    end

    if not ignored.fresh and ignored.lastVisit ~= ignored.lastVisit then
      return ignored.lastVisit < ignored.lastVisit
    end

    return ignored.distance < ignored.distance
  end)

  local dinoPosition10 = herbivoreEmptyTable[1]
  local destinationPoint = dinoPosition10.part.Position

  dinoHerbivoreSurvival.grassSpawnVisited[dinoPosition10.part] = currentTimestampEleven
  dinoHerbivoreSurvival.grassTransitActive = true
  dinoHerbivoreSurvival.grassTransitFound = nil
  dinoHerbivoreSurvival.grassTransitReason = nil
  dinoHerbivoreSurvival.grassLastScanAt = 0

  local transitHerbivoreg = eatAvailable
  local destinationPoint = dinoPosition2.Position
  local currentTimestampCache = tick()

  strLitInf = "Dino herbivore Grass search: heading toward " .. tostring(dinoPosition10.part.Name)
    .. " (NestRockB excluded) while scanning for Grass"

  local transitHerbivoreh = isPositionReachable(destinationPoint, 10, nil, {
    purpose = "foodPercent",
    forceMoveToLand = true,
    tolerance = 22,
    speedScale = 1,
    constantSpeed = true,
    maxDuration = 55,
    routeCheckInterval = 0.3,
    routeCheck = function(ignored, ignored, ...)
      if not Settings.autoEat or ignored ~= transitHerbivoreg or not ignored or not ignored then
        dinoHerbivoreSurvival.grassTransitReason = "character_changed"
        return true, dinoHerbivoreSurvival.grassTransitReason
      end

      local transitFoodAttribute = tonumber(ignored:GetAttribute("Food")) or 100
      local waterAttributeDuplicate = tonumber(ignored:GetAttribute("Water")) or 100

      if transitFoodAttribute >= herbivoreCount then
        dinoHerbivoreSurvival.grassTransitReason = "fed"
        return true, "fed"
      end

      if Settings.autoDrink and waterAttributeDuplicate < 70 and not Settings.dinoHerbivoreFoodEmergency(ignored, transitFoodAttribute, waterAttributeDuplicate) then
        dinoHerbivoreSurvival.grassTransitReason = "water_priority"
        return true, "water_priority"
      end

      if not helperPositionUtil4(ignored.Position) and Settings.grassEatAvailable(ignored) then
        dinoHerbivoreSurvival.grassTransitFound = ignored.Position
        dinoHerbivoreSurvival.grassTransitReason = "grass_prompt"
        return true, "grass_prompt"
      end

      local currentTick36 = tick()

      if currentTick36 - (dinoHerbivoreSurvival.grassLastScanAt or 0) >= 1.05 then
        dinoHerbivoreSurvival.grassLastScanAt = currentTick36
        local transitPositioninherbivore = iterateItemsQuery(ignored.Position)

        if transitPositioninherbivore then
          dinoHerbivoreSurvival.grassTransitFound = transitPositioninherbivore
          dinoHerbivoreSurvival.grassTransitReason = "grass_found"
          return true, "grass_found"
        end
      end

      if Vector3.new(ignored.Position.X - destinationPoint.X, 0, ignored.Position.Z - destinationPoint.Z).Magnitude
        >= 3 then
        destinationPoint = ignored.Position
        currentTimestampCache = currentTick36
      elseif currentTick36 - currentTimestampCache >= 7 then
        dinoHerbivoreSurvival.grassTransitReason = "route_stall"
        return true, "route_stall"
      end

      return false
    end,
  })

  local grassTransitFound = dinoHerbivoreSurvival.grassTransitFound
  local grassTransitReason = dinoHerbivoreSurvival.grassTransitReason

  dinoHerbivoreSurvival.grassTransitActive = false
  dinoHerbivoreSurvival.grassTransitFound = nil
  dinoHerbivoreSurvival.grassTransitReason = nil
  dinoHerbivoreSurvival.grassLastScanAt = 0

  eatAvailable, dinoPosition2 = handleChar()

  if eatAvailable ~= transitHerbivoreg or not eatAvailable or not dinoPosition2 then
    return false, "character_changed"
  end

  if grassTransitReason == "water_priority" then
    return false, "water_priority"
  end

  if grassTransitReason == "route_stall" then
    dinoHerbivoreSurvival.grassSpawnVisited[dinoPosition10.part] = tick()
  end

  if grassTransitReason == "fed" then
    return true, "fed"
  end

  if grassTransitReason == "grass_prompt" and Settings.grassEatAvailable(eatAvailable) then
    if Settings.dinoHerbivoreStart2(eatAvailable, dinoPosition2, dinoPosition2.Position) then
      return true, "prompt"
    end

    helperPositionUtil(dinoPosition2.Position, 12, 14)
    Settings.forceStopEatingSubState(eatAvailable, "Dino transit Grass had no Food progress")
    return false, "prompt_no_food_progress"
  end

  if typeof(grassTransitFound) == "Vector3" then
    local resultTransit, transitHerbivorei = checkConditionRef(grassTransitFound, nil, eatAvailable, transitDietType)
    eatAvailable, dinoPosition2 = handleChar()

    if resultTransit and eatAvailable == transitHerbivoreg and dinoPosition2 and Settings.grassEatAvailable(eatAvailable) then
      if Settings.dinoHerbivoreStart2(eatAvailable, dinoPosition2, grassTransitFound) then
        return true, "grass_found"
      end

      helperPositionUtil(grassTransitFound, 5, 10)
      return false, "grass_no_food_progress"
    end

    return false, transitHerbivorei or "grass_move_failed"
  end

  return false, grassTransitReason or transitHerbivoreh and "arrived_no_grass" or "route_failed"
end

