function Settings.herbivoreFoodRecoveryTarget(...)
  if not isNotJungleLife then
    return nil
  end

  local questZoneFarmTarget

  if Settings.autoQuests and Settings.questZonePriorityActive and Settings.questZonePriorityActive()
    and not Settings.growthFoodRefillAreaRelaxed(localPlayer.Character) then
    if typeof(Settings.questZoneFarmTarget) == "Vector3" then
      questZoneFarmTarget = Settings.questZoneFarmTarget
    else
      return nil
    end
  end

  local spawnsChild = not questZoneFarmTarget and workspace:FindFirstChild("Spawns")
  local findFirstChildMore = spawnsChild and spawnsChild:FindFirstChild("PrideRockSpawn", true)

  if findFirstChildMore and findFirstChildMore:IsA("BasePart") then
    questZoneFarmTarget = findFirstChildMore.Position
  end

  if not questZoneFarmTarget and Settings.growthPride and typeof(Settings.growthPride.home) == "Vector3" then
    questZoneFarmTarget = Settings.growthPride.home
  end

  local herbivoreFoodRecovery3 = Settings.herbivoreFoodRecovery

  local targetDietType = herbivoreFoodRecovery3 and herbivoreFoodRecovery3.active
      and not Settings.questZonePriorityActive()
      and math.max(0, tonumber(herbivoreFoodRecovery3.replanCount) or 0)
    or 0

  local prideForbidden = typeof(questZoneFarmTarget) == "Vector3" and Settings.savannahSurvivalTarget(
    questZoneFarmTarget, localPlayer.Character, 5
  )

  if typeof(questZoneFarmTarget) ~= "Vector3" or not prideForbidden and targetDietType == 0 then
    return questZoneFarmTarget
  end

  local targetUnderMainWater, targetUnderMainWater, targetUnderMainWater, targetUnderMainWater, targetUnderMainWater, rockEnvelope2 = Settings.movementPrideRockEnvelope(
    localPlayer.Character, 5
  )

  local targetUnderMainWater, localPositionFood6 = handleChar()

  if not targetUnderMainWater or not targetUnderMainWater or not rockEnvelope2 or not localPositionFood6 then
    return nil
  end

  local pointToObjectSpaceValue = targetUnderMainWater:PointToObjectSpace(questZoneFarmTarget)
  local vec3Value = Vector3.new(pointToObjectSpaceValue.X, 0, pointToObjectSpaceValue.Z)

  if vec3Value.Magnitude <= 0.05 then
    local pointToObjectSpaceWork = targetUnderMainWater:PointToObjectSpace(localPositionFood6.Position)
    vec3Value = Vector3.new(pointToObjectSpaceWork.X, 0, pointToObjectSpaceWork.Z)
  end

  if vec3Value.Magnitude <= 0.05 then
    vec3Value = Vector3.new(1, 0, 0)
  else
    vec3Value = vec3Value.Unit
  end

  if targetDietType > 0 then
    local foodNum3 = (tonumber(herbivoreFoodRecovery3.replanSign) or 1)
      * math.rad(28 + targetDietType % 4 * 17)

    local targetUnderMainWater, foodCalcValue = math.cos(foodNum3), math.sin(foodNum3)

    vec3Value = Vector3.new(
      vec3Value.X * targetUnderMainWater - vec3Value.Z * foodCalcValue, 0, vec3Value.X * foodCalcValue + vec3Value.Z * targetUnderMainWater
    ).Unit
  end

  local targetWorldSpace = targetUnderMainWater:PointToWorldSpace(vec3Value * (math.min(
    math.abs(vec3Value.X) > 0.0001 and targetUnderMainWater / math.abs(vec3Value.X) or math.huge,
    math.abs(vec3Value.Z) > 0.0001 and rockEnvelope2 / math.abs(vec3Value.Z) or math.huge
  ) + 7 + math.min(targetDietType * 5, 30)))

  local raycastTarget = workspace:Raycast(Vector3.new(
    targetWorldSpace.X, math.max(localPositionFood6.Position.Y + 180, 300), targetWorldSpace.Z
  ), Vector3.new(0, -600, 0), raycastParams)

  local posiMaterialFood = raycastTarget and raycastTarget.Material ~= Enum.Material.Water
      and raycastTarget.Position
    or nil

  return posiMaterialFood
      and not Settings.savannahSurvivalTarget(posiMaterialFood, localPlayer.Character, 5)
      and posiMaterialFood
    or nil
end

