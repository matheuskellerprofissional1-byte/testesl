  function Settings.questGroup.coopLifecycleStep(...)
    if not Settings.alive or Settings.questGrowthReset.exclusive or isFalseInglobal1
      or Settings.questGroup.coop.helperSwitching then
      return
    end

    local questGroupResolvehandler = Settings.questGroup.resolveHandler()

    if not questGroupResolvehandler then
      return
    end

    local stepCoopProperty = Settings.questGroup.coop
    local groupTime = Settings.questGroup.localHasActiveGroupTime()

    if groupTime and Settings.autoQuests
      and tick() - (tonumber(Settings.questGroup.activeWatchAt) or 0) >= 1.1 then
      Settings.questGroup.activeWatchAt = tick()

      if Settings.questGroup.disabledFlag
        and tick() - (tonumber(Settings.questGroup.lastCreateAttemptAt) or 0) >= 10 then
        Settings.questGroup.disabledFlag = false
        Settings.questGroup.lastCreateAttemptAt = 0
        Settings.questGroup.createFailures = (Settings.questGroup.createFailures or 0) + 1
        Settings.questGroup.statusText = "KITTY co-op: stale create transaction released; retrying"
      end

      pcall(Settings.questGroup.currentAnimalEnsure, utilityHelper(), false)
    end

    if groupTime and not Settings.autoQuests then
      pcall(Settings.questGroup.passiveGroupTimeWatchStep, groupTime)
    end

    local probeState = Settings.questGroup.coopProbeState()
    local characterCurrentPack = Settings.questGroup.getCurrentPack(questGroupResolvehandler)
    local nameCharacterTeamName = Settings.questGroup.getPlayerMMbTeamName(localPlayer)

    if not characterCurrentPack and not nameCharacterTeamName then
      local characterPlayerAnimal = Settings.questGroup.getPlayerAnimal(localPlayer)
      local groupHealthStep, groupHealthStep, inviteOpportunity = Settings.questGroup.hasCompatibleInviteOpportunity(questGroupResolvehandler, characterPlayerAnimal)

      if groupTime or groupHealthStep then
        local stepIfFree

        if groupHealthStep and inviteOpportunity == "autoaccept" then
          stepIfFree = Settings.questGroup.requestJoinIfFree(questGroupResolvehandler, groupHealthStep)
        elseif groupHealthStep then
          stepIfFree = Settings.questGroup.acceptInviteIfFree(questGroupResolvehandler, groupHealthStep)
        elseif groupTime then
          stepIfFree = Settings.questGroup.acceptInviteIfFree(questGroupResolvehandler, nil)
        end

        if stepIfFree then
          Settings.questGroup.statusText = "KITTY co-op: compatible group membership verified"
          return
