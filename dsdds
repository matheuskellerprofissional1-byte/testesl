      local reasonSurvivalTransaction = Settings.activeAuthoritativeSurvival()

      if reasonSurvivalTransaction then
        if secondArg.type == "Crescimento" and Settings.questGrowthMature(thirdArg.character)
          and thirdArg.foodPercent >= 80 and thirdArg.waterPercent >= 70 then
          return "100% slot must reset before Growth quest can continue"
        end

        return "waiting for authoritative " .. reasonSurvivalTransaction .. " transaction"
      end

      if secondArg.type == "Swim" and Settings.questCurrentAnimalBlocksSwim() then
        return "waiting for compatible temporary Swim helper"
      end

      if isNotJungleLife and secondArg.type == "Zone" and type(secondArg.zone) == "string"
        and secondArg.zone:lower() == "tshukudu canyon"
        and Settings.characterQuestCanyonBlocked(thirdArg.character) then
