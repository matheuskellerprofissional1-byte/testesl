function Settings.questGroup.refreshAvailability(firstArg, secondArg, ...)
  secondArg = secondArg == true and Settings.questGroup.growthBlockCrossSpecies ~= true
  local availabilityPlayerAnimal = Settings.questGroup.getPlayerAnimal(localPlayer)

  if Settings.questGroup.availabilityAnimal ~= availabilityPlayerAnimal then
    Settings.questGroup.availabilityAnimal = availabilityPlayerAnimal
    Settings.questGroup.impossibleSince = nil
    Settings.questGroup.ignoredUntilPossibility = false
  end

  if Settings.questGroup.hasRealPossibility(firstArg, secondArg == true) then
    local ignoredUntilPossibility = Settings.questGroup.ignoredUntilPossibility

    Settings.questGroup.impossibleSince = nil
    Settings.questGroup.ignoredUntilPossibility = false
    Settings.questGroup.lastPossibilityAt = tick()

    if ignoredUntilPossibility then
      Settings.questGroup.difficultySince = tick()
      Settings.questGroup.statusText = "Grouping: new server possibility detected; GroupTime resumed"

      strLitInf = "GroupTime resumed: a valid player/pack is now available"
      Settings.questForceFastRecheckUntil = tick() + 20
    end

    return true
  end

  if not Settings.questGroup.impossibleSince then
    Settings.questGroup.impossibleSince = tick()
  end

  local availabilityPlayersResult = #players:GetPlayers() <= 1 and 8 or 25

  if tick() - Settings.questGroup.impossibleSince >= availabilityPlayersResult then
    if not Settings.questGroup.ignoredUntilPossibility then
      Settings.questGroup.ignoredUntilPossibility = true
      Settings.questGroup.statusText = "Grouping ignored: no viable player/pack in this server"

      strLitInf = "GroupTime skipped until a new grouping possibility appears"
      Settings.questForceFastRecheckUntil = tick() + 20
    end

    return false
  end

  Settings.questGroup.statusText = "Grouping: checking server possibilities before skipping"
  return true
end

function Settings.questIsActionable(firstArg, secondArg, ...)
  if GameConfig.name == "JungleLife" then
    return false
  end

  if type(firstArg) ~= "table" or type(firstArg.props) ~= "table" then
    return false
  end

  if Settings._isSwimQuest(firstArg.props) then
    if not Settings.questSwimQuestIncomplete(firstArg) then
      return false
    end
  elseif Settings.questGroup.questComplete(firstArg) then
    return false
  end

  secondArg = secondArg or utilityHelper()

  if not Settings.questAllowedDuringAutoGrow(firstArg) then
    return false, "auto_grow_parallel_filtered", nil
  end

  if Settings._isSwimQuest(firstArg.props) and Settings.questCurrentAnimalBlocksSwim() then
    return true, "swim_requires_temporary_grounded_slot", nil
  end

  local questLocal8 = questHandleQuest(firstArg, secondArg)

  if (firstArg.props.QuestData or {}).ShouldBeSpawnedAsSpecificAnimalName and not questLocal8 then
    return false, "specific_animal_unresolved", nil
  end

  if questLocal8 then
    local questSlotsSetting = Settings.questSlots.unavailableReason(questLocal8, secondArg)

    if questSlotsSetting then
      return false, questSlotsSetting, questLocal8
    end
  end

  if isDinoLifePlaceId and firstArg.props.QuestType == "NestTime" and Settings.questNestQuestActionable then
    local actionableNestHasIncomplete, questActionable = Settings.questNestQuestActionable(firstArg, secondArg)
    return actionableNestHasIncomplete, questActionable, nil
  end

  if firstArg.props.QuestType == "GroupTime" then
    if not Settings.questGroup.refreshAvailability(secondArg, not Settings.questGrowthConcurrentActive())
      and Settings.questGroup.ignoredUntilPossibility then
      return false, "group_unavailable", nil
    end
  end

  return true, nil, questLocal8
end

