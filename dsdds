        local foodNeed = startSurvivalThreshold or mmbaiAuthority.Policy.Survival.foodNeed
        local waterNeed = startSurvivalThreshold or mmbaiAuthority.Policy.Survival.waterNeed

        if isNotJungleLife and Settings.slotParkingAudit and Settings.slotParkingAudit.active then
          local survivalPending = Settings.savannahParkingSurvivalPending(preemptionAllowed.character, resultPreemption, resultPreemption)

          if survivalPending then
            return false, survivalPending == "foodPercent" and "Final parking waits for Food -> 92%"
              or "Final parking waits for Water -> 98%"
          end
        end

        if resultPreemption < foodNeed or resultPreemption < waterNeed then
          return false, startSurvivalThreshold and "Parking audit waiting for configured Survival floor"
            or "Slots waiting for Survival 80/70"
        end

        return true, "verified slot transaction"
      end

      local preemptionSurvivalVerdict = firstArg:SurvivalVerdict(preemptionAllowed)

      if secondArg == "Water" then
        if preemptionAllowed.drinkingProtected == true or Settings.drinkTest.active
          or preemptionSurvivalVerdict.selected == "Water" then
          return true, preemptionSurvivalVerdict.dinoWaterEmergency
              and "Dino Water <=70%; emergency Water handoff required"
            or "Water <" .. mmbaiAuthority.Policy.Survival.waterNeed .. "%; Survival handoff required"
        end
      end

      if secondArg == "Food" then
        if Settings.herbivoreFoodRecovery and Settings.herbivoreFoodRecovery.active
          or targetClearModule and targetClearModule.exclusiveRecovery and targetClearModule.exclusiveRecovery.active
          or preemptionSurvivalVerdict.selected == "Food" then
          if isDinoLifePlaceId and preemptionSurvivalVerdict.dinoHerbivoreFood92Maintenance
            and not preemptionSurvivalVerdict.dinoFoodEmergency and not preemptionSurvivalVerdict.foodNeed then
            return false, "Dino Food maintenance waits for healthy locomotion until Food <=80"
          end

          return true, preemptionSurvivalVerdict.dinoFoodEmergency
              and "Dino Food <=80%; emergency Food handoff required"
            or preemptionSurvivalVerdict.afkFoodMaintenance and not preemptionSurvivalVerdict.foodNeed
              and "AFK Coin Food maintenance handoff required"
            or "Food <" .. mmbaiAuthority.Policy.Survival.foodNeed .. "%; Survival handoff required"
        end
      end

      if secondArg == "Quest" and thirdArg == "Crescimento" and Settings.questLocomotionIntentVerified()
        and not resultPreemption and not preemptionSurvivalVerdict.selected and not mmbaiConfig.active
        and not Settings.questGrowthReset.exclusive and not Settings.questSlots.busy
