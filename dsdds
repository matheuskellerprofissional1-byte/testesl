        and firstArg > 25
        and not (isNotJungleLife and Settings.questMoveInteract
          and tick() < (Settings.questMoveInteract.stationaryEatRetryAfter or 0)) then
        return "foodPercent"
      end

      if Settings.drinkVisualPromptVisible and Settings.drinkVisualPromptVisible() and secondArg > 25 then
        return "waterPercent"
      end

      if Settings.eatVisualPromptVisible
        and Settings.eatVisualPromptVisible()
        and firstArg > 25
        and not (isNotJungleLife and Settings.questMoveInteract
          and tick() < (Settings.questMoveInteract.stationaryEatRetryAfter or 0)) then
        return "foodPercent"
      end
    end

    local chooseArbitere = firstArg / chooseLocalValue
    local chooseArbiterf = secondArg / conditionalResultAux

