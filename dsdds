      end

      if postureInvalid or Settings.dinoPostDrinkExit and Settings.dinoPostDrinkExit.active then
        return true, "post-drink dry-bank exit"
      end

      if Settings.dinoCarcassWaterRecovery
        and Settings.dinoCarcassWaterRecovery.active
        and Settings.dinoCarcassWaterRecovery.character
          == (hazardCheckResult.character or localPlayer.Character) then
        return true, "Dino carcass crossing target-side bank recovery"
      end

      if hazardCheckResult.dinoShorelineFoodDeadlock == true and not locSafe
        and not hazardCheckResult.intentionalWaterTransit then
        return true, "Dino shoreline Food deadlock"
