function Settings.releaseAquaticDry(firstArg, secondArg, ...)
  if not firstArg or firstArg ~= localPlayer.Character
    or not Settings.isCrocOrHippoMovementCharacter(firstArg) then
    return false
  end

  if Settings.undergroundDrinkWaterLock and Settings.undergroundDrinkWaterLock(firstArg) then
    return false
  end

  local ownershipWaterAttribute = tonumber(firstArg:GetAttribute("Water")) or 100
  local mmbaiReference = Settings.MMBAI
  local authority5 = mmbaiReference and mmbaiReference.Authority

  local survival = mmbaiReference and mmbaiReference.Policy and mmbaiReference.Policy.Survival
      and tonumber(mmbaiReference.Policy.Survival.waterNeed)
    or 70

  if Settings.safeMove and Settings.safeMove.active
    and (Settings.safeMove.reason == "waterPercent" or Settings.safeMove.reason == "water_search") then
    Settings.safeMove.cancelToken = Settings.safeMove.cancelToken + 1
    Settings.safeMove.active = false
    Settings.safeMove.target = nil
    Settings.safeMove.reason = nil
    Settings.safeMove.owner = nil
    Settings.safeMove.manualLabel = nil
  end

  if not (Settings.safeMove and Settings.safeMove.active) then
    Settings.busy = false
  end

  local ownershipFullRefill = Settings.questTravelFullRefill
    and Settings.questTravelFullRefill.active == true and Settings.questTravelFullRefill.owner == "waterPercent"
    and ownershipWaterAttribute < 100

  local ownershipStateFlag = Settings.slotSwitchStagingActive == true and tonumber(primaryFood) or nil
  local isWaterValidCheck = ownershipStateFlag ~= nil and ownershipWaterAttribute < ownershipStateFlag

  if ownershipWaterAttribute < survival or ownershipFullRefill or isWaterValidCheck then
    noCarcassAvailable = true

    if mmbaiReference and mmbaiReference.Blackboard then
      mmbaiReference.Blackboard.survivalVerdict = nil
    end

    if authority5 then
      pcall(authority5.ClearHandoffIfReleased, authority5, mmbaiReference.Blackboard)
      pcall(authority5.Elect, authority5, mmbaiReference.Blackboard)
    end

    if mmbaiReference and type(mmbaiReference.RequestWorker) == "function" then
      pcall(
        mmbaiReference.RequestWorker, mmbaiReference, "AutoDrink",
        "Dry-bank Water route ended before refill target; retrying cleanly", 0.02
      )
    end

    return true
  end

  noCarcassAvailable = false

  if Settings.survivalArbiter and Settings.survivalArbiter.owner == "waterPercent" and Settings.survivalArbiterReset then
    Settings.survivalArbiterReset("Croc/Hippo dry bank: Water safe; releasing stale ownership")
  end

  if mmbaiReference and mmbaiReference.Blackboard then
    mmbaiReference.Blackboard.survivalVerdict = nil
  end

  if authority5 then
    authority5.controllerLeaseUntil = 0
    pcall(authority5.ClearHandoffIfReleased, authority5, mmbaiReference.Blackboard)
    pcall(authority5.Elect, authority5, mmbaiReference.Blackboard)
  end

  local ownershipCurrentOwner = authority5 and authority5.currentOwner or nil

  if mmbaiReference and type(mmbaiReference.RequestWorker) == "function" then
    if ownershipCurrentOwner == "Food" then
      survivalBaseValue = 0

      pcall(
        mmbaiReference.RequestWorker, mmbaiReference, "AutoEat",
        "Dry bank -> resume carnivore carcass patrol", 0.01
      )
    elseif ownershipCurrentOwner == "Quest" then
      pcall(
        mmbaiReference.RequestWorker, mmbaiReference, "AutoQuests", "Dry bank -> resume Auto Quests", 0.01
      )
    elseif ownershipCurrentOwner == "Crescimento" then
      pcall(mmbaiReference.RequestWorker, mmbaiReference, "GrowSlots", "Dry bank -> resume Growth", 0.01)
    elseif ownershipCurrentOwner == "AFkCoins" then
      pcall(mmbaiReference.RequestWorker, mmbaiReference, "AFkCoins", "Dry bank -> resume AFK Coins", 0.01)
    elseif Settings.carnivorePassiveScavenge and Settings.carnivorePassiveScavenge(firstArg) then
      survivalBaseValue = 0

      pcall(
        mmbaiReference.RequestWorker, mmbaiReference, "AutoEat",
        "Dry bank -> resume carnivore carcass patrol", 0.01
      )
    end
  end

  return true
end

