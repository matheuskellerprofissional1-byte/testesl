  local assistLocalValue = root.Size and root.Size.Y or 2
  local lowNumValue = math.max(1, (tonumber(assistStateFlag.HipHeight) or 0) + assistLocalValue * 0.5)
  local assistMaxResult = math.max(0.5, root.Position.Y - climbTarget)
  local lowMaxValue = math.clamp(math.max(lowNumValue, assistMaxResult), lowNumValue, lowNumValue + 0.75)
  Settings.heavyWalkStop(assistCharacterValue)

  if Settings.questSetWork then
