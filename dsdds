    or not Settings.isDinoHerbivore or not Settings.isDinoHerbivore(firstArg) then
    return false
  end

  local dinoHerbivoreRockClearance = Settings.dinoHerbivoreRockClearance
  local clearanceDietType = tick()

  if dinoHerbivoreRockClearance.active then
    return true
  end

  if clearanceDietType < (dinoHerbivoreRockClearance.retryAfter or 0) then
    return false
  end

  if not Settings.dinoHerbivoreRock(firstArg, secondArg) then
    return false
  end

  local rockClearance, rockClearance, rockClearance, trapMetrics = Settings.dinoRockMoralTrapMetrics(firstArg, secondArg.Position)

  if rockClearance or rockClearance > 0 or trapMetrics <= 2 then
    if Settings.startDinoRockTrapRecovery then
      return Settings.startDinoRockTrapRecovery(fourthArg
        or "Dino herbivore physically trapped beside rock", true)
    end

    return false
  end

  Settings.dinoHerbivoreRetire(firstArg, secondArg, "Rock clearance predecessor")
  local rockClearance, rockClearance, clearanceCleare = handleChar()
  local safePoint = Settings.dinoRockEmergencyFindSafePoint(firstArg, secondArg, clearanceCleare)

  if typeof(safePoint) ~= "Vector3" then
    dinoHerbivoreRockClearance.retryAfter = clearanceDietType + 1
    return false
  end

  dinoHerbivoreRockClearance.token = dinoHerbivoreRockClearance.token + 1
  local clearanceTokenProperty = dinoHerbivoreRockClearance.token

  dinoHerbivoreRockClearance.active = true
  dinoHerbivoreRockClearance.character = firstArg
  dinoHerbivoreRockClearance.target = safePoint
  dinoHerbivoreRockClearance.startedAt = clearanceDietType
  dinoHerbivoreRockClearance.reason = fourthArg or "Dino herbivore survival rock clearance"

  local clearanceLocalValue = thirdArg == "Water" and "water_search" or "foodPercent"
  strLitInf = "Dino herbivore: moving away from blocked rocks before Survival"

  task.spawn(function(...)
    local clearanceClearg = isPositionReachable(safePoint, 8, nil, {
      purpose = clearanceLocalValue,
      forceMoveToLand = true,
      constantSpeed = true,
      tolerance = 7,
      maxDuration = 38,
      routeCheckInterval = 0.18,
      routeCheck = function(ignored, ignored, ...)
        if dinoHerbivoreRockClearance.token ~= clearanceTokenProperty or ignored ~= firstArg or not ignored then
          return true, "clearance_cancelled"
        end

        if not Settings.dinoHerbivoreRock(ignored, ignored) then
          local rockClearance, rockClearance, rockClearance, clearanceTrapMetrics = Settings.dinoRockMoralTrapMetrics(ignored, ignored.Position)

          if rockClearance <= 0 and clearanceTrapMetrics >= 5 then
            return true, "rock_clearance_confirmed"
          end
        end

        return false
      end,
    })

    if dinoHerbivoreRockClearance.token ~= clearanceTokenProperty then
      return
    end

    dinoHerbivoreRockClearance.active = false
    dinoHerbivoreRockClearance.character = nil
    dinoHerbivoreRockClearance.target = nil

    local bufferRequired, clearanceClearh = handleChar()

    if bufferRequired == firstArg and clearanceClearh and Settings.dinoHerbivoreRock(bufferRequired, clearanceClearh) or false then
      dinoHerbivoreRockClearance.retryAfter = tick() + 0.8
      strLitInf = "Dino herbivore: rock clearance incomplete; replanning before Survival"
    else
      dinoHerbivoreRockClearance.retryAfter = 0
      Settings.dinoRockResetFoodRouteEvidence()
      local mmbaiProperty = Settings.MMBAI

      if mmbaiProperty and mmbaiProperty.Blackboard then
        mmbaiProperty.Blackboard.dinoRockTrapped = false
        mmbaiProperty.Blackboard.survivalVerdict = nil
      end

      if mmbaiProperty and mmbaiProperty.Authority
        and type(mmbaiProperty.Authority.ReleaseStaleSafety) == "function" then
        pcall(
          mmbaiProperty.Authority.ReleaseStaleSafety, mmbaiProperty.Authority, mmbaiProperty.Blackboard,
          "Dino herbivore rock clearance completed"
        )
      end

      strLitInf = clearanceClearg and "Dino herbivore: clear of blocked rocks; resuming Survival"
        or "Dino herbivore: rock buffer cleared; resuming Survival"

      if mmbaiProperty and type(mmbaiProperty.RequestWorker) == "function" then
        pcall(mmbaiProperty.RequestWorker, mmbaiProperty, "AutoEat", "rock clearance complete", 0.02)
        pcall(mmbaiProperty.RequestWorker, mmbaiProperty, "AutoDrink", "rock clearance complete", 0.02)
      end
    end
  end)

  return true
