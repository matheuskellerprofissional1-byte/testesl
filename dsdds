        drinkTestConfig.lastError = conditionSupervisorPermit and "Elephant virtual floor could not start"
          or "Elephant virtual floor error: " .. tostring(successOther)

        strLitInf = drinkTestConfig.lastError .. "; retrying surface exit"
        sixthCheckCondition, localInfdNext, localHealthEject = handleChar()

        if sixthCheckCondition == drinkTestConfig.character and localInfdNext and localHealthEject and localHealthEject.Health > 0 then
          localInfdNext.cFrame = cFrame.new(localInfdNext.Position.X, val + 0.5, localInfdNext.Position.Z) * rotationProperty
          localInfdNext.AssemblyLinearVelocity = Vector3.zero
          localInfdNext.AssemblyAngularVelocity = Vector3.zero

          Settings.drinkTestSetTransitPhysics(sixthCheckCondition, localHealthEject, true)
          Settings.drinkTestGhostCharacter(sixthCheckCondition, false)
        end

