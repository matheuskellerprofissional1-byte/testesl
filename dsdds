    end

    dinoDrinkVisualRocks.folder, dinoDrinkVisualRocks.single = rocksFolder, movementDinoSingleRockModelConfig2
    dinoDrinkVisualRocks.grid, dinoDrinkVisualRocks.scannedAt = spatialGrid, atTimestamp
  end

  local cellKey = tostring(math.floor(firstArg.X / 64)) .. ":" .. tostring(math.floor(firstArg.Z / 64))

  for itemsLoopIdx, itemsLoopItem in ipairs(dinoDrinkVisualRocks.grid[cellKey] or {}) do
    if itemsLoopItem.Parent and not itemsLoopItem.CanCollide and itemsLoopItem.Transparency < 0.95 then
