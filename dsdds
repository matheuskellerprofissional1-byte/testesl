    end

    testTestSmoothMove.Anchored = false
    testTestSmoothMove.AssemblyLinearVelocity = Vector3.zero
    testTestSmoothMove.AssemblyAngularVelocity = Vector3.zero

    local getPivot
    pcall(function(...) getPivot = testPlayerCharacter:GetPivot() end)
    localSpot.waterPart.CanCollide = false

