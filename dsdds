      end

      local locSafe = hazardCheckResult.drinkingProtected == true
      local hazardParsedNumber = tick() - (tonumber(hazardCheckResult.environmentEvidenceAt) or 0) <= 3
      local savannahNoGoRegion = hazardParsedNumber and hazardCheckResult.savannahNoGoRegion or nil

      local hazardPhysicalOwner = hazardCheckResult.intentionalWaterTransit
          and firstArg:PhysicalOwner(hazardCheckResult)
        or nil

      local questSwimActiveConfig = Settings.questSwimActive == true
        or hazardPhysicalOwner ~= nil
          and firstArg:PhysicalProgressAge(hazardPhysicalOwner, hazardCheckResult)
            <= mmbaiAuthority.Policy.Decision.progressRetention

      if savannahNoGoRegion and not locSafe and not questSwimActiveConfig then
        return true, "Savannah blocked rock/waterPercent region"
      end

      if isNotJungleLife and not locSafe and hazardParsedNumber and hazardCheckResult.canyonInside == true then
        local locaSafe3 = hazardCheckResult.canyonAuthorized == true

        local savannahCanyonInside = not locaSafe3
            and Settings.savannahCanyonInside
            and Settings.savannahCanyonInside(charactergOther)
          or false

        local savannahCanyonEgress = not locaSafe3
            and Settings.savannahCanyonEgress
            and Settings.savannahCanyonEgress(charactergOther)
          or false

        local safeIsFalse = false

        if not locaSafe3 and not savannahCanyonInside then
          local savannahCanyonGuardConfig4 = Settings.savannahCanyonGuard

          if savannahCanyonGuardConfig4 then
            local hazardCurrentTimestamp = tick()

            if (tonumber(savannahCanyonGuardConfig4.unauthorizedSince) or 0) <= 0 then
              savannahCanyonGuardConfig4.unauthorizedSince = hazardCurrentTimestamp
              savannahCanyonGuardConfig4.egressGraceUntil = hazardCurrentTimestamp + 4
            end

            safeIsFalse = hazardCurrentTimestamp < (tonumber(savannahCanyonGuardConfig4.egressGraceUntil) or 0)
          end
        end

        if not locaSafe3 and not savannahCanyonInside
          and not savannahCanyonEgress and not safeIsFalse then
          return true, "Tshukudu Canyon forbidden/trap region"
        end

        if locaSafe3
          and Settings.safeMove
          and Settings.safeMove.active == true
          and Settings.safeMove.reason == "quest"
          and tick()
              - (tonumber(Settings.safeMove.lastProgressAt) or tonumber(Settings.safeMove.startedAt)
                or tick())
            >= 5 then
