      end

      local survivalLowVita = Settings.survivalLowVitalPriority(resultPreemption, resultPreemption, preemptionAllowed.character)

      if survivalLowVita and (secondArg == "Food" or secondArg == "Water") then
        if thirdArg == "Safety" and resultPreemption then
          return false, "verified Safety hazard retains movement"
        end

        if secondArg ~= (survivalLowVita == "foodPercent" and "Food" or "Water") then
          return false, "opposite critical vital owns Survival"
        end

        if not resultPreemption then
          return true, "shared critical Food/Water priority"
        end
      end

      if secondArg == "Slots"
        and (Settings.slotSwitchStagingActive == true
          or Settings.autoGrowCurrentSlotComplete(preemptionAllowed.character)
          or Settings.questGrowthReset.exclusive or Settings.slotGuardian.recovering
          or Settings.slotParkingAudit.active or Settings.questSlots.busy or Settings.coinFarmSwitching) then
