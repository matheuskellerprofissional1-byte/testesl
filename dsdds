    function mmbaiModuleRegistry.GoalManager.SelectStableCandidate(firstArg, secondArg, thirdArg, ...)
      local locCandidate = secondArg[1]
      local authoritySource = mmbaiModuleRegistry.Authority
      local selectIsFalse = false
      local selectIsFalse1 = false
      local candidateSurvivalVerdict = authoritySource and authoritySource:SurvivalVerdict(thirdArg)
      local safetyHazard = authoritySource and authoritySource:SafetyHazard(thirdArg)

      if safetyHazard then
        for selectLoopIdxValue, selectLoopItemValue in ipairs(secondArg) do
          if selectLoopItemValue.owner == "Safety" then
            locCandidate = selectLoopItemValue
            selectIsFalseaValue = true
            break
          end
