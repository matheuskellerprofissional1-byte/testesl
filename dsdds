  Settings.coinFarmSwitchReason = firstArg or "AFK Coin Farm started"
  Settings.coinFarmRetryAt = 0

  autoQuests = "AFK Coin Farm: preferred animal -> " .. coinFarmPreferredAnimal
end

function Settings.coinFarmSavannah(firstArg, ...)
  if not isNotJungleLife or not Settings.farmCoins or not firstArg or firstArg ~= localPlayer.Character then
    return false
  end

  local coinFarmPreferredAnimal = Settings.coinFarmPreferredAnimal
  local readyAnimalName = firstArg:GetAttribute("AnimalName")

  if type(coinFarmPreferredAnimal) ~= "string" or coinFarmPreferredAnimal == ""
    or type(readyAnimalName) ~= "string" or not Settings.questAnimalKey
    or Settings.questAnimalKey(readyAnimalName) == Settings.questAnimalKey(coinFarmPreferredAnimal) then
    return false
  end

  local questgroupProperty = Settings.questGroup and Settings.questGroup.coop

  if questgroupProperty and (questgroupProperty.helperActive or questgroupProperty.helperSwitching) then
    return false
  end

  local readyAttribute = tonumber(firstArg:GetAttribute("Food")) or 0
  local readyWaterAttribute = tonumber(firstArg:GetAttribute("Water")) or 0

  if readyAttribute < 92 or readyWaterAttribute < 70 then
    return false
  end

  if (safeMoveOff or recoveryBlocked and handleSurvivalUpper()) and readyAttribute < 99.5 then
    return false
  end

  local safeMoveYield = Settings.safeMove

  if safeMoveYield and safeMoveYield.active and safeMoveYield.reason ~= "foodPercent" then
    return false
  end

  local readySurvivalTransaction = Settings.activeAuthoritativeSurvival()
  local movementManagerQuery = Settings.MMBAI and Settings.MMBAI.MovementManager
  local readyLocalValue = movementManagerQuery and movementManagerQuery.lease

  if readyLocalValue and readyLocalValue.owner ~= "Food" and readyLocalValue.owner ~= "Slots"
    and readyLocalValue.owner ~= "AFkCoins" then
    return false
  end

  if Settings.busy
    and not (safeMoveYield and safeMoveYield.active and safeMoveYield.reason == "foodPercent" or readySurvivalTransaction == "Food"
      or carcassBlocked or safeMoveOff or not (safeMoveYield and safeMoveYield.active) and not readyLocalValue) then
    return false
  end

  return true
end

function Settings.coinFarmTryPreferredSwitch(...)
  if Settings.questGroup and Settings.questGroup.coop
    and (Settings.questGroup.coop.helperActive or Settings.questGroup.coop.helperSwitching) then
    return
  end

  if not Settings.farmCoins or not Settings.coinFarmSwitchPending or Settings.coinFarmSwitching
    or tick() < (Settings.coinFarmRetryAt or 0) then
    return
  end

  local coinFarmPreferredAnimalConfig = Settings.coinFarmPreferredAnimal

  if type(coinFarmPreferredAnimalConfig) ~= "string" or coinFarmPreferredAnimalConfig == "" then
    Settings.coinFarmSwitchPending = false
    return
  end

  local characterForValue = localPlayer.Character
  local switchAnimalName = characterForValue and characterForValue:GetAttribute("AnimalName")

  if type(switchAnimalName) == "string"
    and Settings.questAnimalKey(switchAnimalName) == Settings.questAnimalKey(coinFarmPreferredAnimalConfig) then
    Settings.coinFarmSwitchPending = false
    Settings.coinFarmSwitchReason = nil

    autoQuests = "AFK Coin Farm: " .. coinFarmPreferredAnimalConfig .. " selected"
    strLitInf = "AFK Coin preferred animal already active: " .. coinFarmPreferredAnimalConfig
    return
  end

  local handoffReady = Settings.coinFarmSavannah(characterForValue)

  if Settings.growthBusy or Settings.busy and not handoffReady or isFalseInglobal1 or localGlobal or mmbaiConfig.active
    or Settings.questGrowthReset.exclusive or Settings.questGrowthReset.busy or noCarcassAvailable
    or carcassBlocked and not handoffReady or safeMoveOff and not handoffReady or targetManager.busy or targetClearModule.busy or animalNameResolver.approachBusy
    or postureInvalid then
    return
  end

  local coinFarmFind = Settings.coinFarmFindPreferredSlot(utilityHelper(), coinFarmPreferredAnimalConfig)

  if coinFarmFind then
    Settings.coinFarmLastPreferredTarget = {
      entry = coinFarmFind,
      animalKey = Settings.questAnimalKey(coinFarmPreferredAnimalConfig),
      selectedAt = tick(),
    }
  else
    local coinFarmLastPreferredTarget = Settings.coinFarmLastPreferredTarget

    if Settings.slotSwitchMenuVisible() and coinFarmLastPreferredTarget
      and coinFarmLastPreferredTarget.animalKey == Settings.questAnimalKey(coinFarmPreferredAnimalConfig)
      and tick() - coinFarmLastPreferredTarget.selectedAt <= 90 then
      coinFarmFind = coinFarmLastPreferredTarget.entry
    end
  end

  if not coinFarmFind then
    Settings.coinFarmPreferredAnimal = nil
    Settings.coinFarmSwitchPending = false
    Settings.coinFarmSwitchReason = nil

    strLitInf = "Selected AFK Coin animal no longer has a saved slot; keeping current animal"
    autoQuests = "AFK Coin Farm: Current animal (saved selection unavailable)"
    Settings.coinFarmRenderPreferred()
    return
  end

  Settings.coinFarmSwitching = true
  Settings.coinFarmSwitchPending = false
  Settings.coinFarmSwitchStartedAt = tick()

  local switchAutoEat = Settings.autoEat
  local switchAutoDrink = Settings.autoDrink

  Settings.autoEat = false
  Settings.autoDrink = false

  isFalseInf = false
  Settings.questSetWork(false)
  mmbaiConfig.cooldownUntil = math.max(mmbaiConfig.cooldownUntil or 0, tick() + 20)
  strLitInf = "AFK Coin Farm: switching to preferred animal " .. coinFarmPreferredAnimalConfig
  autoQuests = "AFK Coin Farm: switching -> " .. coinFarmPreferredAnimalConfig

  task.spawn(function(...)
    local switchSavedSlotWith, switchWithStaging = Settings.switchSavedSlotWithStaging(
      coinFarmFind, "AFK Coin: staging current animal before preferred-slot switch"
    )

    if not switchSavedSlotWith then
      Settings.coinFarmSwitching = false
      Settings.coinFarmSwitchStartedAt = 0
      Settings.coinFarmSwitchPending = true
      Settings.coinFarmRetryAt = tick() + 3
      Settings.autoEat = switchAutoEat
      Settings.autoDrink = switchAutoDrink

      strLitInf = "AFK Coin switch postponed: " .. tostring(switchWithStaging)
      return
    end

    Settings.coinFarmSwitching = false
    Settings.coinFarmSwitchStartedAt = 0
    Settings.coinFarmLastPreferredTarget = nil

    if Settings.farmCoins then
      Settings.applySurvivalDefaults(false)
    else
      Settings.autoEat = switchAutoEat
      Settings.autoDrink = switchAutoDrink
    end

    if slotGrowthConfig then
      if slotGrowthConfig.autoEat then
        slotGrowthConfig.autoEat()
      end

      if slotGrowthConfig.autoDrink then
        slotGrowthConfig.autoDrink()
      end
    end

    if switchSavedSlotWith then
      if Settings.farmCoins then
        Settings.coinFarmRememberCurrentSlot()
      end

      if Settings.farmCoins
        and type(Settings.coinFarmPreferredAnimal) == "string"
        and Settings.questAnimalKey(Settings.coinFarmPreferredAnimal)
          ~= Settings.questAnimalKey(coinFarmPreferredAnimalConfig) then
        Settings.coinFarmSwitchPending = true
        Settings.coinFarmRetryAt = tick() + 1
        strLitInf = "AFK Coin animal selection changed; applying new preference"
      else
        Settings.coinFarmSwitchPending = false
        autoQuests = "AFK Coin Farm: " .. coinFarmPreferredAnimalConfig
        strLitInf = "AFK Coin preferred animal active: " .. coinFarmPreferredAnimalConfig
      end
    elseif Settings.farmCoins then
      Settings.coinFarmSwitchPending = true
      Settings.coinFarmRetryAt = tick() + 10
      strLitInf = "AFK Coin preferred animal spawn was not confirmed; retrying later"
    end
  end)
end

function Settings.growthPrideReturnStep(...)
  if Settings.slotParkingAudit and Settings.slotParkingAudit.active then
    return
  end

  local groupHealthStep, localPositionGrowth = handleChar()

  if not groupHealthStep or not localPositionGrowth then
    return
  end

  if not Settings.growthPrideRestrictionActive(groupHealthStep) then
    Settings.growthPrideReturn2("Pride restriction released", groupHealthStep)

    if Settings.growthPrideWater(groupHealthStep) then
      Settings.growthPrideClearWaterExcursion("Pride restriction released")
    end

    if Settings.survivalPromotePost and Settings.survivalPromotePost(
      groupHealthStep, "Post-Drink return released from Pride restriction"
    ) then
      return
    end

    if Settings.growthPride.returning and Settings.safeMove and Settings.safeMove.active
      and Settings.safeMove.reason == "growth_home" then
      Settings.safeMove.cancelToken = Settings.safeMove.cancelToken + 1
      Settings.releaseMovementNow(groupHealthStep, true)
    end

    Settings.growthPride.returning = false
    Settings.growthPride.returnRequested = false

    return
  end

  local stepFoodAttribute = tonumber(groupHealthStep:GetAttribute("Food")) or 100

  if stepFoodAttribute >= 92 and not Settings.growthPrideInside(groupHealthStep, localPositionGrowth) then
    Settings.growthPrideReturnFoodGraceArm(groupHealthStep, "Growth return ready after Food")
  end

  local graceActive = Settings.growthPrideReturn(groupHealthStep, stepFoodAttribute)
  local stepSurvivalTransaction = Settings.activeAuthoritativeSurvival()

  if graceActive and stepSurvivalTransaction == "Food" and stepFoodAttribute >= 80 then
    Settings.growthFoodRefillClear("Pride return suppressed comfortable Food owner", groupHealthStep)
    carcassBlocked = false
    respawnLocation = nil
    nilRefInf = nil
    abortReference = nil
    Settings.survivalArbiterComplete("foodPercent")
    stepSurvivalTransaction = Settings.activeAuthoritativeSurvival()
  end

  if stepSurvivalTransaction or Settings.survivalSuspendedFoodValid(groupHealthStep) or Settings.growthFoodRefillCanOwnMovement(groupHealthStep) then
    return
  end

  local growthPrideWaterexcursion = Settings.growthPride.waterExcursion

  local conditionalResultEleven = growthPrideWaterexcursion and growthPrideWaterexcursion.active == true
    and growthPrideWaterexcursion.character == groupHealthStep

  if growthPrideWaterexcursion and growthPrideWaterexcursion.active and growthPrideWaterexcursion.character ~= groupHealthStep then
    Settings.growthPrideClearWaterExcursion("character_changed")
    conditionalResultEleven = false
  end

  local function survivalHandleSurvival(firstArg, secondArg, ...)
    if Settings.growthPridePositionInsideZone(
      secondArg.Position, tonumber(Settings.growthPride.zoneMargin) or 7
    ) == true then
      return true
    end

    local conditionInfaMore, localInfeNext = Settings.growthPrideLiveZoneStatus(firstArg, secondArg)
    return conditionInfaMore == true and localInfeNext == "recent_confirmed_fallback"
  end

  if conditionalResultEleven and Settings.growthPridePositionInsideZone(
    localPositionGrowth.Position, tonumber(Settings.growthPride.zoneMargin) or 7
  ) == true then
    Settings.growthPrideClearWaterExcursion("physical Pride zone reached")
    conditionalResultEleven = false
  end

  if not conditionalResultEleven and survivalHandleSurvival(groupHealthStep, localPositionGrowth) then
    Settings.growthPride.returning = false
    Settings.growthPride.returnRequested = false
    Settings.growthPrideReturn2("Pride zone confirmed", groupHealthStep)

    if Settings.survivalPromotePost
      and Settings.survivalPromotePost(groupHealthStep, "Post-Drink Pride respawnLocation confirmed") then
      return
    end

    return
  end

  local foodV3 = tonumber(groupHealthStep:GetAttribute("Food")) or 100
  local waterV3 = tonumber(groupHealthStep:GetAttribute("Water")) or 100
  local isTargetReachable = Settings.survivalArbiterChoose(foodV3, waterV3)

  if Settings.autoEat and foodV3 < 80 and isTargetReachable == "foodPercent" then
    Settings.survivalPriorityTakeover("foodPercent", groupHealthStep, "Growth yielded: Food <80")

    helper(function(...)
      if localPlayer.Character == groupHealthStep and Settings.autoEat then
        pcall(handleSurvivalFinal)
      end
    end)

    return
  end

  local handlerActive4 = noCarcassAvailable or Settings.drinkTest and Settings.drinkTest.active or postureInvalid
    or Settings.drinkTransactionProtected and Settings.drinkTransactionProtected(groupHealthStep)

  if Settings.autoDrink and isTargetReachable == "waterPercent" and (waterV3 < 70 or handlerActive4) then
    if waterV3 < 70 then
      Settings.survivalPriorityTakeover("waterPercent", groupHealthStep, "Growth yielded: Water <70")
    end

    return
  end

  if handlerActive4 or localGlobal or mmbaiConfig.active or Settings.questGrowthReset.exclusive
    or Settings.questSlots and Settings.questSlots.busy or Settings.growthTopUp and Settings.growthTopUp.active
    or Settings.slotSwitchStagingActive == true or isFalseInglobal1 then
    return
  end

  if Settings.autoQuests
    and Settings.questMovementPriorityVerified == true
    and Settings.questMovementPriorityPending ~= true
    and (Settings.questPhysicalLocomotionActive()
      or Settings.MMBAI and Settings.MMBAI.Authority and Settings.MMBAI.Authority.currentOwner == "Quest")
    and Settings.carcassQuestRelease then
    pcall(Settings.carcassQuestRelease)
  end

  if Settings.safeMove
    and Settings.safeMove.active
    and (Settings.safeMove.reason == "foodPercent" or Settings.safeMove.reason == "waterPercent"
      or Settings.safeMove.reason == "water_search") then
    Settings.safeMove.cancelToken = Settings.safeMove.cancelToken + 1
    Settings.safeMove.active = false
    Settings.safeMove.target = nil
    Settings.safeMove.reason = nil
    Settings.busy = false
    Settings.releaseMovementNow(groupHealthStep, true)
  end

  if Settings.busy or Settings.growthPride.returning or tick() - (Settings.growthPride.lastReturnAt or 0) < 0.8 then
    return
  end

  local false = false
  local anchor

  if conditionalResultEleven and typeof(growthPrideWaterexcursion.anchor) == "Vector3" then
    anchor = growthPrideWaterexcursion.anchor
  else
    anchor = Settings.growthPrideNearestZonePoint(localPositionGrowth.Position, groupHealthStep)

    if typeof(anchor) ~= "Vector3" then
      local isTargetReachable = Settings.growthPrideSpawnReference()

      local vectorhQuery = isTargetReachable and Vector3.new(
        isTargetReachable.Position.X - localPositionGrowth.Position.X, 0, isTargetReachable.Position.Z - localPositionGrowth.Position.Z
      ) or Vector3.zero

      local distance = math.min(70, math.max(0, vectorhQuery.Magnitude - 35))

      if vectorhQuery.Magnitude > 0.05 and distance >= 8 then
        local dataTableOther = { 0, 20, -20, 40, -40, 65, -65 }
        local numValTemp = tonumber(Settings.growthPride.targetRetryPhase) or 0

        for icTarget = 0, #dataTableOther - 1 do
          local val = math.rad(dataTableOther[(numValTemp + icTarget) % #dataTableOther + 1])

          local vectorhRef = Vector3.new(vectorhQuery.Unit.X * math.cos(val)
            - vectorhQuery.Unit.Z * math.sin(val), 0, vectorhQuery.Unit.X * math.sin(val)
            + vectorhQuery.Unit.Z * math.cos(val))

          for idx, loopItemInfcV2 in ipairs({ 1, 0.7, 0.4 }) do
            local respawnLocation = localPositionGrowth.Position + vectorhRef * (distance * loopItemInfcV2)

            local raycastbOther = workspace:Raycast(Vector3.new(
              respawnLocation.X, math.max(localPositionGrowth.Position.Y + 120, 200), respawnLocation.Z
            ), Vector3.new(0, -400, 0), raycastParamsInglobal1)

            local probeThreshold = raycastbOther and raycastbOther.Material ~= Enum.Material.Water
                and raycastbOther.Position + Vector3.new(0, 3, 0)
              or nil

            if probeThreshold and not Settings.movementPrideRock(probeThreshold, groupHealthStep, 3)
              and not Settings.movementSavannahNoGoRegionAt(probeThreshold, 6)
              and not Settings.savannahCanyonPointInsideZone(probeThreshold, 10) then
              anchor = probeThreshold
              false = true
              break
            end
          end

          if anchor then
            break
          end
        end
      end
    end
  end

  if typeof(anchor) ~= "Vector3" then
    Settings.growthPride.targetRetryPhase = ((tonumber(Settings.growthPride.targetRetryPhase) or 0) + 1)
      % 7

    Settings.growthPride.returnRequested = true

    strLitInf = "Growth: no safe Pride approach found; replanning"
    return
  end

  Settings.growthPride.targetRetryPhase = 0
  Settings.growthPride.returning = true
  Settings.growthPride.returnRequested = false
  Settings.growthPride.lastReturnAt = tick()
  Settings.growthPride.lastReturnTarget = anchor

  Settings.growthPride.lastReturnTargetKind = conditionalResultEleven and "water_excursion"
    or false and "bootstrap_steering" or "canonical_zone"

  Settings.growthPride.lastReturnRequestedAt = tick()
  Settings.growthPride.lastReturnAdmittedAt = nil
  Settings.growthPride.lastReturnAdmitted = false
  Settings.growthPride.lastReturnMoveResult = nil
  Settings.growthPride.lastReturnFailure = nil

  strLitInf = Settings.growthPrideReturn(groupHealthStep, foodV3) and string.format(
    "Growth: returning to Pride Rock; Food %d%% (80%% tolerance, waterPercent transit protected)",
    math.floor(foodV3)
  ) or conditionalResultEleven and "Growth: stored Pride anchor selected" or false and "Growth: Pride bootstrap target selected" or "Growth: safe Pride zone target selected"

  task.spawn(function(...)
    local isTargetReachable = isPositionReachable(anchor, 10, nil, {
      purpose = "growth_home",
      forceMoveToLand = true,
      allowWaterTransit = true,
      waterTransitKind = "growth_pride_return",
      tolerance = false and 8 or 16,
      speedScale = 1,
      maxDuration = 180,
      routeCheckInterval = 0.2,
      routeCheck = function(...)
        local survivalTargetAlive, isTargetReachable = handleChar()

        if survivalTargetAlive ~= groupHealthStep or not isTargetReachable then
          return true, "growth_character_changed"
        end

        local foodLevel14 = tonumber(survivalTargetAlive:GetAttribute("Food")) or 100
        local waterPercent = tonumber(survivalTargetAlive:GetAttribute("Water")) or 100
        local isTargetReachable = Settings.growthPrideReturn(survivalTargetAlive, foodLevel14)
        local isTargetReachable = Settings.activeAuthoritativeSurvival()

        if isTargetReachable and not (isTargetReachable and isTargetReachable == "Food" and foodLevel14 >= 80)
          or Settings.growthFoodRefillCanOwnMovement(survivalTargetAlive, foodLevel14) then
          return true, "growth_survival_transaction"
        end

        if not Settings.growthPrideRestrictionActive(survivalTargetAlive) then
          return true, "growth_pride_released"
        end

        if Settings.growthPrideWater(survivalTargetAlive) then
          local isTargetReachable = Settings.growthPridePositionInsideZone(
            isTargetReachable.Position, tonumber(Settings.growthPride.zoneMargin) or 7
          ) == true

          local survivalAnchorProperty = Settings.growthPride.waterExcursion.anchor

          if isTargetReachable
            or typeof(survivalAnchorProperty) == "Vector3"
              and Vector3.new(isTargetReachable.Position.X - survivalAnchorProperty.X, 0, isTargetReachable.Position.Z - survivalAnchorProperty.Z).Magnitude
                <= 18 then
            return true, "pride_water_excursion_returned"
          end
        elseif survivalHandleSurvival(survivalTargetAlive, isTargetReachable) then
          return true, "pride_zone_entered"
        end

        local survivalArbiterChooseConfig2 = Settings.survivalArbiterChoose(foodLevel14, waterPercent)

        if Settings.autoEat and foodLevel14 < 80 and survivalArbiterChooseConfig2 == "foodPercent" then
          return true, "food_priority"
        end

        if Settings.autoDrink and waterPercent < 70 and survivalArbiterChooseConfig2 == "waterPercent" then
          return true, "water_priority"
        end

        return false
      end,
    })

    local constrainedValue21 = tonumber(Settings.growthPride.lastReturnAdmittedAt)
      and Settings.growthPride.lastReturnAdmittedAt >= Settings.growthPride.lastReturnRequestedAt

    local lastFailureReason = Settings.safeMove.lastFailureReason

    if constrainedValue21 then
      lastFailureReason = lastFailureReason or Settings.safeMove.routeInterruptReason
    end

    Settings.growthPride.lastReturnMoveResult = isTargetReachable
    Settings.growthPride.lastReturnAdmitted = constrainedValue21 == true
    Settings.growthPride.lastReturnFailure = not isTargetReachable and lastFailureReason or nil
    Settings.growthPride.lastReturnFinishedAt = tick()

    task.wait(0.1)
    local questTravelRefill, isTargetReachable = handleChar()
    Settings.growthPride.returning = false

    if lastFailureReason == "growth_pride_released" then
      Settings.growthPride.returnRequested = false
      Settings.growthPride.lastReturnFailure = nil
      return
    end

    local local = lastFailureReason == "pride_zone_entered"
      or lastFailureReason == "pride_water_excursion_returned"

    if not isTargetReachable and not local then
      Settings.growthPride.returnRequested = true

      if lastFailureReason == "growth_survival_transaction"
        or lastFailureReason == "food_priority" or lastFailureReason == "water_priority"
        or Settings.activeAuthoritativeSurvival()
        or questTravelRefill and Settings.growthFoodRefillCanOwnMovement(questTravelRefill) then
        strLitInf = "Growth return paused by Survival"
      elseif lastFailureReason == "growth_character_changed" then
        Settings.growthPride.lastReturnFailure = nil
      else
        if Settings.autoQuests
          and Settings.questMovementPriorityVerified == true
          and Settings.questMovementPriorityPending ~= true
          and (Settings.questPhysicalLocomotionActive()
            or Settings.MMBAI and Settings.MMBAI.Authority and Settings.MMBAI.Authority.currentOwner == "Quest")
          and Settings.carcassQuestRelease then
          pcall(Settings.carcassQuestRelease)
        end

        strLitInf = "Growth return blocked: "
          .. tostring(lastFailureReason or "movement route did not start or complete")
      end

      return
    end

    Settings.growthPride.lastReturnFailure = nil

    if questTravelRefill == groupHealthStep and isTargetReachable then
      local survivalIsFalse = false

      if Settings.growthPrideWater(questTravelRefill) then
        local localInf231V3 = Settings.growthPridePositionInsideZone(
          isTargetReachable.Position, tonumber(Settings.growthPride.zoneMargin) or 7
        ) == true

        local anchorProperty = Settings.growthPride.waterExcursion.anchor

        if localInf231V3
          or typeof(anchorProperty) == "Vector3"
            and Vector3.new(isTargetReachable.Position.X - anchorProperty.X, 0, isTargetReachable.Position.Z - anchorProperty.Z).Magnitude
              <= 20 then
          Settings.growthPrideClearWaterExcursion("return complete")
          survivalIsFalse = true
        end
      end

      local localInf231VSurvivalhandlesurvival = survivalHandleSurvival(questTravelRefill, isTargetReachable)

      if Settings.growthPrideWater(questTravelRefill) and not survivalIsFalse then
        Settings.growthPride.returnRequested = true
        strLitInf = "Growth: Pride reported, but returning to pre-Drink anchor before Food"
        return
      end

      if survivalIsFalse or localInf231VSurvivalhandlesurvival then
        Settings.growthPrideReturn2("Growth Pride return completed", questTravelRefill)

        if Settings.survivalPromotePost and Settings.survivalPromotePost(
          questTravelRefill,
          survivalIsFalse and "Returned to pre-Drink Pride anchor -> Food top-up" or "Pride zone confirmed after Drink -> Food top-up"
        ) then
          return
        end

        strLitInf = "Growth herbivore: Pride Rock zone confirmed"
      else
        Settings.growthPride.returnRequested = true
      end
    else
      Settings.growthPride.returnRequested = true
    end
  end)
end

