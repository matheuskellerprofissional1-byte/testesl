    function authorityRef.Enforce(firstArg, conditionBlackboardEnforce, ...)
      conditionBlackboardEnforce = conditionBlackboardEnforce or mmbaiAuthority.Blackboard

      if Settings.undergroundDrinkSupervisor
        and Settings.undergroundDrinkSupervisor(conditionBlackboardEnforce.character
          or localPlayer.Character) then
        firstArg:Elect(conditionBlackboardEnforce)
        return
      end

      if tick() - (firstArg.lastElectionAt or 0) > 0.03 then
        firstArg:Elect(conditionBlackboardEnforce)
      end

      if not mmbaiAuthority.MovementManager then
        return
      end

      local blackboardOwnersList = mmbaiAuthority.MovementManager:ActualOwners(conditionBlackboardEnforce)

      if #blackboardOwnersList > 1 then
        firstArg:ResolvePhysicalConflicts(conditionBlackboardEnforce, blackboardOwnersList)
      elseif #blackboardOwnersList == 1 then
        local enforcedOwner = blackboardOwnersList[1].owner
        local resultEnforce, enforceCriticalPreemption = firstArg:CriticalPreemption(firstArg.currentOwner, enforcedOwner, conditionBlackboardEnforce)

        if enforcedOwner ~= firstArg.currentOwner and resultEnforce then
          firstArg:RequestHandoff(
            enforcedOwner, firstArg.currentOwner, enforceCriticalPreemption or firstArg.currentReason, conditionBlackboardEnforce
          )
        end
      end

      firstArg:ClearHandoffIfReleased(conditionBlackboardEnforce)

      if firstArg.handoffFrom and tick() >= (firstArg.handoffForceAt or math.huge) then
        if firstArg:PhysicalOwner(conditionBlackboardEnforce) == firstArg.handoffFrom then
          mmbaiAuthority.MovementManager:CancelOwner(firstArg.handoffFrom, "Supervisor serialized handoff timeout -> "
            .. tostring(firstArg.handoffTo), true)

