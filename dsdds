          if type(animalStateActive.Disband) == "function" and tick() - Settings.questGroup.lastActionAt >= 4 then
            Settings.questGroup.lastActionAt = tick()
            pcall(animalStateActive.Disband)
            Settings.questGroup.statusText = "Grouping: moving to better " .. animalPlayerRef .. " pack"
          end

          return false
        elseif not currentPack and type(animalStateActive.RequestJoin) == "function"
          and tick() - Settings.questGroup.lastActionAt >= 4 then
          Settings.questGroup.lastActionAt = tick()
          Settings.questGroup.requestJoinIfFree(animalStateActive, serverPack.packId)

          Settings.questGroup.statusText = string.format(
            "Grouping: joining %s pack (%d animals)", animalPlayerRef, serverPack.count
          )

          return false
        end
      end

      if not serverPack.sameSpecies and secondArg and (serverPack.slot or serverPack.needsCreate) then
        if currentPack then
          if tick() - Settings.questGroup.lastActionAt >= 4 then
            Settings.questGroup.lastActionAt = tick()

            if Settings.questGroup.samePlayer(currentPack.Owner, localPlayer)
              and type(animalStateActive.Disband) == "function" then
              pcall(animalStateActive.Disband)
            elseif type(animalStateActive.Leave) == "function" then
              pcall(animalStateActive.Leave)
            end

            Settings.questGroup.pendingPackAnimal = serverPack.animalName
            Settings.questGroup.statusText = "Grouping: leaving pack before species switch"
          end

          return false
        end

        if serverPack.needsCreate and not serverPack.slot and not Settings.questSlots.busy and not isFalseInglobal1
          and not Settings.busy and not localGlobal then
          Settings.questGroup.pendingPackAnimal = serverPack.animalName

          Settings.questGroup.statusText = "Grouping: creating " .. serverPack.animalName
            .. " slot for server pack"

          strLitInf = "GroupTime: creating missing species in a free slot"

          if Settings.questSlots.creAnimal(nil, serverPack.animalName, firstArg) then
            return false
          end
        end

        if serverPack.slot and not isFalseInglobal1 and not Settings.busy and not localGlobal and tick() - numLitInf >= 8 then
          numLitInf = tick()
          isFalseInglobal1 = true
          isFalseInglobalA2 = false

          Settings.questTravelActive = false
          Settings.questGroup.pendingPackAnimal = serverPack.animalName

          strLitInf = string.format(
            "Grouping: switching to %s for bigger pack (%d)", serverPack.animalName, serverPack.count
          )

          task.spawn(function(...)
            local groupRequestAnimal, animalWithStaging = Settings.switchSavedSlotWithStaging(
              serverPack.slot, "Group quest: staging current animal before species switch"
            )

            if not groupRequestAnimal then
              isFalseInglobal1 = false
              strLitInf = "Group switch postponed: " .. tostring(animalWithStaging)
              return
            end

            isFalseInglobal1 = false
          end)

          return false
        end
      end
    end
  end

  if not currentPack then
    local groupRequestAnimal, bestPack3 = Settings.questGroup.findBestMMbPack(animalStateActive, firstArg, animalPlayerRef, false, true)

    if bestPack3 and groupRequestAnimal and not groupRequestAnimal.isOwn and type(animalStateActive.RequestJoin) == "function" then
      if tick() - Settings.questGroup.lastActionAt >= 2 then
        Settings.questGroup.lastActionAt = tick()
        Settings.questGroup.requestJoinIfFree(animalStateActive, groupRequestAnimal.packId)
      end

      Settings.questGroup.statusText = "KITTY co-op: joining " .. groupRequestAnimal.mmbName .. " · " .. animalPlayerRef
      return false
    end

    local groupRequestAnimal, animalOperationSuccess = pcall(animalStateActive.GetData)

    if groupRequestAnimal and type(animalOperationSuccess) == "table" then
      local animNumLitValue = -1
      local locaRequestAnimal

      for animLoopKey1, animLoopItem2 in pairs(animalOperationSuccess) do
        if type(animLoopItembValue) == "table" and Settings.questGroup.sameAnimal(animLoopItembValue.AnimalName, animalPlayerRef)
          and animLoopItembValue.Owner and not Settings.questGroup.samePlayer(animLoopItembValue.Owner, localPlayer)
          and animLoopItembValue.JoinRequirements == "AutoAccept" then
          local questGroupSetting2 = Settings.questGroup.memberCount(animLoopItembValue)

          if questGroupSetting2 > animNumLitValue then
            animNumLitValue = questGroupSetting2
            locaRequestAnimal = animLoopKeyaValue
          end
        end
      end

      if locaRequestAnimal ~= nil and type(animalStateActive.RequestJoin) == "function" then
        if tick() - Settings.questGroup.lastActionAt >= 5 then
          Settings.questGroup.lastActionAt = tick()
          Settings.questGroup.requestJoinIfFree(animalStateActive, locaRequestAnimal)
        end

        Settings.questGroup.statusText = string.format(
          "Grouping: joining biggest %s pack (%d animals)", animalPlayerRef, math.max(animNumLitValue, 1)
        )

        return false
      end
    end

    local animNumLit = 1.5 + localPlayer.UserId % 5 * 0.35

    if tick() - (Settings.questGroup.difficultySince or tick()) >= animNumLit then
      Settings.questGroup.tryCreateMMbPack(animalStateActive, animalPlayerRef)
    else
      Settings.questGroup.statusText = "Grouping: checking for existing " .. animalPlayerRef .. " MMB pack"
    end
  end

  return false
end

function Settings.questGroup.currentanimalAssistMMb(...)
  if tick() - (Settings.questGroup.lastMMbAssistAt or 0) < 3 then
    return false
  end

  Settings.questGroup.lastMMbAssistAt = tick()

  if Settings.questGrowthReset.exclusive or isFalseInglobal1 or Settings.busy or localGlobal or mmbaiConfig.active
    or Settings.coinFarmSwitching then
    return false
  end

  local questGroupResolvehandler2 = Settings.questGroup.resolveHandler()

  if not questGroupResolvehandler2 then
    return false
  end

  local playerAnimal = Settings.questGroup.getPlayerAnimal(localPlayer)

  if type(playerAnimal) ~= "string" or playerAnimal == "" then
    return false
  end

  local questGroupGetcurrentpack = Settings.questGroup.getCurrentPack(questGroupResolvehandler2)
  local groupRequestAnimal, groupRequestAnimal, animalInviteOpportunity = Settings.questGroup.hasCompatibleInviteOpportunity(questGroupResolvehandler2, playerAnimal)

  if not questGroupGetcurrentpack and groupRequestAnimal then
    local ifFree

    if animalInviteOpportunity == "autoaccept" then
      ifFree = Settings.questGroup.requestJoinIfFree(questGroupResolvehandler2, groupRequestAnimal)
    else
      ifFree = Settings.questGroup.acceptInviteIfFree(questGroupResolvehandler2, groupRequestAnimal)
    end

    if ifFree then
      Settings.questGroup.statusText = "KITTY helper: group membership verified"
      strLitInf = "KITTY co-op: compatible group join confirmed"
      return true
    end
  end

  if questGroupGetcurrentpack and not Settings.questGroup.sameAnimal(questGroupGetcurrentpack.AnimalName, playerAnimal) then
    return false
  end

  if questGroupGetcurrentpack and Settings.questGroup.hasOtherMember(questGroupGetcurrentpack) then
    return true
  end

  local groupRequestAnimal, animalBestPack = Settings.questGroup.findBestMMbPack(questGroupResolvehandler2, utilityHelper(), playerAnimal, false, true)

  if not groupRequestAnimal or not animalBestPack then
    return false
  end

  if questGroupGetcurrentpack and Settings.questGroup.samePackRecord(questGroupGetcurrentpack, groupRequestAnimal.pack) then
    if Settings.questGroup.samePlayer(questGroupGetcurrentpack.Owner, localPlayer)
      and questGroupGetcurrentpack.JoinRequirements ~= "AutoAccept"
      and type(questGroupResolvehandler2.SetJoinRequirements) == "function" then
      pcall(questGroupResolvehandler2.SetJoinRequirements, "AutoAccept")
    end

    return false
  end

  if questGroupGetcurrentpack then
    if tick() - Settings.questGroup.lastActionAt < 3 then
      return false
    end

    Settings.questGroup.lastActionAt = tick()

    if Settings.questGroup.samePlayer(questGroupGetcurrentpack.Owner, localPlayer) and type(questGroupResolvehandler2.Disband) == "function" then
      pcall(questGroupResolvehandler2.Disband)
    elseif type(questGroupResolvehandler2.Leave) == "function" then
      pcall(questGroupResolvehandler2.Leave)
    end

    Settings.questGroup.statusText = "KITTY helper: consolidating into " .. groupRequestAnimal.mmbName
    return false
  end

  if not groupRequestAnimal.isOwn and type(questGroupResolvehandler2.RequestJoin) == "function"
    and tick() - Settings.questGroup.lastActionAt >= 2 then
    Settings.questGroup.lastActionAt = tick()
    Settings.questGroup.requestJoinIfFree(questGroupResolvehandler2, groupRequestAnimal.packId)

    Settings.questGroup.statusText = "KITTY helper: joining " .. groupRequestAnimal.mmbName
      .. " to help another Hub account"

    strLitInf = "KITTY co-op: helping another script account's GroupTime"
    return true
  end

  return false
end

function Settings.questGroup.coopServerTime(...)
  local timeProgressValues, timeOperationSuccess = pcall(workspace.GetServerTimeNow, workspace)

  if timeProgressValues and type(timeOperationSuccess) == "number" then
    return timeOperationSuccess
  end

  return tick()
end

function Settings.questGroup.coopProbeState(...)
  local coop = Settings.questGroup.coop
  local stateBoundedValue = math.max(8, tonumber(coop.probePeriod) or 16)
  local constrainedValue30 = math.clamp(tonumber(coop.probeWindow) or 2.2, 1, stateBoundedValue - 2)
  local serverTime = Settings.questGroup.coopServerTime() % stateBoundedValue
  return serverTime < constrainedValue30, serverTime, stateBoundedValue, constrainedValue30
end

function Settings.questGroup.localHasActiveGroupTime(...)
  if GameConfig.name == "JungleLife" then
    return false
  end

  local timeProgressValues, time_getAllQuestsConfig = pcall(Settings._getAllQuests)

  if not timeProgressValues or type(time_getAllQuestsConfig) ~= "table" then
    return false
  end

  for hasLoopIdx, hasLoopItemValue in ipairs(time_getAllQuestsConfig) do
    if hasLoopItemValue.props and hasLoopItemValue.props.QuestType == "GroupTime"
      and not Settings.questGroup.questComplete(hasLoopItemValue) then
      return true
    end
  end

  return false
end

function Settings.questGroup.passiveGroupTimeWatchStep(firstArg, ...)
  if GameConfig.name == "JungleLife" then
    return false
  end

  if firstArg ~= true or Settings.autoQuests then
    return false
  end

  if tick() - (Settings.questGroup.passiveWatchAt or 0) < 1.5 then
    return false
  end

  Settings.questGroup.passiveWatchAt = tick()

  if Settings.questGroup.disabledFlag and tick() - (Settings.questGroup.lastCreateAttemptAt or 0) >= 10 then
    Settings.questGroup.disabledFlag = false
    Settings.questGroup.lastCreateAttemptAt = 0
    Settings.questGroup.createFailures = (Settings.questGroup.createFailures or 0) + 1
    Settings.questGroup.statusText = "KITTY co-op: stale group creation released; retrying"
  end

  if Settings.questGrowthReset.exclusive or isFalseInglobal1 or Settings.questGroup.coop.helperSwitching or localGlobal
    or mmbaiConfig.active or Settings.coinFarmSwitching then
    return false
  end

  if Settings.questGroup.coop.helperActive then
    Settings.questGroup.clearAFkHelperState()
  end

  local stepGroupc = utilityHelper()
  Settings.questGroup.currentAnimalEnsure(stepGroupc, false)

  if Settings.questGroup.refreshAvailability then
    Settings.questGroup.refreshAvailability(stepGroupc, false)
  end

  return true
end

function Settings.questGroup.findMMbPackByName(firstArg, secondArg, ...)
  if not firstArg or type(firstArg.GetData) ~= "function" or type(secondArg) ~= "string" or secondArg == "" then
    return nil, nil
  end

  local pcallResultName, nameOperationSuccess = pcall(firstArg.GetData)

  if not pcallResultName or type(nameOperationSuccess) ~= "table" then
    return nil, nil
  end

  for packLoopKey, packLoopItem in pairs(nameOperationSuccess) do
    local namePackName = Settings.questGroup.getMMbPackName(packLoopItem)

    if namePackName and namePackName:lower() == secondArg:lower() then
      return packLoopKey, packLoopItem
    end
  end

  return nil, nil
end

function Settings.questGroup.findSavedSlotByCharacterName(firstArg, secondArg, ...)
  if type(firstArg) ~= "table" or type(secondArg) ~= "string" or secondArg == "" then
    return nil
  end

  for charLoopIdx, charLoopItem in ipairs(firstArg) do
    if type(charLoopItem) == "table"
      and (charLoopItem.CharacterName == secondArg or charLoopItem.UniqueCharacterName == secondArg) then
      return charLoopItem
    end
  end
end

