function Settings.giraffeLeafVerticalFit(firstArg, secondArg, thirdArg, fourthArg, fifthArg, ...)
  if not firstArg or not firstArg:IsA("BasePart") or not thirdArg or not fourthArg then
    return false, nil
  end

  local fitTransformData = firstArg.Position.Y - firstArg.Size.Y * 0.5
  local fit5Property = firstArg.Position.Y + firstArg.Size.Y * 0.5
  local fitLocalValue = tonumber(fifthArg and fifthArg.bodyHeight) or 8
  local convertedNumber = tonumber(secondArg) or thirdArg + (fourthArg - thirdArg) * 0.62
  local constrainedValue23 = math.clamp(fitLocalValue * 0.16 + 0.65, 2.25, 4.75)
  local limitCalc11 = math.min(fourthArg, convertedNumber + constrainedValue23)

  if fitTransformData > limitCalc11 then
    return false, {
      reason = "too_high",
      lowestLeafYield = fitTransformData,
      highestLeafYield = fit5Property,
      practicalTopYield = limitCalc11,
      moutFit = convertedNumber,
    }
  end

  if fit5Property < thirdArg then
    return false, {
      reason = "too_low",
      lowestLeafYield = fitTransformData,
      highestLeafYield = fit5Property,
      practicalTopYield = limitCalc11,
      moutFit = convertedNumber,
    }
  end

  local leafMaxValue = math.max(fitTransformData, thirdArg)
  local limitValue28 = math.min(fit5Property, limitCalc11)
  local locFit = limitValue28 - leafMaxValue
  local leafSizeValue = math.clamp(firstArg.Size.Y * 0.075, 0.65, 1.65)

  if locFit < leafSizeValue then
    return false, {
      reason = "insufficient_vertical_overlap",
      lowestLeafYield = fitTransformData,
      highestLeafYield = fit5Property,
      practicalTopYield = limitCalc11,
      moutFit = convertedNumber,
      overlap = locFit,
      minimumOverlap = leafSizeValue,
    }
  end

  local constrainedValue24 = math.clamp(convertedNumber, leafMaxValue, limitValue28)

  return true, {
    reason = "ok",
    lowestLeafYield = fitTransformData,
    highestLeafYield = fit5Property,
    practicalTopYield = limitCalc11,
    moutFit = convertedNumber,
    inteFit = constrainedValue24,
    mouthGap = math.abs(constrainedValue24 - convertedNumber),
    overlap = locFit,
    minimumOverlap = leafSizeValue,
  }
end

local function helperYield(firstArg, secondArg, thirdArg, fourthArg, fifthArg, ...)
