    end

    return val
  end

  local vitalStatus = iterateItemsaMore(firstArg.entry)

  if type(vitalStatus) == "number" and type(questLocal5) == "number" then
    return vitalStatus, questLocal5, math.clamp(vitalStatus / questLocal5, 0, 1)
