function Settings.carcassPrideRockForbidden(firstArg, secondArg, characterCarcass2, ...)
  if not (isNotJungleLife or isDinoLifePlaceId or GameConfig.name == "JungleLife") then
    return false
  end

  characterCarcass2 = characterCarcass2 or localPlayer.Character

