          locaSlot5 = slotLoopItemcValue
        end
      else
        local convertedNumber = tonumber(slotLoopItemcValue.GrowthPercentage) or 0

        if convertedNumber <= 1 then
          convertedNumber = convertedNumber * 100
        end

        if convertedNumber > slotNumLit then
          slotNumLit = convertedNumber
          slotSlote = slotLoopItemcValue
        end
      end
    end
  end

  return locaSlot5 or slotSlote
end

function Settings.questGroup.findBestServerPack(firstArg, secondArg, thirdArg, fourthArg, ...)
