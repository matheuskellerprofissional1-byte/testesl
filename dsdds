          end

          localInfdNext = conditionSupervisorPermit

          mmbElephantTerrainHover.Position = Vector3.new(
            localInfdNext.Position.X, limitCalc7, localInfdNext.Position.Z
          )

          runService.Heartbeat:Wait()
        end

        local elephantHoverConfig2 = Settings.elephantHover

        if not elephantHoverConfig2 or elephantHoverConfig2.character ~= sixthCheckCondition or not elephantHoverConfig2.floor
          or not elephantHoverConfig2.floor.Parent or not elephantHoverConfig2.sole
          or not elephantHoverConfig2.sole.Parent then
