function Settings.questTravelStartGuardStep(...)
  if not (isNotJungleLife or isDinoLifePlaceId) or not Settings.autoQuests then
    Settings.questTravelStartGuardReset()
    return
  end

  local questTravelStartGuard = Settings.questTravelStartGuard
  local additionalTimestamp = tick()
  local groupHealthStep, localPositionQuest = handleChar()

  if not groupHealthStep or not localPositionQuest then
    Settings.questTravelStartGuardReset()
    return
  end

  if Settings.questSwimPendingNow and Settings.questSwimPendingNow() then
    if Settings.questStopLandAutoRun then
      Settings.questStopLandAutoRun("Swim has priority; Travel start watchdog yielded")
    end

    Settings.questTravelStartGuardReset()
    return
  end

  if questTravelStartGuard.noSwimSince == 0 then
    questTravelStartGuard.noSwimSince = additionalTimestamp
    return
  end

  if additionalTimestamp - questTravelStartGuard.noSwimSince < 1.35 then
    return
  end

  local questCount5 = 0
  local questCountQuesttravelstartguardstep2 = 0
  local travelIsFalseValue = false
  local travelEmptyTable = {}
  local travelIsFalse = false
  local stepCountQuesttravelstartguardstep2 = 0

  for travelLoopIdx, travelLoopItem in ipairs(Settings._getAllQuests()) do
    local conditionalResultUpsilon = travelLoopItem and travelLoopItem.props
    local stepQuestData = conditionalResultUpsilon and conditionalResultUpsilon.QuestData

    if conditionalResultUpsilon and conditionalResultUpsilon.QuestType == "TravelDistance" and not Settings._isSwimQuest(conditionalResultUpsilon)
      and not Settings.questGroup.questComplete(travelLoopItem) then
      local groupHealthStep, stepProgressValues = Settings.questProgressValues(travelLoopItem)

      if not (type(groupHealthStep) == "number" and type(stepProgressValues) == "number" and stepProgressValues > 0 and groupHealthStep >= stepProgressValues) then
        questCount5 = questCount5 + 1

        if stepQuestData and stepQuestData.ShouldBeSpawnedAsSpecificAnimalName then
          travelIsFalse = true
        else
          stepCountQuesttravelstartguardstep2 = stepCountQuesttravelstartguardstep2 + 1
        end

        local travelStrValue = tostring(travelLoopItem.entry and travelLoopItem.entry.QuestUniqueKey
          or conditionalResultUpsilon and conditionalResultUpsilon.Title or questCount5)

        if type(groupHealthStep) == "number" then
          questCountQuesttravelstartguardstep2 = questCountQuesttravelstartguardstep2 + 1
          travelEmptyTable[travelStrValue] = groupHealthStep
          local stepTravele = questTravelStartGuard.snapshots[travelStrValue]

          if type(stepTravele) == "number" and groupHealthStep > stepTravele + 0.001 then
            travelIsFalseValue = true
          end
        end
      end
    end
  end

  if questCount5 == 0 then
    Settings.questTravelStartGuardReset()
    return
  end

  if questTravelStartGuard.character ~= groupHealthStep then
    questTravelStartGuard.character = groupHealthStep
    questTravelStartGuard.seenAt = additionalTimestamp
    questTravelStartGuard.eligibleSince = 0
    questTravelStartGuard.lastPosition = localPositionQuest.Position
    questTravelStartGuard.lastPhysicalAt = additionalTimestamp
    questTravelStartGuard.lastQuestProgressAt = additionalTimestamp
    questTravelStartGuard.lastKickAt = 0
    questTravelStartGuard.kickCount = 0
    questTravelStartGuard.snapshots = {}
  end

  if typeof(questTravelStartGuard.lastPosition) == "Vector3" then
    if Vector3.new(
      localPositionQuest.Position.X - questTravelStartGuard.lastPosition.X, 0,
      localPositionQuest.Position.Z - questTravelStartGuard.lastPosition.Z
    ).Magnitude >= 0.9 then
      questTravelStartGuard.lastPhysicalAt = additionalTimestamp
      questTravelStartGuard.lastPosition = localPositionQuest.Position
    end
  else
    questTravelStartGuard.lastPosition = localPositionQuest.Position
    questTravelStartGuard.lastPhysicalAt = additionalTimestamp
  end

  if travelIsFalseValue then
    questTravelStartGuard.lastQuestProgressAt = additionalTimestamp
  end

  questTravelStartGuard.snapshots = travelEmptyTable
  questTravelStartGuard.lastActiveCount = questCount5
  questTravelStartGuard.lastReadableCount = questCountQuesttravelstartguardstep2

  local survivalTransaction2 = Settings.activeAuthoritativeSurvival()

  local questZonePriorityActive = Settings.questZonePriorityActive and Settings.questZonePriorityActive()
    and Settings.questZoneFarmReady ~= true

  local stepActive2 = Settings.herbivoreFoodRecovery and Settings.herbivoreFoodRecovery.active
    and Settings.herbivoreFoodRecovery.character == groupHealthStep

  local questSwimActive = Settings.questSwimActive
    or Settings.questPostSwimHandoff and Settings.questPostSwimHandoff.active
    or Settings.questGrowthReset.exclusive
    or isFalseInglobal1
    or Settings.questSlots and Settings.questSlots.busy
    or Settings.slotParkingAudit and Settings.slotParkingAudit.active
    or localGlobal
    or mmbaiConfig.active
    or postureInvalid
    or survivalTransaction2 ~= nil
    or noCarcassAvailable
    or carcassBlocked
    or Settings.questCarnivoreFeeding
    or Settings.questBaboonFeeding
    or Settings.questGiraffeFeeding
    or safeMoveOff
    or targetManager.busy
    or targetClearModule.busy
    or animalNameResolver.approachBusy
    or stepActive2
    or Settings.questTravelFullRefill and Settings.questTravelFullRefill.active
    or Settings.questNest and Settings.questNest.active
      and not (Settings.questNestTravelCircleActive and Settings.questNestTravelCircleActive(groupHealthStep))
    or questZonePriorityActive
    or Settings.safeMove and Settings.safeMove.active
    or Settings.busy
    or Settings.growthBusy

  if travelIsFalse and stepCountQuesttravelstartguardstep2 == 0 then
    questSwimActive = true
  end

  if questSwimActive then
    questTravelStartGuard.eligibleSince = 0
    questTravelStartGuard.kickCount = 0

    if Settings.questLandwWatch then
      Settings.questLandwWatch.resumePending = true
    end

    return
  end

  if questTravelStartGuard.eligibleSince == 0 then
    questTravelStartGuard.eligibleSince = additionalTimestamp
    questTravelStartGuard.lastPhysicalAt = additionalTimestamp

    questTravelStartGuard.lastQuestProgressAt = math.max(questTravelStartGuard.lastQuestProgressAt
      or 0, additionalTimestamp)

    if Settings.questLandwWatch then
      Settings.questLandwWatch.resumePending = true
    end

    Settings.questForceFastRecheckUntil = math.max(Settings.questForceFastRecheckUntil or 0, additionalTimestamp + 12)
    return
  end

  local questTravelActiveConfig = isFalseInglobalA2 == true and Settings.questTravelActive == true
    and Settings.questLandInputActive == true

  local lastphysicalatProperty = additionalTimestamp - (questTravelStartGuard.lastPhysicalAt or 0) <= 1.75
    or Vector3.new(localPositionQuest.AssemblyLinearVelocity.X, 0, localPositionQuest.AssemblyLinearVelocity.Z).Magnitude
      >= 0.75

  local lastquestprogressatProperty = additionalTimestamp - (questTravelStartGuard.lastQuestProgressAt or 0) <= 4

  local conditionalResultPhi = questCountQuesttravelstartguardstep2 > 0 and questTravelActiveConfig and lastphysicalatProperty
    and additionalTimestamp - (questTravelStartGuard.lastQuestProgressAt or additionalTimestamp) >= 10

  if lastphysicalatProperty then
    questTravelStartGuard.kickCount = 0

    if not questTravelActiveConfig and Settings.aiSupervisorCanDriveOwner("Quest") then
      isFalseInglobalA2 = true

      Settings.questTravelActive = true
      Settings.questLandInputActive = true
      Settings.questMoveSubState = Settings.questMoveSubState or "Running"

      if Settings.questLandwWatch then
        Settings.questLandwWatch.resumePending = false
      end
    end

    if conditionalResultPhi and additionalTimestamp - (questTravelStartGuard.lastKickAt or 0) >= 1.2 then
      questTravelStartGuard.lastKickAt = additionalTimestamp
      Settings.questForceFastRecheckUntil = math.max(Settings.questForceFastRecheckUntil or 0, additionalTimestamp + 15)
      pcall(utilityHelper, Settings.questMoveSubState or "Running")
      isFalseInf = false
      strLitInf = "Auto Travel progress check: objective flat; movement kept uninterrupted while movement state was reasserted"
    end

    return
  end

  if questTravelActiveConfig and lastquestprogressatProperty then
    questTravelStartGuard.kickCount = 0
    return
  end

  if additionalTimestamp - questTravelStartGuard.eligibleSince < 1.35
    or additionalTimestamp - (questTravelStartGuard.lastKickAt or 0) < 1.2 then
    return
  end

  questTravelStartGuard.lastKickAt = additionalTimestamp
  questTravelStartGuard.kickCount = questTravelStartGuard.kickCount + 1

  if Settings.questLandwWatch then
    Settings.questLandwWatch.resumePending = true
    Settings.questLandwWatch.replanRequested = true
    Settings.questLandwWatch.planReady = false
  end

  Settings.questForceFastRecheckUntil = math.max(Settings.questForceFastRecheckUntil or 0, additionalTimestamp + 15)
  local MMBAIConfig14 = Settings.MMBAI
  local authorityPrior = MMBAIConfig14 and MMBAIConfig14.Authority

  if authorityPrior then
    if authorityPrior.exclusive
      and (authorityPrior.currentOwner == "Food" or authorityPrior.currentOwner == "Water")
      and Settings.activeAuthoritativeSurvival() == nil
      and type(authorityPrior.SyncLegacySurvival) == "function" then
      pcall(authorityPrior.SyncLegacySurvival, authorityPrior, MMBAIConfig14.Blackboard)
    end

    if type(authorityPrior.Elect) == "function" then
      pcall(authorityPrior.Elect, authorityPrior, MMBAIConfig14.Blackboard)
    end
  end

  if MMBAIConfig14 and type(MMBAIConfig14.RequestWorker) == "function" then
    pcall(
      MMBAIConfig14.RequestWorker, MMBAIConfig14, "AutoQuests", "TravelDistance start/progress guard wake",
      0.01
    )
  end

  if Settings.aiSupervisorCanDriveOwner("Quest") and not (Settings.safeMove and Settings.safeMove.active) then
    isFalseInglobalA2 = true

    Settings.questTravelActive = true
    Settings.questLandInputActive = true
    Settings.questMoveSubState = Settings.questMoveSubState or "Running"
  end

  if conditionalResultPhi then
    pcall(utilityHelper, Settings.questMoveSubState or "Running")
    isFalseInf = false
  end

  if not lastphysicalatProperty and questTravelStartGuard.kickCount >= 2 and Settings.questLandwWatch
    and Settings.questLandwWatch.planReady == true and Settings.questLandPermanentwAllowed
    and Settings.questLandPermanentwAllowed() and Settings.questLandPermanentw
    and Settings.questLandPermanentw(groupHealthStep, 0.75)
    and not (Settings.safeMove and Settings.safeMove.active) then
    pcall(Settings.questHardRefreshWork, conditionalResultPhi
        and "Auto Travel progress guard: moving but objective stayed flat; movement state/W refreshed"
      or "Auto Travel start guard: live quest had no physical start; W/controller refreshed", false)
  end

  if Settings.questLandwWatchStep then
    pcall(Settings.questLandwWatchStep)
  end

  strLitInf = conditionalResultPhi
      and "Auto Travel progress check: animal moved but quest value stayed flat; existing movement state/controller revalidated"
    or questTravelStartGuard.kickCount >= 2
      and "Auto Travel liveness: quest exists but had no physical start; existing controller refreshed"
    or "Auto Travel liveness: quest detected; existing Auto Run start requested"
end

function Settings.questIsProgressingNow(firstArg, secondArg, thirdArg, fourthArg, fifthArg, sixthArg, ...)
  if not Settings.autoQuests or type(firstArg) ~= "table" or type(firstArg.props) ~= "table" then
    return false
  end

  if Settings._isSwimQuest(firstArg.props) then
    if not Settings.questSwimQuestIncomplete(firstArg) then
      return false
    end
  elseif Settings.questGroup.questComplete(firstArg) then
    return false
  end

  local nowLocalValue = firstArg.props
  local nowQuestData = nowLocalValue.QuestData or {}
  local nowQuestType = nowLocalValue.QuestType

  if nowQuestType == "PlayTime" then
    if not nowQuestData.ShouldBeSpawnedAsAnimal then
      return true
    end

    if nowQuestData.ShouldBeSpawnedAsSpecificAnimalName then
      local nowIsh = questHandleQuest(firstArg, secondArg)

      return type(nowIsh) == "string" and type(fourthArg) == "string"
        and nowIsh:lower() == fourthArg:lower()
    end

    return thirdArg ~= nil and type(fourthArg) == "string" and fourthArg ~= ""
  end

  if Settings.questIsGrowthQuest(firstArg) then
    if not thirdArg then
      return false
    end

    local nowSavedEntry = Settings.questFindCurrentSavedEntry(secondArg, thirdArg)
    local growthPercentage = nowSavedEntry and nowSavedEntry.GrowthPercentage

    if growthPercentage == nil then
      growthPercentage = thirdArg:GetAttribute("GrowthPercentage")
    end

    return type(growthPercentage) == "number" and not isGrowthComplete(growthPercentage)
  end

  if nowQuestType == "ZoneTime" then
    if type(fifthArg) ~= "string" or fifthArg == "" then
      return false
    end

    local now = Settings.findQuestZone(firstArg)
    return type(now) == "string" and now:lower() == fifthArg:lower()
  end

  if isDinoLifePlaceId and nowQuestType == "NestTime" then
    if not Settings.questNest or not Settings.questNest.active or not Settings.questNest.targetNest
      or not Settings.questNest.targetNest.Parent or not thirdArg then
      return false
    end

    local nowRootPart = thirdArg:FindFirstChild("HumanoidRootPart")
    local modelPosition = Settings.questNestModelPosition(Settings.questNest.targetNest)

    if not nowRootPart or typeof(modelPosition) ~= "Vector3" then
      return false
    end

    return Vector3.new(
      nowRootPart.Position.X - modelPosition.X, 0, nowRootPart.Position.Z - modelPosition.Z
    ).Magnitude <= 20
  end

  if nowQuestType == "GroupTime" then
    return sixthArg ~= nil and Settings.questGroup.hasOtherMember(sixthArg)
  end

  if nowQuestType == "TravelDistance" then
    if not Settings.questMotionMoving then
      return false
    end

    if Settings._isSwimQuest(nowLocalValue) then
      return Settings.questMotionMode == "Swimming"
    end

    if Settings._isLandDistanceQuest(nowLocalValue) then
      return Settings.questMotionMode == "Land"
    end

    return Settings.questMotionMode == "Land" or Settings.questMotionMode == "Swimming"
  end

  return false
end

