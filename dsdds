    function authorityRef.ResolvePhysicalConflicts(firstArg, conditionBlackboardConflicts, thirdArg, ...)
      conditionBlackboardConflicts = conditionBlackboardConflicts or mmbaiAuthority.Blackboard
      thirdArg = type(thirdArg) == "table" and thirdArg or {}

      if #thirdArg <= 1 then
        firstArg:ClearHandoffIfReleased(conditionBlackboardConflicts)
        return thirdArg[1] and thirdArg[1].owner or nil
      end

      firstArg:Elect(conditionBlackboardConflicts)
      local conflictsCurrentOwner = firstArg.currentOwner ~= "None" and firstArg.currentOwner or nil

      local conflictsMovementmanagerValue = mmbaiAuthority.MovementManager and mmbaiAuthority.MovementManager.lease
          and mmbaiAuthority.MovementManager.lease.owner
        or nil

      if conflictsMovementmanagerValue
        and firstArg:OwnerStillValid(conflictsMovementmanagerValue, conditionBlackboardConflicts)
        and (not conflictsCurrentOwner
          or not firstArg:CriticalPreemption(conflictsCurrentOwner, conflictsMovementmanagerValue, conditionBlackboardConflicts)) then
        conflictsCurrentOwner = conflictsMovementmanagerValue
      end

      conflictsCurrentOwner = conflictsCurrentOwner or thirdArg[1] and thirdArg[1].owner
      local conflictsCurrentTimestamp = tick()

      for resolveLoopIdx, resolveLoopItem in ipairs(thirdArg) do
        local conflictsOwnerValue = resolveLoopItem.owner

        if conflictsOwnerValue and conflictsOwnerValue ~= conflictsCurrentOwner then
          local resultConflicts, conflictsCriticalPreemption = firstArg:CriticalPreemption(conflictsCurrentOwner, conflictsOwnerValue, conditionBlackboardConflicts)

          if resultConflicts or conflictsOwnerValue ~= conflictsMovementmanagerValue
            or firstArg:PhysicalProgressAge(conflictsOwnerValue, conditionBlackboardConflicts) > 4.5 then
            firstArg:RequestHandoff(
              conflictsOwnerValue, conflictsCurrentOwner, conflictsCriticalPreemption or "two physical controllers detected", conditionBlackboardConflicts
            )
          end
        end
      end

      if firstArg.handoffFrom and conflictsCurrentTimestamp >= (firstArg.handoffForceAt or math.huge) then
        if firstArg:PhysicalOwner(conditionBlackboardConflicts) == firstArg.handoffFrom then
          mmbaiAuthority.MovementManager:CancelOwner(firstArg.handoffFrom, "Supervisor handoff timeout -> "
            .. tostring(firstArg.handoffTo), true)

          firstArg.handoffForceAt = conflictsCurrentTimestamp + 2
        end
      end

      firstArg.lastConflictResolutionAt = conflictsCurrentTimestamp
      return conflictsCurrentOwner
    end

    function authorityRef.SafetyHazard(firstArg, hazardCheckResult, ...)
      hazardCheckResult = hazardCheckResult or mmbaiAuthority.Blackboard
      local charactergOther = hazardCheckResult.character or localPlayer.Character

      if Settings.undergroundDrinkSupervisor
        and Settings.undergroundDrinkSupervisor(charactergOther) then
