function Settings.dinoCarnivoreWater(firstArg, ...)
  local stalledSurvivalLiveness = Settings.carnivoreSurvivalLiveness

  if not isDinoLifePlaceId or not Settings.autoDrink or not firstArg or firstArg ~= localPlayer.Character
    or not isValidQuestTarget(firstArg) or not stalledSurvivalLiveness
    or stalledSurvivalLiveness.character ~= firstArg
    or (tonumber(firstArg:GetAttribute("Water")) or 100) >= 70 then
    return false
  end

  if not (Settings.safeMove and Settings.safeMove.active
    and (Settings.safeMove.reason == "waterPercent" or Settings.safeMove.reason == "water_search")) then
    return false
  end

  local stalledDietType = tonumber(Settings.safeMove.startedAt) or 0

  if stalledDietType <= 0 then
    return false
  end

  local stalledBoundedValue = math.max(
    stalledDietType, tonumber(stalledSurvivalLiveness.lastWaterProgressAt) or 0,
    tonumber(stalledSurvivalLiveness.lastWaterApproachAt) or 0
  )

  return stalledBoundedValue > 0 and tick() - stalledBoundedValue >= 8
end

