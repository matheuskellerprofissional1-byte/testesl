        if checkConditionaRef(refLoopKey) or checkConditionaRef(refLoopItem) then
          return true
        end
      end
    end
  end

  return false
end

function Settings.questGroup.requestJoinIfFree(firstArg, secondArg, ...)
  if not firstArg or type(firstArg.RequestJoin) ~= "function" or secondArg == nil then
    return false, "unavailable"
  end

  if Settings.questGroup.getPlayerMMbTeamName(localPlayer) then
    return false, "already_grouped_team"
  end

  if Settings.questGroup.getPlayerPack(firstArg, localPlayer) then
    return false, "already_grouped"
  end

  Settings.questGroup.joinVerifyTargetId = secondArg
  Settings.questGroup.joinVerifyStartedAt = tick()
  Settings.questGroup.joinVerifyResult = "request_sent"

  local pcallResultFree, freeOperationSuccess = pcall(firstArg.RequestJoin, secondArg)

  if not pcallResultFree or freeOperationSuccess == false then
    pcallResultFree, freeOperationSuccess = pcall(firstArg.RequestJoin, firstArg, secondArg)
  end

  if not pcallResultFree or freeOperationSuccess == false then
    Settings.questGroup.joinVerifyResult = "request_failed"
    return false, "request_failed"
  end

  local freeMembershipConfirmation = Settings.questGroup.membershipConfirmWait(firstArg, secondArg, 1.25)
  return freeMembershipConfirmation, freeMembershipConfirmation and "joined_confirmed" or "request_unconfirmed"
end

function Settings.questGroup.acceptInviteIfFree(firstArg, secondArg, ...)
  if not firstArg or type(firstArg.AcceptInvite) ~= "function" then
    return false, "unavailable"
  end

  if Settings.questGroup.getPlayerMMbTeamName(localPlayer) then
    return false, "already_grouped_team"
  end

  if Settings.questGroup.getPlayerPack(firstArg, localPlayer) then
    return false, "already_grouped"
  end

  if tick() - (Settings.questGroup.lastInviteAcceptAt or 0) < 1.15 then
    return false, "cooldown"
  end

  Settings.questGroup.lastInviteAcceptAt = tick()
  Settings.questGroup.joinVerifyTargetId = secondArg
  Settings.questGroup.joinVerifyStartedAt = tick()
  Settings.questGroup.joinVerifyResult = "accept_sent"

  local flagState3 = false
  local operationSuccessEleven

  if secondArg ~= nil then
    flagState3, operationSuccessEleven = pcall(firstArg.AcceptInvite, secondArg)

    if not flagState3 or operationSuccessEleven == false then
      flagState3, operationSuccessEleven = pcall(firstArg.AcceptInvite, firstArg, secondArg)
    end

    if flagState3 and operationSuccessEleven ~= false
      and Settings.questGroup.membershipConfirmWait(firstArg, secondArg, 0.5) then
      Settings.questGroup.lastInviteAcceptResult = "joined_confirmed"
      return true, "joined_confirmed"
    end
  end

  flagState3, operationSuccessEleven = pcall(firstArg.AcceptInvite)

  if not flagState3 or operationSuccessEleven == false then
    flagState3, operationSuccessEleven = pcall(firstArg.AcceptInvite, firstArg)
  end

  if not flagState3 or operationSuccessEleven == false then
    Settings.questGroup.lastInviteAcceptResult = "accept_failed"
    Settings.questGroup.joinVerifyResult = "accept_failed"
    return false, "accept_failed"
  end

  local membershipConfirmation = Settings.questGroup.membershipConfirmWait(firstArg, secondArg, 1.35)
  Settings.questGroup.lastInviteAcceptResult = membershipConfirmation and "joined_confirmed" or "accept_unconfirmed"
  return membershipConfirmation, Settings.questGroup.lastInviteAcceptResult
end

