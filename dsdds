    function mmbaiUserIntent.WatchdogManager.Pulse(firstArg, secondArg, thirdArg, fourthArg, fifthArg, timeout, seventhArg, eighthArg, ...)
      local pulseTimestamp = tick()
      timeout = tonumber(timeout) or firstArg:Timeout(secondArg, eighthArg)
      local localPulse = firstArg.records[secondArg]

      if not localPulse then
        localPulse = {
          name = secondArg,
          active = false,
          attempts = 0,
          consecutiveFailures = 0,
          lastProgressAt = pulseTimestamp,
          nextEscalationAt = 0,
          stalled = false,
        }

        firstArg.records[secondArg] = localPulse
      end

      if thirdArg and not localPulse.active then
        localPulse.active = true
        localPulse.startedAt = pulseTimestamp
        localPulse.attempts = localPulse.attempts + 1
        localPulse.initialProgress = fifthArg
        localPulse.lastProgress = fifthArg
        localPulse.lastProgressAt = pulseTimestamp
        localPulse.reason = fourthArg
        localPulse.timeout = timeout
        localPulse.moduleName = seventhArg
      elseif thirdArg then
        localPulse.reason = fourthArg or localPulse.reason
        localPulse.timeout = timeout
        localPulse.moduleName = seventhArg or localPulse.moduleName

        if type(fifthArg) == "number"
          and (localPulse.lastProgress == nil or fifthArg > localPulse.lastProgress + 0.01) then
          localPulse.lastProgress = fifthArg
          localPulse.lastProgressAt = pulseTimestamp
          localPulse.stalled = false
          localPulse.result = "progress"

          firstArg:SetModuleFailure(localPulse.moduleName, nil, false)
          localPulse.consecutiveFailures = 0
        end

        if pulseTimestamp - (localPulse.lastProgressAt or pulseTimestamp) >= timeout
          and pulseTimestamp >= (localPulse.nextEscalationAt or 0) then
          localPulse.stalled = true
          localPulse.consecutiveFailures = localPulse.consecutiveFailures + 1
          localPulse.attempts = localPulse.attempts + 1
          localPulse.lastFailureAt = pulseTimestamp

          localPulse.failureReason = string.format(
            "%s watchdog made no verified progress for %.0fs", secondArg,
            pulseTimestamp - localPulse.lastProgressAt
          )

          localPulse.result = "stalled"
          localPulse.nextEscalationAt = pulseTimestamp + math.clamp(timeout * 0.3, 8, 45)

          firstArg:SetModuleFailure(localPulse.moduleName, localPulse.failureReason, true)
          local pulseGetValue = localPulse.moduleName and mmbaiUserIntent.ModuleRegistry:Get(localPulse.moduleName)

          if mmbaiUserIntent.Authority and pulseGetValue then
            mmbaiUserIntent.Authority:Signal(
              "Watchdog:" .. tostring(secondArg), pulseGetValue.owner, localPulse.failureReason,
              pulseGetValue.vital and 940 or 720, 5
            )
          end

          mmbaiUserIntent.Memory:MarkFailure("watchdog", secondArg, localPulse.failureReason, 45)

          mmbaiUserIntent.Telemetry:Push("WatchdogManager", "stall", {
            reason = localPulse.failureReason,
            result = "attempt " .. localPulse.attempts,
            debounce = 8,
          }, "watchdog-stall:" .. secondArg, secondArg .. " watchdog failed; escalating strategy")
        end
      elseif localPulse.active then
        local pulseCondition = type(fifthArg) == "number" and type(localPulse.initialProgress) == "number"
          and fifthArg > localPulse.initialProgress + 0.01

        local pulseStartedatProperty = pulseTimestamp - (localPulse.startedAt or pulseTimestamp)

        localPulse.active = false
        localPulse.result = pulseCondition and "progress" or "no verified progress"
        localPulse.finishedAt = pulseTimestamp

        if pulseCondition then
          localPulse.consecutiveFailures = 0
          localPulse.stalled = false
          firstArg:SetModuleFailure(localPulse.moduleName, nil, false)
        else
          if localPulse.stalled or pulseStartedatProperty >= timeout * 0.75 then
            localPulse.consecutiveFailures = localPulse.consecutiveFailures + 1
          end

          if localPulse.consecutiveFailures >= 3 then
            mmbaiUserIntent.Memory:MarkFailure("watchdog", secondArg, localPulse.reason, 45)
          end

          if localPulse.stalled then
            localPulse.failureUntil = pulseTimestamp + 12
          end
        end
      elseif localPulse.failureUntil and pulseTimestamp >= localPulse.failureUntil then
        localPulse.failureUntil = nil
        localPulse.stalled = false
        firstArg:SetModuleFailure(localPulse.moduleName, nil, false)
      end

      return localPulse
    end

