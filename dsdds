function Settings.slotGuardianGrowthVerdict(firstArg, secondArg, thirdArg, fourthArg, fifthArg, sixthArg, ...)
  local function growthHandleGrowth(firstArg, ...)
    return type(firstArg) == "table" and firstArg.savedRead == "ok"
      and firstArg.subjectSaved == "present_in_snapshot" and firstArg.subjectMatchCount == 1
      and type(firstArg.subjectGrowth) == "number"
      and (firstArg.subjectIdentity == "unique" or firstArg.subjectIdentity == "name")
  end

  if not growthHandleGrowth(fourthArg) or not growthHandleGrowth(fifthArg) or fourthArg.subjectIdentity ~= fifthArg.subjectIdentity then
    return "unverified", "same saved slot or growth unavailable after reset"
  end

  if math.abs(fourthArg.subjectGrowth - fifthArg.subjectGrowth) > 0.75 then
    return "unverified", "saved growth still changing between follow-up reads"
  end

  local numValSource = tonumber(firstArg)
  local growthStrLit = "saved_before_death"

  if not numValSource and tonumber(secondArg) and growthHandleGrowth(thirdArg)
    and math.abs(thirdArg.subjectGrowth - secondArg) <= 1.5 then
    numValSource = secondArg
    growthStrLit = "live_growth_matches_death_edge_saved"
  end

  if not numValSource then
    return "unverified", "no comparable pre-death growth baseline"
  end

  local localInfdWork = numValSource - fifthArg.subjectGrowth

  if localInfdWork >= 2 then
    if sixthArg then
      return "transaction_growth_change", "growth fell during slot transaction; cause not inferred", numValSource, fifthArg.subjectGrowth, growthStrLit
    end

    return "growth_loss", "saved growth fell after Humanoid.Died", numValSource, fifthArg.subjectGrowth, growthStrLit
  end

  if localInfdWork <= 0.75 then
    return "growth_preserved", "saved growth remained at or above pre-death level", numValSource, fifthArg.subjectGrowth, growthStrLit
  end

  return "unverified", "growth difference is below the reliable loss threshold", numValSource, fifthArg.subjectGrowth, growthStrLit
end

