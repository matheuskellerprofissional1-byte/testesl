function Settings.grassSearchTowardPride(firstArg, ...)
  if not isNotJungleLife or not Settings.autoEat then
    return false, "unsupported"
  end

  local resultPride, localPositionPride = handleChar()

  if not resultPride or not localPositionPride then
    return false, "no_character"
  end

  if isValidQuestTarget(resultPride) then
    return false, "not_grass_eater"
  end

  local grassPrideSearch = Settings.grassPrideSearch

  if grassPrideSearch.active then
    return false, "already_searching"
  end

  if tick() < (grassPrideSearch.retryAt or 0) then
    return false, "cooldown"
  end

  local recoveryTarget = Settings.herbivoreFoodRecoveryTarget()

  if typeof(recoveryTarget) ~= "Vector3" then
    grassPrideSearch.retryAt = tick() + 1.5
    return false, Settings.questZonePriorityActive() and "zone_target_pending" or "no_pride_target"
  end

  if Settings.autoFoodPositionAllowed and not Settings.autoFoodPositionAllowed(recoveryTarget) then
    if ((tonumber(resultPride:GetAttribute("Food")) or 100) <= 82
        or Settings.growthFoodRefillNoteFailure("grass_search_blocked_by_food_area"))
      and Settings.requestHerbivoreFoodRecovery then
      Settings.requestHerbivoreFoodRecovery("grass_search_blocked_by_food_area")
    end

    if not Settings.autoFoodPositionAllowed(recoveryTarget) then
      grassPrideSearch.retryAt = tick() + 1
      return false, "food_area_restricted"
    end
  end

  local prideLocalValue = tonumber(firstArg) or 92
  local prideAttribute = tonumber(resultPride:GetAttribute("Food")) or 100
  local posiPositionPride = nil
  local searchIsFalse = false

  grassPrideSearch.active = true
  grassPrideSearch.found = nil
  grassPrideSearch.prompt = false
  grassPrideSearch.lastNearScanAt = 0
  grassPrideSearch.lastFarScanAt = 0

  strLitInf = Settings.questZonePriorityActive()
      and "Sem grama valida por perto; seguindo ao ponto da missao "
        .. tostring(Settings.questZonePriority.zone or "")
    or "Sem grama valida por perto; procurando em direcao ao Pride Rock"

  local prideSearchb = isPositionReachable(recoveryTarget, 8, nil, {
    purpose = "foodPercent",
    tolerance = 22,
    speedScale = 1,
    constantSpeed = true,
    maxDuration = 360,
    routeCheckInterval = 0.25,
    routeCheck = function(ignored, ignored, ...)
      if not Settings.autoEat or not ignored or not ignored or isValidQuestTarget(ignored) or Settings.questGrowthReset.exclusive
        or localGlobal then
        return true, "grass_search_interrupted"
      end

      if (tonumber(ignored:GetAttribute("Food")) or 100) >= prideLocalValue then
        return true, "fed"
      end

      if Settings.autoDrink and Settings.survivalArbiter and Settings.survivalArbiter.owner == "waterPercent" then
        return true, "water_priority"
      end

      if Settings.grassEatAvailable(ignored) then
        posiPositionPride = ignored.Position
        searchIsFalse = true
        return true, "grass_prompt"
      end

      local prideTransformData = tick()

      if prideTransformData - (grassPrideSearch.lastNearScanAt or 0) >= 0.85 then
        grassPrideSearch.lastNearScanAt = prideTransformData
        local prideSearchPosition = iterateItemsQuery(ignored.Position)

        if prideSearchPosition then
          posiPositionPride = prideSearchPosition
          return true, "grass_found"
        end
      end

      if prideTransformData - (grassPrideSearch.lastFarScanAt or 0) >= 3.5 then
        grassPrideSearch.lastFarScanAt = prideTransformData
        local prideSearchPositiona = iterateItemsRef(ignored.Position)

        if prideSearchPositiona then
          posiPositionPride = prideSearchPositiona
          return true, "grass_found"
        end
      end

      return false
    end,
  })

  local routeInterruptReason = Settings.safeMove.routeInterruptReason

  grassPrideSearch.active = false
  grassPrideSearch.found = posiPositionPride
  grassPrideSearch.prompt = searchIsFalse

  resultPride, localPositionPride = handleChar()

  if not resultPride or not localPositionPride then
    grassPrideSearch.retryAt = tick() + 2
    return false, "no_character"
  end

  if routeInterruptReason == "fed" then
    grassPrideSearch.retryAt = 0
    return true, "fed", posiPositionPride
  end

  if routeInterruptReason == "water_priority" then
    grassPrideSearch.retryAt = tick() + 1
    return false, "water_priority"
  end

  if searchIsFalse and Settings.grassEatAvailable(resultPride) then
    grassPrideSearch.retryAt = 0
    strLitInf = "Grama encontrada durante a busca; parando rota para comer"
    return true, "prompt", posiPositionPride or localPositionPride.Position
  end

  if posiPositionPride then
    strLitInf = "Grama encontrada durante a rota; desviando para comer"
    local resultPride, locaGrassPride = checkConditionRef(posiPositionPride, nil, resultPride, prideAttribute)

    if resultPride then
      grassPrideSearch.retryAt = 0
      return true, locaGrassPride or "grass_found", posiPositionPride
    end

    grassPrideSearch.retryAt = locaGrassPride == "grass_search_obsolete" and 0 or tick() + 1.5
    return false, locaGrassPride or "grass_move_failed"
  end

  if prideSearchb then
    local foodLevelExtended = tonumber(resultPride:GetAttribute("Food")) or 100
    local prideConditionalResult = iterateItemsQuery(localPositionPride.Position) or iterateItemsRef(localPositionPride.Position)

    if prideConditionalResult then
      local resultPride, locaGrassPride2 = checkConditionRef(prideConditionalResult, nil, resultPride, foodLevelExtended)

      if resultPride then
        grassPrideSearch.retryAt = 0
        return true, locaGrassPride2 or "grass_at_pride", prideConditionalResult
      elseif locaGrassPride2 == "grass_search_obsolete" then
        grassPrideSearch.retryAt = 0
        return false, locaGrassPride2
      end
    end
  end

  grassPrideSearch.retryAt = tick() + 3
  return false, routeInterruptReason or prideSearchb and "pride_reached_no_grass" or "route_failed"
end

