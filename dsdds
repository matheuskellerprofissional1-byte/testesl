function Settings.waterShouldPreemptFood(firstArg, secondArg, ...)
  local foodFoodAttribute = firstArg and tonumber(firstArg:GetAttribute("Food")) or 100
  local foodWaterAttribute = firstArg and tonumber(firstArg:GetAttribute("Water")) or 100
  local foodFoodVitalPriority = Settings.survivalLowVitalPriority(foodFoodAttribute, foodWaterAttribute, firstArg)

