  for realLoopIdx, realLoopItemValue in ipairs(players:GetPlayers()) do
    if realLoopItemValue ~= localPlayer then
      local questGroupGetplayeranimal3 = Settings.questGroup.getPlayerAnimal(realLoopItemValue)

      if type(questGroupGetplayeranimal3) == "string" and questGroupGetplayeranimal3 ~= "" then
        if Settings.questGroup.sameAnimal(questGroupGetplayeranimal3, questGroupGetplayeranimal) then
          if Settings.questDinoGeneric(questGroupGetplayeranimal) then
