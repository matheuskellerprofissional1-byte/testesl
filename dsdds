              "Rex/Carnotaurus Eat session had no Food progress"
            )
          elseif askServerTo then
            Settings.safeAskSubState("Walking")
          end

          return false
        end
      else
        progressIsFoodCheck = nil

        if eatStartPromptVisible and currentTimestampAdd >= foodLiteral and counDino6 < 2 then
