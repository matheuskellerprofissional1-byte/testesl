  end

  local parsedNum23 = tonumber(dinoRockObstacleCache.refreshInterval) or 60

  if type(dinoRockObstacleCache.entries) == "table" and #dinoRockObstacleCache.entries == 0 then
    parsedNum23 = math.min(parsedNum23, 5)
  end

  if not firstArg and dinoRockObstacleCache.folder == movementDinoRocksFolderConfig
    and dinoRockObstacleCache.singleRock == movementDinoSingle
    and type(dinoRockObstacleCache.entries) == "table"
    and (dinoRockObstacleCache.scanAt or 0) > 0
    and timeMove2 - (dinoRockObstacleCache.scanAt or 0) <= parsedNum23 then
    return dinoRockObstacleCache.entries
  end

  local dataStore4 = {}

  local function scanDescendantParts(firstArg, ...)
    if not firstArg or not firstArg.Parent then
      return nil
    end

    if firstArg:IsA("BasePart") then
      if not firstArg.CanCollide then
        return nil
      end
    elseif firstArg:IsA("Model") then
      local itemsIsFalse = false

      for itemsLoopIdx, itemsLoopItem in ipairs(firstArg:GetDescendants()) do
        if itemsLoopItem:IsA("BasePart") and itemsLoopItem.CanCollide then
          itemsIsFalse = true
          break
        end
      end

      if not itemsIsFalse then
        return nil
      end
    end

    local itemWorldTransform, itemsObjectSize
    local primaryPart

    if firstArg:IsA("BasePart") then
      itemWorldTransform = firstArg.cFrame
      itemsObjectSize = firstArg.Size
      primaryPart = firstArg
    elseif firstArg:IsA("Model") then
      local itemsSpecificPlayRemaining, itemsSpecificPlayRemaining, success = pcall(firstArg.GetBoundingBox, firstArg)

      if itemsSpecificPlayRemaining and typeof(itemsSpecificPlayRemaining) == "cFrame" and typeof(success) == "Vector3" then
        itemWorldTransform = itemsSpecificPlayRemaining
        itemsObjectSize = success
        primaryPart = firstArg.PrimaryPart or firstArg:FindFirstChildWhichIsA("BasePart", true)
      end
    end

    if not itemWorldTransform or not itemsObjectSize or not primaryPart or not primaryPart.Parent then
      return nil
    end

    local localNext = itemsObjectSize * 0.5

    local entriesAbsoluteValue = math.abs(itemWorldTransform.RightVector.X) * localNext.X
      + math.abs(itemWorldTransform.UpVector.X) * localNext.Y + math.abs(itemWorldTransform.LookVector.X) * localNext.Z

    local itemsAbsValue = math.abs(itemWorldTransform.RightVector.Y) * localNext.X
      + math.abs(itemWorldTransform.UpVector.Y) * localNext.Y + math.abs(itemWorldTransform.LookVector.Y) * localNext.Z

    local itemsAbsValue = math.abs(itemWorldTransform.RightVector.Z) * localNext.X
      + math.abs(itemWorldTransform.UpVector.Z) * localNext.Y + math.abs(itemWorldTransform.LookVector.Z) * localNext.Z

    return {
      object = firstArg,
      part = primaryPart,
      cf = itemWorldTransform,
      size = itemsObjectSize,
      center = itemWorldTransform.Position,
      cframe2 = itemWorldTransform.Position.X - entriesAbsoluteValue,
      cframePositionItems = itemWorldTransform.Position.X + entriesAbsoluteValue,
      cframeBackup = itemWorldTransform.Position.Y - itemsAbsValue,
      itemsCframe = itemWorldTransform.Position.Y + itemsAbsValue,
      cframeCached = itemWorldTransform.Position.Z - itemsAbsValue,
      cframePrimary = itemWorldTransform.Position.Z + itemsAbsValue,
      maxPlanar = math.max(entriesAbsoluteValue * 2, itemsAbsValue * 2),
    }
  end

  local itemsEmptyTable = {}

  local function utilityHelper(firstArg, ...)
    if not firstArg or itemsEmptyTable[firstArg] or not firstArg.Parent then
      return
    end

    if not tostring(firstArg.Name):lower():find("rockvar", 1, true) then
      return
    end

    local parentObject = firstArg.Parent

    while parentObject and parentObject ~= movementDinoRocksFolderConfig do
      if tostring(parentObject.Name):lower():find("rockvar", 1, true) then
        return
      end

      parentObject = parentObject.Parent
    end

    local localOther = scanDescendantParts(firstArg)

    if localOther then
      itemsEmptyTable[firstArg] = true
      dataStore4[#dataStore4 + 1] = localOther
    end
  end

  if movementDinoRocksFolderConfig then
    for helperLoopIdx, helperLoopItem in ipairs(movementDinoRocksFolderConfig:GetChildren()) do
      if helperLoopItem:IsA("Model") or helperLoopItem:IsA("BasePart") then
        utilityHelper(helperLoopItem)
      end
    end

    if #dataStore4 == 0 then
      for helperLoopIdx, helperLoopItem in ipairs(movementDinoRocksFolderConfig:GetDescendants()) do
        if helperLoopItem:IsA("Model") or helperLoopItem:IsA("BasePart") then
          utilityHelper(helperLoopItem)
        end
      end
    end

    if #dataStore4 == 0 then
      for helperLoopIdx, helperLoopItem in ipairs(movementDinoRocksFolderConfig:GetChildren()) do
        local defaultNestRock = scanDescendantParts(helperLoopItem)

        if defaultNestRock then
          dataStore4[#dataStore4 + 1] = defaultNestRock
        end
      end
    end
  end

  local dataStore7 = {}
  local dataStore8 = {}

  for helperLoopIdx, helperLoopItem in ipairs(dataStore4) do
    dataStore7[helperLoopIdx] = helperLoopIdx

    dataStore8[helperLoopIdx] = {
      cframe2 = helperLoopItem.cframe2,
      cframePositionItems = helperLoopItem.cframePositionItems,
      cframeBackup = helperLoopItem.cframeBackup,
      itemsCframe = helperLoopItem.itemsCframe,
      cframeCached = helperLoopItem.cframeCached,
      cframePrimary = helperLoopItem.cframePrimary,
      maxPlanar = helperLoopItem.maxPlanar,
    }
  end

  local function conditionCheckCondition(firstArg, ...)
    while dataStore7[firstArg] ~= firstArg do
      dataStore7[firstArg] = dataStore7[dataStore7[firstArg]]
      firstArg = dataStore7[firstArg]
    end

    return firstArg
  end

  local function conditionCheckCondition(firstArg, secondArg, ...)
    local localPrior = conditionCheckCondition(firstArg)
    local animalName = conditionCheckCondition(secondArg)

    if localPrior == animalName then
      return false
    end

    local animalName = dataStore8[localPrior]
    local animalName = dataStore8[animalName]
