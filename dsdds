      elseif secondArg.type == "Zone" then
        local diagnosisZoneName = Settings.questCurrentZoneName()

        if secondArg.zone and (type(diagnosisZoneName) ~= "string" or diagnosisZoneName:lower() ~= secondArg.zone:lower()) then
