      if not selectIsFalseaValue and candidateSurvivalVerdict and candidateSurvivalVerdict.foodNeed
        and candidateSurvivalVerdict.waterNeed
        and (candidateSurvivalVerdict.selected == "Food" or candidateSurvivalVerdict.selected == "Water")
        and not safetyHazard then
        for selectLoopIdx1, selectLoopItem1 in ipairs(secondArg) do
          if selectLoopItemaValue.owner == candidateSurvivalVerdict.selected and selectLoopItemaValue.score > -900 then
            locCandidate = selectLoopItemaValue
            selectIsFalseaValue = true
            break
          end
        end
      end

      if authoritySource and authoritySource.currentOwner ~= "None" then
        for selectLoopIdx2, selectLoopItem2 in ipairs(secondArg) do
          if selectLoopItembValue.owner == authoritySource.currentOwner then
            local criticalPreemption = authoritySource:CriticalPreemption(
              locCandidate.owner, selectLoopItembValue.owner, thirdArg
            )

            if authoritySource.exclusive and not selectIsFalseaValue and not criticalPreemption then
              locCandidate = selectLoopItembValue
              selectIsFalse = true
              break
            end

            local candidatePhysicalOwner = authoritySource:PhysicalOwner(thirdArg)

            if not selectIsFalseaValue
              and candidatePhysicalOwner == selectLoopItembValue.owner
              and authoritySource:PhysicalProgressAge(selectLoopItembValue.owner, thirdArg)
                <= mmbaiModuleRegistry.Policy.Decision.progressRetention
              and not criticalPreemption then
              locCandidate = selectLoopItembValue
            end

            break
          end
        end
      end

      local localQuestCandidate

      for selectLoopIdx, selectLoopItem3 in ipairs(secondArg) do
        if selectLoopItemcValue.name == firstArg.current then
          localQuestCandidate = selectLoopItemcValue
          break
        end
      end

      if not selectIsFalse and not selectIsFalseaValue and localQuestCandidate and locCandidate ~= localQuestCandidate then
        local candidateCriticalPreemption = authoritySource and authoritySource:CriticalPreemption(
          locCandidate.owner, localQuestCandidate.owner, thirdArg
        )

        local candidateCurrentsinceProperty = tick() - (firstArg.currentSince or tick())

        local semanticProgressAge = authoritySource
            and authoritySource:SemanticProgressAge(localQuestCandidate.owner, thirdArg)
          or math.huge

        local decision = mmbaiModuleRegistry.Policy.Decision

        if not candidateCriticalPreemption
          and not (localQuestCandidate.owner == "Quest" and Settings.questMovementPriorityVerified == true
            and Settings.questMovementPriorityPending ~= true
            and not Settings.questPhysicalLocomotionActive())
          and (candidateCurrentsinceProperty < decision.minimumOwnerDwell
            or semanticProgressAge <= decision.progressRetention
              and locCandidate.score < localQuestCandidate.score + decision.challengerMargin) then
          locCandidate = localQuestCandidate
        end
      end

      local locaCandidate2

      for selectLoopIdx4, selectLoopItem in ipairs(secondArg) do
        if selectLoopItem ~= locCandidate and (not locaCandidate2 or selectLoopItem.score > locaCandidate2.score) then
          locaCandidate2 = selectLoopItem
        end
      end

      return locCandidate, locaCandidate2
    end

