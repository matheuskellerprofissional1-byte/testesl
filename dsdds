  if Settings.questGroup.teamOnlyName ~= secondArg then
    Settings.questGroup.teamOnlyName = secondArg
    Settings.questGroup.teamOnlySince = timeTeam
    Settings.questGroup.teamOnlyRepairAt = 0
    Settings.questGroup.teamOnlyRepairAttempts = 0
  end

  local teamLocalValue = timeTeam - (tonumber(Settings.questGroup.teamOnlySince) or timeTeam)

  if teamLocalValue < 2.75 then
    Settings.questGroup.statusText = "KITTY co-op: Team " .. secondArg
      .. " waiting for PackHandler confirmation"

    return true, false
  end

  if type(firstArg.Leave) == "function"
    and timeTeam - (tonumber(Settings.questGroup.teamOnlyRepairAt) or 0) >= 2.5 then
    Settings.questGroup.teamOnlyRepairAt = timeTeam
    Settings.questGroup.teamOnlyRepairAttempts = (Settings.questGroup.teamOnlyRepairAttempts or 0) + 1

