      local conditionSupervisorPermit, successOther = pcall(function(...)
        if not Settings.elephantHoverStart(sixthCheckCondition, localInfdNext, localHealthEject, mmbElephantTerrainHover, limitCalc7 - drinkSolidTerrain) then
