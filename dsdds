  end

  local local = handleSurvivalOther(charDryFissureEvidence)

  if isDinoLifePlaceId and Settings.isDinoRex2
      and Settings.isDinoRex2(charDryFissureEvidence)
    or false then
    local targetHumanoidRef = charDryFissureEvidence:FindFirstChildOfClass("Humanoid")
    local charWaterPoint = Settings.drinkSearch.currentWaterPoint

    if targetHumanoidRef and typeof(charWaterPoint) == "Vector3"
      and Settings.dinoRexCarno then
      local charDryFissureEvidence, local = Settings.dinoRexCarno({
        waterPercent = charWaterPoint,
        stand = localInfdPrior.Position,
        source = "watchdog",
      }, charDryFissureEvidence, localInfdPrior, targetHumanoidRef, tonumber(charDryFissureEvidence:GetAttribute("Water"))
        or 0, 3.5)

      if charDryFissureEvidence then
        emptyReference = local and local.Position or localInfdPrior.Position
        task.spawn(growthHandleGrowth)
      else
        Settings.drinkAbandonCurrent("Rex/Carnotaurus watchdog: prompt existed but Water never rose")
      end
    else
      Settings.drinkAbandonCurrent("Rex/Carnotaurus watchdog: no precise waterPercent point for verified Drink")
    end

    operationTimestamp = nil
    return
  end

  if local == "Drink" then
    strLitInf = "Drink stalled; prompt still active, reasserting in place"
    emptyReference = localInfdPrior.Position
  else
    strLitInf = "Drink stalled; reasserting server Drinking state"

    if Settings.isCrocOrHippoMovementCharacter(charDryFissureEvidence) then
      helperUtil()
      local charDryFissureEvidence, local = animalNameResolver.getWaterSurfaceYield()

      if local then
        local.CanCollide = true
      end

      local targetHumanoidRef = charDryFissureEvidence:FindFirstChildOfClass("Humanoid")
      local charWaterPoint = Settings.drinkSearch.currentWaterPoint

      if targetHumanoidRef and Settings.drinkAcquirePromptAfterMove(
        { waterPercent = charWaterPoint }, charDryFissureEvidence, localInfdPrior, targetHumanoidRef,
        tonumber(charDryFissureEvidence:GetAttribute("Water")) or 0, 1.8
      ) then
        local charDryFissureEvidence, local = handleChar()

        if local then
          emptyReference = local.Position
        end

        strLitInf = "Croco: recovered Drink by rotating in place"
        task.spawn(growthHandleGrowth)
      else
        emptyReference = nil
        animalNameResolver.approachDrink()
      end
    elseif emptyReference then
      Settings.drinkAbandonCurrent("Watchdog: fonte sem progresso; trocando de agua")
      return
    end

    task.wait(0.2)
  end

  utilityHelper("Drinking")
  isFalseInf = false

  if not Settings.isCrocOrHippoMovementCharacter(charDryFissureEvidence) then
    task.spawn(growthHandleGrowth)
  end

  operationTimestamp = nil
end

function Settings.drinkSurfaceSearchTransit(firstArg, ...)
  if not (isNotJungleLife or isDinoLifePlaceId)
    or Settings.autoDrinkMode ~= "surface"
    or not Settings.autoDrink
      and not (Settings.isSavannahFlamingo(firstArg) and Settings.autoEat
        and Settings.savannahFlamingoDrinkDue(firstArg, nil, nil, true))
    or not firstArg
    or firstArg ~= localPlayer.Character then
    return nil, "not_applicable"
  end

  local transitHeavyAnimalType = isNotJungleLife and animalNameResolver.isCharacter(firstArg)

  if isTargetValid(firstArg) and not transitHeavyAnimalType
    or Settings.isCrocOrHippoMovementCharacter(firstArg) and not transitHeavyAnimalType
    or type(Settings.isFlyingMovementCharacter) == "function"
      and Settings.isFlyingMovementCharacter(firstArg) and not Settings.isSavannahFlamingo(firstArg) then
    return nil, "special_movement"
  end

  local conditionalResultGamma, localPositionTransit = handleChar()

  if not conditionalResultGamma or not localPositionTransit then
    return nil, "no_character"
  end

  local transitTransformData = Settings.drinkFindAccessibleSpot(localPositionTransit.Position, conditionalResultGamma, isNotJungleLife and { savannahQuick = true }
    or isDinoLifePlaceId and { dinoQuick = true } or nil)

  if transitTransformData then
    return transitTransformData, "water_found"
  end

  local posiPositionTransit
  local locationLabel

  if isDinoLifePlaceId then
    iterateItems()

    if #emptyTableInglobal1 == 0 then
      return nil, "no_spawn_target"
    end

    Settings.drinkSearch.dinoSpawnVisited = Settings.drinkSearch.dinoSpawnVisited or {}
    local dinoSpawnVisited = Settings.drinkSearch.dinoSpawnVisited
    local currentTimestampDelta = tick()
    local dataStoreDrinksurfacesearchtransit2 = {}

    for surfaceLoopIdxValue, surfaceLoopItemValue in ipairs(emptyTableInglobal1) do
      if surfaceLoopItemValue and surfaceLoopItemValue.Parent and surfaceLoopItemValue:IsA("BasePart") then
        if not (Settings.dinoRestrictedBasin
            and Settings.dinoRestrictedBasin(surfaceLoopItemValue.Position, conditionalResultGamma, 5)
          or false) then
          local magnitudedOther = Vector3.new(
            surfaceLoopItemValue.Position.X - localPositionTransit.Position.X, 0, surfaceLoopItemValue.Position.Z - localPositionTransit.Position.Z
          ).Magnitude

          if magnitudedOther >= 45 then
            local conditionalResultDelta = dinoSpawnVisited[surfaceLoopItemValue] or 0

            dataStoreDrinksurfacesearchtransit2[#dataStoreDrinksurfacesearchtransit2 + 1] = {
              part = surfaceLoopItemValue,
              index = surfaceLoopIdxValue,
              distance = magnitudedOther,
              fresh = currentTimestampDelta - conditionalResultDelta >= 45,
            }
          end
        end
      end
    end

    if #dataStoreDrinksurfacesearchtransit2 == 0 then
      return nil, "no_spawn_target"
    end

    table.sort(dataStoreDrinksurfacesearchtransit2, function(ignored, ignored, ...)
      if ignored.fresh ~= ignored.fresh then
        return ignored.fresh
      end

      return ignored.distance < ignored.distance
    end)

    local transitSurfaceb = dataStoreDrinksurfacesearchtransit2[1]
    local transitPartProperty = transitSurfaceb.part
    dinoSpawnVisited[transitPartProperty] = currentTimestampDelta
    posiPositionTransit = transitPartProperty.Position
    locationLabel = Settings.spawnLocationLabel(transitPartProperty)
    Settings.drinkSearch.dinoSpawnTransitIndex = transitSurfaceb.index % #emptyTableInglobal1 + 1
  elseif transitHeavyAnimalType then
    iterateItems()

    if #emptyTableInglobal1 == 0 then
      return nil, "no_spawn_target"
    end

    if Settings.drinkSearch.crocWaterSpawnCharacter ~= conditionalResultGamma then
      Settings.drinkSearch.crocWaterSpawnCharacter = conditionalResultGamma
      Settings.drinkSearch.crocWaterSpawnVisited = {}
    end

    Settings.drinkSearch.crocWaterSpawnVisited = Settings.drinkSearch.crocWaterSpawnVisited or {}
    local crocWaterSpawnVisited = Settings.drinkSearch.crocWaterSpawnVisited
    local currentTimestampEpsilon = tick()
    local surfaceEmptyTable = {}

    for surfaceLoopIdx, surfaceLoopItem in ipairs(emptyTableInglobal1) do
      if surfaceLoopItem and surfaceLoopItem.Parent and surfaceLoopItem:IsA("BasePart") then
        local magnitudedPrior = Vector3.new(
          surfaceLoopItem.Position.X - localPositionTransit.Position.X, 0, surfaceLoopItem.Position.Z - localPositionTransit.Position.Z
        ).Magnitude

        if magnitudedPrior >= 70 then
          local transitIsWaterCheck = crocWaterSpawnVisited[surfaceLoopItem] or 0

          if not (Settings.savannahSurvivalTarget
              and Settings.savannahSurvivalTarget(surfaceLoopItem.Position, conditionalResultGamma, 5)
            or false) then
            surfaceEmptyTable[#surfaceEmptyTable + 1] = {
              part = surfaceLoopItem,
              index = surfaceLoopIdx,
              distance = magnitudedPrior,
              lastVisit = transitIsWaterCheck,
              fresh = currentTimestampEpsilon - transitIsWaterCheck >= 75,
            }
          end
        end
      end
    end

    if #surfaceEmptyTable == 0 then
      return nil, "no_spawn_target"
    end

    table.sort(surfaceEmptyTable, function(ignored, ignored, ...)
      if ignored.fresh ~= ignored.fresh then
        return ignored.fresh
      end

      if ignored.fresh == false and ignored.lastVisit ~= ignored.lastVisit then
        return ignored.lastVisit < ignored.lastVisit
      end

      return ignored.distance < ignored.distance
    end)

    local transitSurfacec = surfaceEmptyTable[1]
    local transitPartProperty = transitSurfacec.part
    crocWaterSpawnVisited[transitPartProperty] = currentTimestampEpsilon
    posiPositionTransit = transitPartProperty.Position
    locationLabel = "nearest fresh spawn " .. tostring(Settings.spawnLocationLabel(transitPartProperty))
    Settings.drinkSearch.crocWaterSpawnTransitIndex = transitSurfacec.index % #emptyTableInglobal1 + 1
  elseif Settings.growthPrideRestrictionActive(conditionalResultGamma)
    and Settings.growthPridePhysicallyInside(conditionalResultGamma, localPositionTransit) then
    posiPositionTransit = Settings.growthPrideSpawnReference()
    posiPositionTransit = posiPositionTransit and posiPositionTransit.Position or nil
    locationLabel = "PrideRockSpawn river approach"
  else
    posiPositionTransit = Settings.growthPrideSpawnReference()
    posiPositionTransit = posiPositionTransit and posiPositionTransit.Position or nil
    locationLabel = "PrideRockSpawn last-resort river corridor"
  end

  if typeof(posiPositionTransit) ~= "Vector3" then
    return nil, isDinoLifePlaceId and "no_spawn_target" or "no_pride_target"
  end

  Settings.drinkSearch.surfaceTransitActive = true
  Settings.drinkSearch.surfaceTransitFoundSpot = nil
  Settings.drinkSearch.surfaceTransitLastScanAt = 0
  Settings.drinkSearch.surfaceTransitLastLocalScanAt = tick()
  Settings.drinkSearch.surfaceTransitReason = nil

  local transitSurfaced = conditionalResultGamma
  local destinationPoint = localPositionTransit.Position
  local transitTimestamp = tick()

  strLitInf = isDinoLifePlaceId and "Dino waterPercent watchdog: moving toward " .. tostring(locationLabel) .. " and scanning"
    or transitHeavyAnimalType
      and "Croc waterPercent watchdog: moving toward " .. tostring(locationLabel)
        .. " and scanning continuously"
    or "Surface waterPercent search: moving continuously toward " .. tostring(locationLabel)

  local transitSurfacee = isPositionReachable(posiPositionTransit, 10, nil, {
    purpose = "water_search",
    forceMoveToLand = true,
    tolerance = 24,
    speedScale = 1,
    constantSpeed = true,
    maxDuration = isDinoLifePlaceId and 55 or 360,
    routeCheckInterval = isDinoLifePlaceId and 0.55 or 0.3,
    routeCheck = function(ignored, ignored, ...)
      if not Settings.autoDrink
          and not (Settings.isSavannahFlamingo(ignored) and Settings.autoEat
            and Settings.savannahFlamingoDrinkDue(ignored, nil, nil, true))
        or Settings.autoDrinkMode ~= "surface" then
        Settings.drinkSearch.surfaceTransitReason = "drink_disabled"
        return true, "drink_disabled"
      end

      if ignored ~= transitSurfaced or not ignored or not ignored then
        Settings.drinkSearch.surfaceTransitReason = "character_changed"
        return true, "character_changed"
      end

      if Settings.questGrowthReset.exclusive or localGlobal then
        Settings.drinkSearch.surfaceTransitReason = "priority"
        return true, "priority"
      end

      local transitAttribute = tonumber(ignored:GetAttribute("Water")) or 100

      do
        local magnitudedQuery = Vector3.new(
          ignored.Position.X - destinationPoint.X, 0, ignored.Position.Z - destinationPoint.Z
        ).Magnitude

        local transitCharacter = isDinoLifePlaceId and 4 or transitHeavyAnimalType and 0.85 or 1.25
        local transitConditionalResult = isDinoLifePlaceId and 7 or transitHeavyAnimalType and 6.5 or 4.5

        if magnitudedQuery >= transitCharacter then
          destinationPoint = ignored.Position
          transitTimestamp = tick()
        elseif tick() - transitTimestamp >= transitConditionalResult then
          local rockNearby = isDinoLifePlaceId and Settings.movementDinoRockNearby(ignored.Position, 12) or false

          Settings.drinkSearch.surfaceTransitReason = isDinoLifePlaceId
              and (rockNearby and "dino_rock_stall" or "dino_route_stall")
            or "savannah_route_stall"

          strLitInf = isDinoLifePlaceId
              and (rockNearby and "Dino waterPercent watchdog: rock route stalled; escaping now"
                or "Dino waterPercent watchdog: route made no progress; changing spawn")
            or "Surface waterPercent search: route stalled; replanning"

          return true, Settings.drinkSearch.surfaceTransitReason
        end
      end

      if isDinoLifePlaceId or isNotJungleLife then
        if handleSurvivalOther(ignored) == "Drink"
          or Settings.drinkGamePromptAvailable and Settings.drinkGamePromptAvailable(ignored)
          or Settings.drinkVisualPromptVisible and Settings.drinkVisualPromptVisible() then
          if Settings.drinkVisualPromptVisible and Settings.drinkVisualPromptVisible()
            and Settings.drinkLatchVisualPrompt then
            Settings.drinkLatchVisualPrompt()
          end

          Settings.drinkSearch.surfaceTransitFoundSpot = {
            waterPercent = ignored.Position,
            stand = ignored.Position,
            source = "CurrentDrinkContact",
            promptContact = true,
          }

          Settings.drinkSearch.surfaceTransitReason = "water_found"

          strLitInf = isDinoLifePlaceId and "Dino waterPercent watchdog: Drink detected; stopping here"
            or "Surface waterPercent search: Drink detected; stopping here"

          return true, "surface_water_found"
        end
      end

      if transitAttribute >= 98
        and not (Settings.isSavannahFlamingo(ignored)
          and Settings.savannahFlamingoDrinkDue(ignored, nil, transitAttribute, true)) then
        Settings.drinkSearch.surfaceTransitReason = "full"
        return true, "full"
      end

      local currentTimestampZeta = tick()

      if isNotJungleLife and currentTimestampZeta - (Settings.drinkSearch.surfaceTransitLastLocalScanAt or 0) >= 5 then
        Settings.drinkSearch.surfaceTransitLastLocalScanAt = currentTimestampZeta
        Settings.drinkSearch.surfaceTransitLastScanAt = currentTimestampZeta

        local accessibleSpot4 = Settings.drinkFindAccessibleSpot(ignored.Position, ignored, {
          savannahLocal = true,
        })

        if accessibleSpot4 then
          Settings.drinkSearch.surfaceTransitFoundSpot = accessibleSpot4
          Settings.drinkSearch.surfaceTransitReason = "water_found"

          strLitInf = "Surface waterPercent search: regional exposed waterPercent found; taking over"
          return true, "surface_water_found"
        end
      end

      if (isDinoLifePlaceId or isNotJungleLife) and currentTimestampZeta - (Settings.drinkSearch.surfaceTransitLastScanAt or 0) >= 1.05 then
        Settings.drinkSearch.surfaceTransitLastScanAt = currentTimestampZeta

        local transitAccessibleSpot = Settings.drinkFindAccessibleSpot(ignored.Position, ignored, isDinoLifePlaceId
            and { dinoQuick = true, dinoTransitScan = true }
          or { savannahQuick = true })

        if transitAccessibleSpot then
          Settings.drinkSearch.surfaceTransitFoundSpot = transitAccessibleSpot
          Settings.drinkSearch.surfaceTransitReason = "water_found"

          strLitInf = isDinoLifePlaceId and "Dino waterPercent watchdog: exposed waterPercent found; taking over"
            or "Surface waterPercent search: nearby exposed waterPercent found; taking over"

          return true, "surface_water_found"
        end
      end

      return false
    end,
  })

  local surfaceTransitFoundSpot = Settings.drinkSearch.surfaceTransitFoundSpot
  local surfaceTransitReason = Settings.drinkSearch.surfaceTransitReason

  Settings.drinkSearch.surfaceTransitActive = false
  Settings.drinkSearch.surfaceTransitFoundSpot = nil
  Settings.drinkSearch.surfaceTransitLastScanAt = 0
  Settings.drinkSearch.surfaceTransitLastLocalScanAt = 0
  Settings.drinkSearch.surfaceTransitReason = nil

  if surfaceTransitFoundSpot then
    return surfaceTransitFoundSpot, "water_found"
  end

  if surfaceTransitReason == "savannah_route_stall" then
    Settings.drinkSearch.retryAfter = 0
  end

  conditionalResultGamma, localPositionTransit = handleChar()

  if isDinoLifePlaceId and surfaceTransitReason == "dino_rock_stall" and conditionalResultGamma == transitSurfaced and localPositionTransit then
    local targetHumanoidRef = conditionalResultGamma:FindFirstChildOfClass("Humanoid")

    if targetHumanoidRef then
      pcall(Settings.dinoRockEmergencyNoclipEscape, conditionalResultGamma, localPositionTransit, targetHumanoidRef, "waterPercent")
      local resultTransit, transitSurfacef = handleChar()

      if transitSurfacef then
        local accessibleSpot3 = Settings.drinkFindAccessibleSpot(transitSurfacef.Position, conditionalResultGamma, { dinoQuick = true })

        if accessibleSpot3 then
          return accessibleSpot3, "water_found"
        end
      end
    end
  end

  if conditionalResultGamma == transitSurfaced
    and localPositionTransit
    and (Settings.autoDrink
      or Settings.isSavannahFlamingo(conditionalResultGamma) and Settings.autoEat
        and Settings.savannahFlamingoDrinkDue(conditionalResultGamma, nil, nil, true))
    and Settings.autoDrinkMode == "surface"
    and not Settings.questGrowthReset.exclusive
    and not localGlobal then
    local accessibleSpot = Settings.drinkFindAccessibleSpot(localPositionTransit.Position, conditionalResultGamma, isDinoLifePlaceId and { dinoQuick = true }
      or isNotJungleLife and { savannahLocal = true } or nil)

    if accessibleSpot then
      return accessibleSpot, "water_found"
    end
  end

  return nil, surfaceTransitReason or transitSurfacee and "arrived_no_water" or "route_failed"
end

local function utilityFunction(...)
  if Settings.savedSlotResetPending == true then
    return
  end

  if (shared.__kittyLicenseControl and shared.__kittyLicenseControl.waterPercent()) ~= true then
    return
  end

  if isDinoLifePlaceId and Settings.dinoDrinkFastScan and Settings.dinoDrinkFastScan.busy then
    return
  end

  if Settings.dinoShorelineRecovery and Settings.dinoShorelineRecovery.active then
    return
  end

  local herbivoreAnimalKey, localInfdQuery = handleChar()

  if isDinoLifePlaceId and herbivoreAnimalKey and localInfdQuery and Settings.isDinoHerbivore(herbivoreAnimalKey) then
    if Settings.dinoRockEmergency and Settings.dinoRockEmergency.supervisorActive
      and Settings.dinoRockEmergency.supervisorCharacter == herbivoreAnimalKey then
      Settings.dinoHerbivoreRetire(
        herbivoreAnimalKey, localInfdQuery, "Auto Drink revalidated open rock topology"
      )
    end

    if Settings.dinoHerbivoreRockClearance and Settings.dinoHerbivoreRockClearance.active then
      return
    end

    if (tonumber(herbivoreAnimalKey:GetAttribute("Water")) or 100) <= 70
      and Settings.dinoHerbivoreRock(herbivoreAnimalKey, localInfdQuery) then
      if Settings.dinoHerbivoreStart(
        herbivoreAnimalKey, localInfdQuery, "Water", "Emergency Water waiting for safe distance from blocked rocks"
      ) then
        return
      end
    end
  end

  if Settings.dinoRockEmergency and Settings.dinoRockEmergency.supervisorActive
    and Settings.dinoRockEmergency.supervisorCharacter == localPlayer.Character then
    return
  end

  if not Settings.autoDrink
    and not (herbivoreAnimalKey and Settings.isSavannahFlamingo(herbivoreAnimalKey) and Settings.autoEat
      and Settings.savannahFlamingoDrinkDue(herbivoreAnimalKey, nil, nil, noCarcassAvailable == true)) then
    Settings.drinkSearch.lockedSurfaceSpot = nil
    Settings.drinkSearch.lockedSurfaceCharacter = nil
    Settings.drinkSearch.lockedSurfaceRouteFailures = 0

    return
  end

  local herbivoreAnimalKey, herbivoreAnimalKey, moveDirectionOffset = handleChar()

  if not herbivoreAnimalKey or not herbivoreAnimalKey or not moveDirectionOffset then
    return
  end

  Settings.syncCrocHippoSurfaceDrinkMode(herbivoreAnimalKey, "Crocodile/Hippo: Surface Water synchronized")
  local waterPercent = tonumber(herbivoreAnimalKey:GetAttribute("Water")) or 100
  local foodPercent = tonumber(herbivoreAnimalKey:GetAttribute("Food")) or 100

  if isDinoLifePlaceId
    and Settings.autoGrowCurrentSlotComplete(herbivoreAnimalKey)
    and Settings.dinoSlotSwitchExpressReady(herbivoreAnimalKey, foodPercent, waterPercent)
    and (Settings.slotSwitchStagingActive == true
      or Settings.MMBAI and Settings.MMBAI.Authority and Settings.MMBAI.Authority.currentOwner == "Slots") then
    return
  end

  do
    local moveDirectionOffset = Settings.slotParkingAudit10()

    local utilAutoEat = moveDirectionOffset and Settings.isSavannahFlamingo(herbivoreAnimalKey) and Settings.autoEat and foodPercent < moveDirectionOffset
      or false

    if moveDirectionOffset and waterPercent >= moveDirectionOffset and not utilAutoEat then
      if Settings.slotParkingAudit5 then
        Settings.slotParkingAudit5(herbivoreAnimalKey, foodPercent, waterPercent)
      end

      return
    end
  end

  if Settings.isSavannahFlamingo(herbivoreAnimalKey) and Settings.autoEat
    and foodPercent < (Settings.savannahFlamingoDrink(herbivoreAnimalKey, noCarcassAvailable == true) or 80)
    and Settings.autoDrinkMode ~= "surface" then
    Settings.autoDrinkMode = "surface"
    Settings.drinkClearUndergroundMode()
    strLitInf = "Flamingo Food uses Surface Water"
  end

  local autoDrinkConfig = (Settings.autoDrink or Settings.isSavannahFlamingo(herbivoreAnimalKey) and Settings.autoEat)
    and Settings.survivalArbiterChoose(foodPercent, waterPercent) == "waterPercent"

  if Settings.survivalLatchFood then
    Settings.survivalLatchFood(
      herbivoreAnimalKey, foodPercent, "Food crossed <80 during committed AutoDrink"
    )
  end

  if not autoDrinkConfig and not Settings.aiModuleOperational("AutoDrink") then
    return
  end

  if not autoDrinkConfig and not Settings.aiMovementOperational("Water") then
    return
  end

  if Settings.herbivoreFoodRecovery and Settings.herbivoreFoodRecovery.active
    and Settings.herbivoreFoodRecovery.character == localPlayer.Character then
    if autoDrinkConfig and Settings.herbivoreFoodRecoveryFinish then
      Settings.herbivoreFoodRecoveryFinish(
        Settings.herbivoreFoodRecovery.token, false, "Water <70 preempted Food recovery"
      )
    else
      return
    end
  end

  if targetClearModule.exclusiveRecovery and targetClearModule.exclusiveRecovery.active and utilityHelper(localPlayer.Character) then
    if not autoDrinkConfig then
      return
    end
  end

  if Settings.slotParkingAudit and Settings.slotParkingAudit.active and not autoDrinkConfig then
    return
  end

  if Settings.aquaticRiverEscape and Settings.aquaticRiverEscape.survivalSuspended then
    return
  end

  if Settings.questGrowthReset.exclusive then
    return
  end

  if localGlobal and not autoDrinkConfig then
    return
  end

  if autoDrinkConfig then
    Settings.retireSatisfiedGeneric(
      herbivoreAnimalKey, foodPercent, "Water priority retired satisfied Food latch"
    )

    if Settings.growthPrideBeginWaterExcursion then
      pcall(Settings.growthPrideBeginWaterExcursion, herbivoreAnimalKey, herbivoreAnimalKey)
    end

    local dinoHerbivoreWaterEmergency = Settings.dinoHerbivoreWaterEmergency
        and Settings.dinoHerbivoreWaterEmergency(herbivoreAnimalKey, foodPercent, waterPercent)
      or false

    Settings.survivalPriorityTakeover("waterPercent", herbivoreAnimalKey, dinoHerbivoreWaterEmergency and "Dino emergency Water <=70"
      or "Water <70")
  end

