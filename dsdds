    secondArg.AssemblyAngularVelocity = Vector3.zero

    local progressIsFoodCheck

    while Settings.alive and localPlayer.Character == firstArg and firstArg.Parent and secondArg.Parent
      and fourthArg.Parent and thirdArg.Parent and tick() < progressParsedNumber do
      if (tonumber(firstArg:GetAttribute("Food")) or foodAttributeDuplicate) > foodAttributeDuplicate + 0.01 then
