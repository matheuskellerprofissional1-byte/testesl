function Settings.survivalLowVitalPriority(firstArg, secondArg, characterbNext, ...)
  characterbNext = characterbNext or localPlayer.Character

  if not characterbNext or not Settings.autoEat or not Settings.autoDrink
    or Settings.isSavannahFlamingo(characterbNext) then
    Settings.survivalLowVitalPriorityLease = nil
    return nil
  end

  firstArg = tonumber(firstArg) or 100
  secondArg = tonumber(secondArg) or 100

  -- KITTY HUB: Se growth 100% e vitais >= 10%, ignora prioridade de sobrevivência
  if Settings.autoGrowModeActive and Settings.autoGrowModeActive()
    and Settings.isGrowthComplete(characterbNext:GetAttribute("GrowthPercentage"))
    and firstArg >= 10 and secondArg >= 10 then
    Settings.survivalLowVitalPriorityLease = nil
    return nil
  end
  local survivalLowVitalPriorityLease = Settings.survivalLowVitalPriorityLease

  if survivalLowVitalPriorityLease and survivalLowVitalPriorityLease.character ~= characterbNext then
    survivalLowVitalPriorityLease = nil
    Settings.survivalLowVitalPriorityLease = nil
  end

  if survivalLowVitalPriorityLease then
    if survivalLowVitalPriorityLease.owner == "foodPercent" then
      if secondArg <= 5 and firstArg > 10 then
        survivalLowVitalPriorityLease.owner = "waterPercent"
      elseif firstArg < 80 then
        return "foodPercent"
      else
        Settings.survivalLowVitalPriorityLease = nil
        return nil
      end
    elseif survivalLowVitalPriorityLease.owner == "waterPercent" then
      if firstArg <= 10 then
        survivalLowVitalPriorityLease.owner = "foodPercent"
      elseif secondArg < 45 then
        return "waterPercent"
      else
        Settings.survivalLowVitalPriorityLease = nil
        return nil
      end
    end

    return survivalLowVitalPriorityLease.owner
  end

  if firstArg <= 25 and secondArg <= 25 then
    local priorityLocalValue = secondArg <= 5 and firstArg > 10 and "waterPercent" or "foodPercent"
    Settings.survivalLowVitalPriorityLease = { character = characterbNext, owner = priorityLocalValue }
    return priorityLocalValue
  end

  return nil
end

function Settings.carnivoreFoodFirstChoice(firstArg, secondArg, ...)
  local characterbOther = localPlayer.Character

  if not characterbOther or not isValidQuestTarget(characterbOther) or not Settings.autoEat or not Settings.autoDrink then
    return nil
  end

  firstArg = tonumber(firstArg) or 100
  secondArg = tonumber(secondArg) or 100
  local foodVitalPriority = Settings.survivalLowVitalPriority(firstArg, secondArg, characterbOther)

  if foodVitalPriority then
    return foodVitalPriority
  end

  local currentTick3 = tick()
  local carnivoreFoodFirstPolicy = Settings.carnivoreFoodFirstPolicy

  if not carnivoreFoodFirstPolicy or carnivoreFoodFirstPolicy.character ~= characterbOther then
    carnivoreFoodFirstPolicy = {
      character = characterbOther,
      foodAttemptAt = currentTick3,
      lastFoodGainAt = currentTick3,
      lastWaterGainAt = currentTick3,
      lastFood = firstArg,
      lastWater = secondArg,
      waterRescue = false,
      waterRescueAt = 0,
      waterRetryAfter = 0,
    }

    Settings.carnivoreFoodFirstPolicy = carnivoreFoodFirstPolicy
  end

  if firstArg > (carnivoreFoodFirstPolicy.lastFood or firstArg) + 0.05 then
    carnivoreFoodFirstPolicy.lastFoodGainAt = currentTick3
    carnivoreFoodFirstPolicy.foodAttemptAt = currentTick3
  end

  if secondArg > (carnivoreFoodFirstPolicy.lastWater or secondArg) + 0.05 then
    carnivoreFoodFirstPolicy.lastWaterGainAt = currentTick3
  end

  carnivoreFoodFirstPolicy.lastFood = firstArg
  carnivoreFoodFirstPolicy.lastWater = secondArg

  local choiceFoodLocalValue = Settings.safeMove and Settings.safeMove.active and Settings.safeMove.reason == "foodPercent"
  local choiceConditionalResult = carcassBlocked or safeMoveOff or choiceFoodLocalValue

  if isDinoLifePlaceId
    and Settings.autoQuests
    and firstArg > 80
    and (Settings.characterDinoZone(characterbOther)
      or Settings.questSwimPendingNow and Settings.questSwimPendingNow())
    and not (Settings.dinoCarnivoreFood92CycleActive
      and Settings.dinoCarnivoreFood92CycleActive(characterbOther, firstArg)) then
    choiceConditionalResult = false
  end

  if secondArg >= 70 then
    carnivoreFoodFirstPolicy.waterRescue = false

    if isDinoLifePlaceId and (firstArg < 80 or firstArg < 92 and choiceConditionalResult) then
      return "foodPercent"
    end

    return nil
  end

  if firstArg >= 92 or firstArg >= 80 and not choiceConditionalResult then
    carnivoreFoodFirstPolicy.waterRescue = false
    return "waterPercent"
  end

  if secondArg >= 45 then
    if carnivoreFoodFirstPolicy.waterRescue then
      carnivoreFoodFirstPolicy.foodAttemptAt = currentTick3
    end

    carnivoreFoodFirstPolicy.waterRescue = false
    return "foodPercent"
  end

  local choiceDrinkProgress = Settings.drinkProgress

  if noCarcassAvailable and choiceDrinkProgress and choiceDrinkProgress.confirmed
    and currentTick3 - (tonumber(choiceDrinkProgress.lastProgressAt) or 0) < 6.5 and firstArg > 10 then
    if not carnivoreFoodFirstPolicy.waterRescue then
      carnivoreFoodFirstPolicy.waterRescueAt = currentTick3
    end

    carnivoreFoodFirstPolicy.waterRescue = true
    return "waterPercent"
  end

  if carnivoreFoodFirstPolicy.waterRescue then
    if firstArg <= 8 and secondArg > 5 or firstArg <= 4 and firstArg <= secondArg + 1 then
      carnivoreFoodFirstPolicy.waterRescue = false
      carnivoreFoodFirstPolicy.foodAttemptAt = currentTick3
      return "foodPercent"
    end

    local choiceSafemoveProperty = Settings.safeMove and Settings.safeMove.active
      and (Settings.safeMove.reason == "waterPercent" or Settings.safeMove.reason == "water_search")

    if secondArg > 5 and currentTick3 - (carnivoreFoodFirstPolicy.waterRescueAt or currentTick3) >= 12
      and currentTick3 - (carnivoreFoodFirstPolicy.lastWaterGainAt or currentTick3) >= 8 and not choiceSafemoveProperty then
      carnivoreFoodFirstPolicy.waterRescue = false
      carnivoreFoodFirstPolicy.waterRetryAfter = currentTick3 + 8
      carnivoreFoodFirstPolicy.foodAttemptAt = currentTick3

      return "foodPercent"
    end

    return "waterPercent"
  end

  local foodCheckFailedValue = false

  if secondArg <= 25 and currentTick3 - (carnivoreFoodFirstPolicy.foodAttemptAt or currentTick3) >= 8
    and (choiceFoodLocalValue or carcassBlocked or safeMoveOff) then
    foodCheckFailedValue = Settings.carnivoreCriticalFood(characterbOther)
      and (not recoveryBlocked or currentTick3 - (carnivoreFoodFirstPolicy.lastFoodGainAt or currentTick3) < 6)
  end

  if (secondArg <= 4 and firstArg > secondArg + 1
      or secondArg <= 6 and firstArg > 8
      or secondArg <= 10 and firstArg >= 25
      or secondArg <= 12 and firstArg >= 35
      or secondArg <= 25 and currentTick3 - (carnivoreFoodFirstPolicy.foodAttemptAt or currentTick3) >= 8
        and not foodCheckFailedValue)
    and currentTick3 >= (carnivoreFoodFirstPolicy.waterRetryAfter or 0) then
    carnivoreFoodFirstPolicy.waterRescue = true
    carnivoreFoodFirstPolicy.waterRescueAt = currentTick3
    carnivoreFoodFirstPolicy.lastWaterGainAt = currentTick3

    return "waterPercent"
  end

  return "foodPercent"
end

