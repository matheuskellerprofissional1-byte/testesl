        end
      elseif secondArg.type == "Group" then
        if not Settings.questGroup.localHasActiveGroupTime() and not Settings.questGroup.coop.helperActive then
          return "Group quest has no verified group"
        end
      elseif secondArg.type == "Crescimento" and (tonumber(thirdArg.growthRate) or 0) <= 0 then
        return "Growth quest has no Growth increase"
      end

      return secondArg.type .. " quest made no objective progress"
    end

    function mmbaiUserIntent.QuestTracker.StalledQuest(firstArg, secondArg, blackboardQuest, ...)
      secondArg = tonumber(secondArg) or tick()
      blackboardQuest = blackboardQuest or mmbaiUserIntent.Blackboard

      for questworkLoopIdx, questYieldItem in ipairs(firstArg.active) do
        if questYieldItem.supported ~= false and questYieldItem.current ~= nil and questYieldItem.maximum ~= nil
          and questYieldItem.current < questYieldItem.maximum then
          if questYieldItem.type == "Passive" then
            questYieldItem.waitingReason = "passive quest is time/server driven"
            questYieldItem.lastProgressAt = secondArg
            continue
          end

          local waitingReason = firstArg:WaitingReason(questYieldItem, blackboardQuest)

          if waitingReason then
            questYieldItem.waitingReason = waitingReason
            questYieldItem.lastProgressAt = math.max(questYieldItem.lastProgressAt or secondArg, secondArg - 1)
          else
            questYieldItem.waitingReason = nil
            local timeoutFor = firstArg:TimeoutFor(questYieldItem, blackboardQuest)

            if secondArg - (questYieldItem.lastProgressAt or secondArg) >= timeoutFor then
              local diagnosis = firstArg:Diagnosis(questYieldItem, blackboardQuest)
              questYieldItem.failureReason = diagnosis
              return questYieldItem, timeoutFor, diagnosis
            end
          end
        end
      end

      return nil
    end

