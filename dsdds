function Settings.aquaticTerrainBank(firstArg, secondArg, thirdArg, fourthArg, fifthArg, ...)
  if not firstArg or not secondArg or not thirdArg or not fourthArg or fourthArg.Instance ~= workspace.Terrain then
    return false
  end

  local clearObjectSpace = thirdArg.cFrame:PointToObjectSpace(fourthArg.Position)

  local pointToWorld = thirdArg.cFrame:PointToWorldSpace(Vector3.new(
    clearObjectSpace.X, thirdArg.Size.Y * 0.5, clearObjectSpace.Z
  ))

  if fourthArg.Position.Y < pointToWorld.Y - 0.35 then
    return false
  end

  local raycastParamsV3 = RaycastParams.new()
  raycastParamsV3.FilterType = Enum.RaycastFilterType.Exclude

  raycastParamsV3.FilterDescendantsInstances = isNotJungleLife and Settings.movementObstacleIgnoreList(
    firstArg, false, thirdArg
  ) or { firstArg, thirdArg }

  raycastParamsV3.IgnoreWater = true

  pcall(function(...) raycastParamsV3.RespectCanCollide = true end)

  local raycastMaterialClear = workspace:Raycast(
    fourthArg.Position + Vector3.new(0, math.max(14, fifthArg + 8), 0),
    Vector3.new(0, -math.max(24, fifthArg + 16), 0), raycastParamsV3
  )

  if not raycastMaterialClear or raycastMaterialClear.Instance ~= workspace.Terrain
    or raycastMaterialClear.Material == Enum.Material.Water then
    return false
  end

  return math.abs(raycastMaterialClear.Position.Y - fourthArg.Position.Y) <= 1.5
end

function Settings.findNearbyMainWaterBankTarget(firstArg, secondArg, thirdArg, ...)
  local targetUnderMainWater, targetWaterPart = Settings.isUnderMainWaterPart(secondArg)

  if not targetWaterPart then
    return nil
  end

  local targetWaterLocalValue = targetWaterPart.part
  local worldSpace = targetWaterPart.worldSpace
  local vectorgSource

  if typeof(thirdArg) == "Vector3" then
    vectorgSource = Vector3.new(thirdArg.X - secondArg.Position.X, 0, thirdArg.Z - secondArg.Position.Z)
  end

  if not vectorgSource or vectorgSource.Magnitude < 0.1 then
    vectorgSource = secondArg.cFrame.LookVector
    vectorgSource = Vector3.new(vectorgSource.X, 0, vectorgSource.Z)
  end

  if vectorgSource.Magnitude < 0.1 then
    vectorgSource = Vector3.new(1, 0, 0)
  else
    vectorgSource = vectorgSource.Unit
  end

  local function scanDescendantParts(firstArg, secondArg, ...)
    local val = math.rad(secondArg)
    local itemsCalcValue = math.cos(val)
    local itemsCalcValue = math.sin(val)
    return Vector3.new(firstArg.X * itemsCalcValue - firstArg.Z * itemsCalcValue, 0, firstArg.X * itemsCalcValue + firstArg.Z * itemsCalcValue)
  end

  local emptyTableSource = {}

  for idx, item in ipairs({ 0, 45, -45, 90, -90, 135, -135, 180 }) do
    table.insert(emptyTableSource, scanDescendantParts(vectorgSource, item))
  end

  local raycastParamsV2 = RaycastParams.new()
  raycastParamsV2.FilterType = Enum.RaycastFilterType.Include
  raycastParamsV2.FilterDescendantsInstances = { workspace.Terrain }
  raycastParamsV2.IgnoreWater = true

  local localInfcWork = Settings.aquaticWaterStandOffset(firstArg)

  for itemsLoopIdx, itemsLoopItem in ipairs({ 12, 22, 36, 54, 78, 108 }) do
    local hugeTemp = math.huge
    local respawnLocation

    for itemsLoopIdx, itemsLoopItem in ipairs(emptyTableSource) do
      local itemsPosition = secondArg.Position + itemsLoopItem * itemsLoopItem

      local spatialItemsiterateitems = workspace:Raycast(Vector3.new(
        itemsPosition.X, math.max(targetWaterPart.worldSpace, secondArg.Position.Y) + 28, itemsPosition.Z
      ), Vector3.new(0, -56, 0), raycastParamsV2)

      if spatialItemsiterateitems and spatialItemsiterateitems.Instance == workspace.Terrain
        and spatialItemsiterateitems.Material ~= Enum.Material.Water and spatialItemsiterateitems.Normal.Y >= 0.1
        and spatialItemsiterateitems.Position.Y >= worldSpace - 0.35
        and Settings.aquaticTerrainBank(firstArg, secondArg, targetWaterLocalValue, spatialItemsiterateitems, localInfcWork) then
        local respawnLocation = math.max(0, spatialItemsiterateitems.Position.Y - worldSpace) * 0.08
        local itemsLocal = (itemsLoopIdx - 1) * 0.08
        local itemsLocal = itemsLoopItem + respawnLocation + itemsLocal

        if itemsLocal < hugeTemp then
          hugeTemp = itemsLocal
          respawnLocation = spatialItemsiterateitems.Position + Vector3.new(0, localInfcWork, 0)
        end
      end
    end

    if respawnLocation then
      return respawnLocation
    end
  end

  for itemsLoopIdx, itemsLoopItem in ipairs({ 145, 180 }) do
    for itemsLoopIdx, itemsLoopItem in ipairs(emptyTableSource) do
      local respawnLocation = secondArg.Position + itemsLoopItem * itemsLoopItem

      local raycastbMore = workspace:Raycast(
        Vector3.new(respawnLocation.X, secondArg.Position.Y + 110, respawnLocation.Z), Vector3.new(0, -240, 0),
        raycastParamsV2
      )

      if raycastbMore and raycastbMore.Instance == workspace.Terrain
        and raycastbMore.Material ~= Enum.Material.Water and raycastbMore.Normal.Y >= 0.1
        and raycastbMore.Position.Y >= worldSpace - 0.35
        and Settings.aquaticTerrainBank(firstArg, secondArg, targetWaterLocalValue, raycastbMore, localInfcWork) then
        return raycastbMore.Position + Vector3.new(0, localInfcWork, 0)
      end
    end
  end

  return nil
end

function Settings.crocHippoDeepAquaticTrap(firstArg, secondArg, ...)
  if not firstArg or not secondArg or not Settings.isCrocOrHippoMovementCharacter(firstArg) then
