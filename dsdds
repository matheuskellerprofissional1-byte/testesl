  if humanoidrootpartChild and Settings.dinoCarcassWaterCrossingActive(characterbTarget, humanoidrootpartChild)
    and not Settings.dinoCarcassWater3(characterbTarget, humanoidrootpartChild) then
    return false
  end

  return true
end

function Settings.survivalArbiterChoose(firstArg, secondArg, ...)
  -- KITTY HUB: Se growth está 100%, ignora sobrevivência e vai direto pro reset
  local kittyCharacter = localPlayer.Character
  if kittyCharacter and Settings.autoGrowModeActive and Settings.autoGrowModeActive()
    and Settings.isGrowthComplete(kittyCharacter:GetAttribute("GrowthPercentage")) then
    firstArg = tonumber(firstArg) or 100
    secondArg = tonumber(secondArg) or 100
    -- Só precisa de 10% mínimo para ir ao reset
    if firstArg >= 10 and secondArg >= 10 then
      return nil -- Sem ação de sobrevivência, vai pro reset
    end
  end

  firstArg = tonumber(firstArg) or 100
  secondArg = tonumber(secondArg) or 100
  local survivalLowVitaSetting = Settings.survivalLowVitalPriority(firstArg, secondArg, localPlayer.Character)

  if survivalLowVitaSetting then
    return survivalLowVitaSetting
  end

  local slotParkingAuditSurvivalThresholdConfig3 = Settings.slotParkingAudit10()
  local characterbUpper = localPlayer.Character

  local choosePendingNow = not slotParkingAuditSurvivalThresholdConfig3
      and isDinoLifePlaceId
      and Settings.autoQuests == true
      and characterbUpper ~= nil
      and isValidQuestTarget(characterbUpper)
      and (Settings.characterDinoZone(characterbUpper)
        or Settings.questSwimPendingNow and Settings.questSwimPendingNow())
    or false

  local chooseLocalValue = slotParkingAuditSurvivalThresholdConfig3 or 80
  local conditionalResultAux = slotParkingAuditSurvivalThresholdConfig3 or 70
  local arbiterCondition = slotParkingAuditSurvivalThresholdConfig3 or 92

  if Settings.savannahFlamingoDrinkDue(localPlayer.Character, firstArg, secondArg, noCarcassAvailable == true) then
    return "waterPercent"
  end

  if isDinoLifePlaceId and Settings.autoDrink then
    if Settings.carcassStaleWater ~= localPlayer.Character then
      Settings.carcassStaleWaterHandoffUntil = 0
      Settings.carcassStaleWater = nil
    end

    if secondArg >= 70 then
      Settings.carcassStaleWaterHandoffUntil = 0
      Settings.carcassStaleWater = nil
    elseif tick() < (tonumber(Settings.carcassStaleWaterHandoffUntil) or 0) then
      return "waterPercent"
    elseif Settings.carcassUncommittedWater(firstArg, secondArg) then
      Settings.carcassStaleWaterHandoffUntil = tick() + 90
      Settings.carcassStaleWater = localPlayer.Character
      return "waterPercent"
    end
  end

  if isDinoLifePlaceId and Settings.dinoCarcassWater2(localPlayer.Character) then
    return "foodPercent"
  end

  local chooseFirstChoice = Settings.carnivoreFoodFirstChoice(firstArg, secondArg)

  if chooseFirstChoice then
    return chooseFirstChoice
  end

  if Settings.dinoVerifiedDrinkContinuity(firstArg, secondArg) then
    return "waterPercent"
  end

  local chooseMmbaiProperty = Settings.MMBAI
  local condAuthoritySurvival2 = chooseMmbaiProperty and chooseMmbaiProperty.Authority

  if condAuthoritySurvival2 and type(condAuthoritySurvival2.SurvivalVerdict) == "function" then
    local survivalVerdict = condAuthoritySurvival2:SurvivalVerdict(chooseMmbaiProperty.Blackboard)

    if survivalVerdict and survivalVerdict.selected then
      return survivalVerdict.selected:lower()
    end

    if survivalVerdict and not survivalVerdict.foodNeed and not survivalVerdict.waterNeed
      and not survivalVerdict.foodCommitted and not survivalVerdict.waterCommitted then
      return nil
    end
  end

  local chooseSurvivalOwner = Settings.authoritativeSurvivalOwner()

  local dinoHerbivoreEmergency = Settings.dinoHerbivoreEmergency and Settings.dinoHerbivoreEmergency(
    localPlayer.Character, firstArg, secondArg
  ) or nil

  if dinoHerbivoreEmergency then
    return dinoHerbivoreEmergency
  end

  local afkFoodRefillEnsure = not slotParkingAuditSurvivalThresholdConfig3 and Settings.afkFoodRefillEnsure and Settings.afkFoodRefillEnsure(
    localPlayer.Character, firstArg, "AFK Coin Food arbitration"
  ) or false

  local dinoCarnivoreFood92Due = not slotParkingAuditSurvivalThresholdConfig3 and Settings.dinoCarnivoreFood92Due
      and Settings.dinoCarnivoreFood92Due(localPlayer.Character, firstArg)
    or false

  if chooseSurvivalOwner == "waterPercent" and noCarcassAvailable and secondArg < Settings.questTravelRefillWaterTarget()
    and not Settings.survivalFoodEmergency(firstArg, secondArg) then
    return "waterPercent"
  end

  local autoDrink = chooseSurvivalOwner == "foodPercent" and carcassBlocked and Settings.autoDrink and secondArg < conditionalResultAux
    and not Settings.survivalFoodCommitmentHealthy(localPlayer.Character)

  if chooseSurvivalOwner == "foodPercent"
    and carcassBlocked
    and firstArg < arbiterCondition
    and not (choosePendingNow
      and firstArg > 80
      and not (Settings.dinoCarnivoreFood92CycleActive
        and Settings.dinoCarnivoreFood92CycleActive(localPlayer.Character, firstArg)))
    and not autoDrink
    and not (afkFoodRefillEnsure and Settings.autoDrink and secondArg < conditionalResultAux)
    and not (Settings.autoDrink and secondArg <= 25) then
    return "foodPercent"
  end

  local autoDrink = Settings.autoDrink and secondArg < conditionalResultAux
  local autoEatConfig = Settings.autoEat and firstArg < chooseLocalValue

