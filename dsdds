  end

  if mmbaiConfig then
    drinkTestMore.savedDamageCooldown = mmbaiConfig.cooldownUntil
    mmbaiConfig.cooldownUntil = math.max(mmbaiConfig.cooldownUntil or 0, tick() + 90)
  end

  noCarcassAvailable = false
  emptyReference = nil
  operationTimestamp = nil
  localInglobal2 = nil
