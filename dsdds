    end)

    local futureTimestamp = tick()
    local local = futureTimestamp + 3

    while Settings.alive and tick() < local do
      sixthCheckCondition, localInfdNext, localHealthEject = handleChar()

      if not sixthCheckCondition or sixthCheckCondition ~= drinkTestConfig.character or not localInfdNext or not localHealthEject
        or localHealthEject.Health <= 0 then
