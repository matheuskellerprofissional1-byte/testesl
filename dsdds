    local currentTickBind = tick()
    local maxValInbind = math.max(targetHumanoidRef.MaxHealth, 1)

    if not mmbaiConfig.active and not mmbaiConfig.monitoring and ignored <= maxValInbind * mmbaiConfig.criticalHealthFraction then
      local maxValInbind1 = math.max(secondHealthProperty, fourthHealthProperty, ignored)
      secondHealthProperty = ignored
