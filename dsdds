      if mmbaiConfig.active then
        local resultHazard, resultHazard, hazardVitalsResult = firstArg:Vitals(hazardCheckResult)

        if resultHazard > mmbaiAuthority.Policy.Survival.emergency
          and hazardVitalsResult > mmbaiAuthority.Policy.Survival.emergency then
