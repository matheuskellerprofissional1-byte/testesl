function Settings.movementRaycastIgnoring(firstArg, secondArg, thirdArg, ...)
  if typeof(firstArg) ~= "Vector3" or typeof(secondArg) ~= "Vector3" or not thirdArg then
    return nil
  end

  if thirdArg.FilterType ~= Enum.RaycastFilterType.Exclude then
    return workspace:Raycast(firstArg, secondArg, thirdArg)
  end

  local excludeList = {}

  for instanceIndex, excludedInstance in ipairs(thirdArg.FilterDescendantsInstances or {}) do
    table.insert(excludeList, excludedInstance)
  end

  local carcassesStorageModel = workspace:FindFirstChild("CarcassesStorageModel")

  if carcassesStorageModel then
    table.insert(excludeList, carcassesStorageModel)
  end

  for attemptNumber = 1, 12 do
    thirdArg.FilterDescendantsInstances = excludeList
    local hitResult = workspace:Raycast(firstArg, secondArg, thirdArg)

    if not hitResult then
      return nil
    end

    local carcassModel = Settings.instanceMovementCarcassModel(hitResult.Instance)

    if Settings.movementIsDecorativeGrass and Settings.movementIsDecorativeGrass(hitResult.Instance) then
      local grassesFolder = Settings.movementDecorativeGrasses()
      table.insert(excludeList, grassesFolder or hitResult.Instance)
    elseif Settings.movementIsDinoWaterMossVisual
      and Settings.movementIsDinoWaterMossVisual(hitResult.Instance) then
      table.insert(excludeList, hitResult.Instance)
    elseif carcassModel then
      table.insert(excludeList, carcassModel)
    else
      return hitResult
    end
  end

  return nil
end

