function Settings.survivalFoodCommitmentHealthy(characterbRef, ...)
  characterbRef = characterbRef or localPlayer.Character

  if not characterbRef or characterbRef ~= localPlayer.Character then
    return false
  end

  local healthyDietType = tick()
  local healthySurvivalArbiter = Settings.survivalArbiter

  if healthySurvivalArbiter and healthySurvivalArbiter.owner == "foodPercent"
    and healthyDietType - (tonumber(healthySurvivalArbiter.lastProgressAt) or 0) <= 4 then
    return true
  end

  if Settings.safeMove and Settings.safeMove.active
    and (Settings.safeMove.reason == "foodPercent" or Settings.safeMove.reason == "herbivore_food_recovery")
    and healthyDietType - (tonumber(Settings.safeMove.lastProgressAt) or 0) <= 2.2 then
    return true
  end

  local herbivoreFoodRecovery6 = Settings.herbivoreFoodRecovery

  if herbivoreFoodRecovery6 and herbivoreFoodRecovery6.active
    and herbivoreFoodRecovery6.character == characterbRef
    and healthyDietType - (tonumber(herbivoreFoodRecovery6.lastProgressAt) or 0) <= 2.2 then
    return true
  end

  if not (isNotJungleLife and Settings.isGrowthHerbivore and Settings.isGrowthHerbivore(characterbRef)
    and not utilityHelper(characterbRef) and not conditionCheckCondition(characterbRef) and not isValidQuestTarget(characterbRef)
    and not Settings.isCrocOrHippoMovementCharacter(characterbRef)) then
    if Settings.grassEatAvailable and Settings.grassEatAvailable(characterbRef) then
      return true
    end

    if Settings.eatVisualPromptVisible and Settings.eatVisualPromptVisible() then
      return true
    end
  end

  return false
end

function Settings.carnivoreCriticalFood(characterbSource, ...)
  characterbSource = characterbSource or localPlayer.Character

  if not characterbSource or characterbSource ~= localPlayer.Character or not isValidQuestTarget(characterbSource)
    or not localParentGlobal or not localParentGlobal.Parent then
    return false
  end

  local timeFood = tick()

  if recoveryBlocked and handleSurvivalUpper() then
    return true
  end

  if isDinoLifePlaceId and not recoveryBlocked then
    local carcassRuntimeWatch = Settings.carcassRuntimeWatch

    if Settings.safeMove
      and Settings.safeMove.active == true
      and Settings.safeMove.reason == "foodPercent"
      and carcassRuntimeWatch
      and carcassRuntimeWatch.target == localParentGlobal
      and (timeFood - (tonumber(carcassRuntimeWatch.targetObservedAt) or 0) <= 8
        or timeFood - (tonumber(carcassRuntimeWatch.lastTargetApproachAt) or 0) <= 8) then
      return true
    end

    local healthyAcquireLiveness = Settings.carcassAcquireLiveness

    return safeMoveOff and healthyAcquireLiveness
        and healthyAcquireLiveness.character == characterbSource
        and healthyAcquireLiveness.target == localParentGlobal
        and timeFood - (tonumber(healthyAcquireLiveness.lastProgressAt) or 0) <= 3
      or false
  end

  if Settings.safeMove
    and Settings.safeMove.active == true
    and Settings.safeMove.reason == "foodPercent"
    and timeFood - (tonumber(Settings.safeMove.lastProgressAt) or tonumber(Settings.safeMove.startedAt) or 0)
      <= 3 then
    return true
  end

  local healthyAcquireLiveness = Settings.carcassAcquireLiveness

  if safeMoveOff and healthyAcquireLiveness and healthyAcquireLiveness.character == characterbSource
    and healthyAcquireLiveness.target == localParentGlobal
    and timeFood - (tonumber(healthyAcquireLiveness.lastProgressAt) or 0) <= 3 then
    return true
  end

  return false
end

function Settings.carcassUncommittedWater(firstArg, secondArg, ...)
  if not isDinoLifePlaceId or not Settings.autoDrink or secondArg > 32 or secondArg > firstArg + 2 or not localParentGlobal or recoveryBlocked then
    return false
  end

  local characterbTarget = localPlayer.Character

  if not characterbTarget or not isValidQuestTarget(characterbTarget) then
    return false
  end

  local carnivoreSurvivalLiveness = Settings.carnivoreSurvivalLiveness

  local emergencyWaterak = carnivoreSurvivalLiveness
      and tonumber(carnivoreSurvivalLiveness.lastFoodProgressAt)
    or 0

