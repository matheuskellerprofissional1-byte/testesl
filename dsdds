  if type(possibilityHandlerValue.GetData) == "function" then
    local pcallResultPossibility, possibilityOperationSuccess = pcall(possibilityHandlerValue.GetData)

    if pcallResultPossibility and type(possibilityOperationSuccess) == "table" then
      for realLoopKey, realLoopItem in pairs(possibilityOperationSuccess) do
        if type(realLoopItem) == "table" and type(realLoopItem.AnimalName) == "string"
          and realLoopItem.AnimalName ~= "" and realLoopItem.Owner
          and not Settings.questGroup.samePlayer(realLoopItem.Owner, localPlayer)
          and realLoopItem.JoinRequirements == "AutoAccept" then
          if Settings.questGroup.sameAnimal(realLoopItem.AnimalName, questGroupGetplayeranimal) then
