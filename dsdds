function Settings.antiLagSetAndSave(firstArg, secondArg, thirdArg, ...)
  local antiLagController = Settings.antiLagController

  if not antiLagController or not antiLagController.Active or not firstArg then
    return false
  end

  local locaSavedSave = antiLagController.Saved[firstArg]

  if not locaSavedSave then
    locaSavedSave = {}
    antiLagController.Saved[firstArg] = locaSavedSave
  end

  local locaUseSave = locaSavedSave[secondArg]

  if not locaUseSave then
    local pcallResultSave, setLoopItem = pcall(function(...) return firstArg[secondArg] end)
    local saveLocalValue = getgenv and getgenv() or _G
    local conditionalResultnWork = saveLocalValue and rawget(saveLocalValue, "gethiddenproperty")

    if not pcallResultSave and type(conditionalResultnWork) == "function" then
      pcallResultSave, setLoopItem = pcall(conditionalResultnWork, firstArg, secondArg)
    end

    if not pcallResultSave then
      return false
    end

    locaUseSave = {
      Object = firstArg,
      Property = secondArg,
      Value = setLoopItem,
      UseHiddenSetter = false,
    }

    locaSavedSave[secondArg] = locaUseSave
    antiLagController.Records[#antiLagController.Records + 1] = locaUseSave
  end

  local saveStateFlag = pcall(function(...) firstArg[secondArg] = thirdArg end)

  if not saveStateFlag then
    local conditionalResultV2 = getgenv and getgenv() or _G
    local saveCondition = conditionalResultV2 and rawget(conditionalResultV2, "sethiddenproperty")

    if type(saveCondition) == "function" then
      saveStateFlag = pcall(saveCondition, firstArg, secondArg, thirdArg)

