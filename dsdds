    function mmbaiRecoveryManager.RecoveryManager.EnterVitalFallback(firstArg, secondArg, thirdArg, fourthArg, ...)
      if not secondArg or not secondArg.runtime then
        return false
      end

      local fallbackRuntimeState = secondArg.runtime
      local fallbackCurrentTimestamp = tick()
      local fallbackConditionalResult = secondArg.owner == "Safety" and 8 or 24

      fallbackRuntimeState.vitalFallbackUntil = fallbackCurrentTimestamp + fallbackConditionalResult
      fallbackRuntimeState.circuitOpenUntil = 0
      fallbackRuntimeState.circuitHalfOpen = false
      fallbackRuntimeState.circuitProbeBaselinePending = false
      fallbackRuntimeState.recoveryLevel = 0
      fallbackRuntimeState.consecutiveFailures = 0
      fallbackRuntimeState.levelZeroAt = nil
      fallbackRuntimeState.verificationDeadline = 0
      fallbackRuntimeState.lastRecoveryAt = fallbackCurrentTimestamp
      fallbackRuntimeState.lastProgressAt = fallbackCurrentTimestamp
      fallbackRuntimeState.watchdogFailure = nil
      fallbackRuntimeState.watchdogFailureAt = nil
      fallbackRuntimeState.failureReason = tostring(thirdArg or "vital strategy exhausted")
      fallbackRuntimeState.status = "vital_fallback"
      fallbackRuntimeState.recoveryGeneration = (fallbackRuntimeState.recoveryGeneration or 0) + 1

      if firstArg.activeModule == secondArg.name then
        firstArg.activeModule = nil
      end

      if mmbaiRecoveryManager.WatchdogManager
        and type(mmbaiRecoveryManager.WatchdogManager.ResetModuleProbe) == "function" then
        mmbaiRecoveryManager.WatchdogManager:ResetModuleProbe(secondArg.name, fallbackCurrentTimestamp)
      end

      mmbaiRecoveryManager.Memory:Remember("vital-fallbacks", secondArg.name, fallbackRuntimeState.failureReason, fallbackConditionalResult * 4)

      if type(mmbaiRecoveryManager.RequestWorker) == "function" then
        mmbaiRecoveryManager:RequestWorker(secondArg.name, "vital fallback: " .. fallbackRuntimeState.failureReason, 0.2)
      end

      local boardBoard8 = fourthArg or mmbaiRecoveryManager.Blackboard
      boardBoard8.aiState = "PRIORITIZE"
      boardBoard8.recoveryLevel = 0
      boardBoard8.lastProblem = secondArg.name .. ": " .. fallbackRuntimeState.failureReason
      boardBoard8.currentAction = secondArg.name .. " safe fallback remains active"

      mmbaiRecoveryManager.Blackboard.recoveryLevel = 0

      firstArg.lastRecovery = {
        module = secondArg.name,
        level = 8,
        reason = fallbackRuntimeState.failureReason,
        at = fallbackCurrentTimestamp,
        vitalFallbackUntil = fallbackRuntimeState.vitalFallbackUntil,
      }

      mmbaiRecoveryManager.Telemetry:Push("CircuitBreaker", "vital-fallback", {
        reason = fallbackRuntimeState.failureReason,
        owner = secondArg.owner,
        result = "module kept operational",
      }, "vital-fallback:" .. secondArg.name, secondArg.name
        .. " exhausted one strategy; safe vital fallback kept running")

      return true
    end

    function mmbaiRecoveryManager.RecoveryManager.OpenCircuit(firstArg, secondArg, thirdArg, fourthArg, fifthArg, ...)
      if not secondArg or not secondArg.runtime then
        return false
      end

      local runtimeProperty = secondArg.runtime
      local circuitCurrentTimestamp = tick()

      if secondArg.vital then
        return firstArg:EnterVitalFallback(secondArg, thirdArg, fourthArg)
      end

      runtimeProperty.circuitTrips = math.min(8, (runtimeProperty.circuitTrips or 0) + 1)

      local convertedNumber = math.clamp((tonumber(fifthArg) or 60)
        * 2 ^ math.min(3, math.max(0, runtimeProperty.circuitTrips - 1)), 30, 600)

      local markFailure = mmbaiRecoveryManager.Memory:MarkFailure("module", secondArg.name, thirdArg or runtimeProperty.failureReason
        or "repeated recovery failure", convertedNumber)

      if markFailure and (markFailure.blockedUntil or 0) > circuitCurrentTimestamp then
        convertedNumber = math.max(convertedNumber, markFailure.blockedUntil - circuitCurrentTimestamp)
      end

      runtimeProperty.circuitOpenUntil = circuitCurrentTimestamp + convertedNumber
      runtimeProperty.circuitHalfOpen = false
      runtimeProperty.circuitProbeBaselinePending = false
      runtimeProperty.circuitProbeStartedAt = 0

      runtimeProperty.circuitReason = tostring(thirdArg or runtimeProperty.failureReason
        or "repeated recovery failure")

      runtimeProperty.status = "circuit_open"
      runtimeProperty.recoveryGeneration = (runtimeProperty.recoveryGeneration or 0) + 1
      runtimeProperty.active = false
      runtimeProperty.verificationDeadline = 0
      runtimeProperty.levelZeroAt = nil

      if firstArg.activeModule == secondArg.name then
        firstArg.activeModule = nil
      end

      if mmbaiRecoveryManager.WorkerRequests then
        mmbaiRecoveryManager.WorkerRequests[secondArg.name] = nil
      end

      local circuitOwnerValue = secondArg.owner

      if secondArg.name == "Movement" and mmbaiRecoveryManager.MovementManager and mmbaiRecoveryManager.MovementManager.lease then
        circuitOwnerValue = mmbaiRecoveryManager.MovementManager.lease.owner
      end

      if secondArg.cancelMovementOnCircuit and circuitOwnerValue and mmbaiRecoveryManager.Telemetry then
        mmbaiRecoveryManager.Telemetry:Push("ControlArbiter", "circuit", {
          owner = circuitOwnerValue,
          reason = secondArg.name .. " circuit opened",
          result = "diagnostic only; physical owner not cancelled",
          debounce = 4,
        }, "circuit-no-cancel:" .. tostring(secondArg.name), secondArg.name .. " circuit opened without stealing movement")
      end

      if type(secondArg.onCircuitOpen) == "function" then
        mmbaiRecoveryManager:SafeCall(
          "module.circuit-open:" .. secondArg.name, secondArg.onCircuitOpen,
          fourthArg or mmbaiRecoveryManager.Blackboard, runtimeProperty, convertedNumber
        )
      end

      local boardBoard1 = fourthArg or mmbaiRecoveryManager.Blackboard
      boardBoard1.lastProblem = secondArg.name .. ": " .. runtimeProperty.circuitReason
      boardBoard1.aiState = "SUSPEND"
      boardBoard1.currentAction = string.format("%s circuit open (%.0fs)", secondArg.name, convertedNumber)
      boardBoard1.recoveryLevel = 0

      if not firstArg.activeModule then
        mmbaiRecoveryManager.Blackboard.recoveryLevel = 0
      end

      firstArg.lastRecovery = {
        module = secondArg.name,
        level = 8,
        reason = runtimeProperty.circuitReason,
        at = circuitCurrentTimestamp,
        circuitOpenUntil = runtimeProperty.circuitOpenUntil,
      }

      mmbaiRecoveryManager.Telemetry:Push("CircuitBreaker", "opened", {
        reason = runtimeProperty.circuitReason,
        owner = secondArg.owner,
        result = string.format("%s %.0fs", secondArg.name, convertedNumber),
      }, "module-circuit:" .. secondArg.name, secondArg.name .. " isolated after repeated failures; intent preserved")

      return true
    end

