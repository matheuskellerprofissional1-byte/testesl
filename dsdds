    function mmbaiUserIntent.QuestTracker.TimeoutFor(firstArg, secondArg, blackboardFor, ...)
      blackboardFor = blackboardFor or mmbaiUserIntent.Blackboard

      local forConditionalResult = secondArg.type == "Run" and 32 or secondArg.type == "Swim" and 38
        or secondArg.type == "Zone" and 55 or secondArg.type == "Group" and 105
        or secondArg.type == "Crescimento" and 135 or secondArg.type == "Passive" and 180 or 100

      local characterProperty = blackboardFor.character
          and math.clamp(Settings.movementFootprint(blackboardFor.character), 2, 32)
        or 8

      local timeoutNumValue = math.max(1, tonumber(blackboardFor.maxSpeed) or 12)
      local zoneProperty = secondArg.zone and configValues[secondArg.zone] or Settings.questZoneFarmTarget
      local forDistance = 0

      if typeof(zoneProperty) == "Vector3" and typeof(blackboardFor.respawnLocation) == "Vector3" then
        forDistance = Vector3.new(
          zoneProperty.X - blackboardFor.respawnLocation.X, 0, zoneProperty.Z - blackboardFor.respawnLocation.Z
        ).Magnitude
      end

      local movementRequired = secondArg.movementRequired
          and forDistance / timeoutNumValue * (1.8 + characterProperty / 32)
        or 0

      if secondArg.type == "Crescimento" and (tonumber(blackboardFor.growthRate) or 0) > 0 then
        forConditionalResult = forConditionalResult + 45
      end

      return math.clamp(forConditionalResult + movementRequired, 20, 360)
    end

    function mmbaiUserIntent.QuestTracker.WaitingReason(firstArg, secondArg, thirdArg, ...)
      if not thirdArg.characterAlive then
