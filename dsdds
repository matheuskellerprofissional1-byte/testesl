function Settings.semiAquaticRouteWaterContact(firstArg, secondArg, ...)
  if not Settings.isSemiAquatic(firstArg) or not secondArg then
    return false, nil, nil
  end

  local gameTerrainWaterHeightAt = Settings.gameTerrainWaterHeightAt
      and Settings.gameTerrainWaterHeightAt(secondArg.Position)
    or nil

  if type(gameTerrainWaterHeightAt) == "number" then
    return true, gameTerrainWaterHeightAt, "Terrain"
  end

  local humanoid = firstArg:FindFirstChildOfClass("Humanoid")

  local isCharacterSwimmingState = Settings.isCharacterSwimmingState
      and Settings.isCharacterSwimmingState(firstArg)
    or humanoid and humanoid:GetState() == Enum.HumanoidStateType.Swimming
    or false

  local safeMove = Settings.safeMove and Settings.safeMove.active == true
      and Settings.safeMove.allowWaterTransit == true
      and Settings.safeMove.semiAquaticRouteFlyActive == true
      and Settings.safeMove.semiAquaticRouteFlyCharacter == firstArg
    or false

  local waterLocalValue = false
  local contactStateFlag = nil

  if Settings.isUnderMainWaterPart then
    waterLocalValue, contactStateFlag = Settings.isUnderMainWaterPart(secondArg)
  end

  local gameSwimmingGeometry = safeMove and contactStateFlag and contactStateFlag.insidexFinal == true
      and Settings.gameSwimmingGeometry and Settings.gameSwimmingGeometry(firstArg, secondArg, contactStateFlag.worldSpace)
    or false

  if (isCharacterSwimmingState or safeMove) and (waterLocalValue or gameSwimmingGeometry) and contactStateFlag
    and type(contactStateFlag.worldSpace) == "number" then
    return true, contactStateFlag.worldSpace, "MainWaterPart"
  end

  if (isCharacterSwimmingState or safeMove) and Settings.gameWaterSurfaceHeightAt then
    local contactWaterSurfaceHeight, contactHeightAt = Settings.gameWaterSurfaceHeightAt(secondArg.Position)

    if type(contactWaterSurfaceHeight) == "number"
        and (secondArg.Position.Y < contactWaterSurfaceHeight + 0.75
          or safeMove and Settings.gameSwimmingGeometry and Settings.gameSwimmingGeometry(firstArg, secondArg, contactWaterSurfaceHeight))
      or false then
      return true, contactWaterSurfaceHeight, contactHeightAt or "Global"
    end
  end

  return false, nil, nil
end

