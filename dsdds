      probeCoopState.probeLeft = false
      probeCoopState.probePackName = nil
      probeCoopState.probePackAnimal = nil
      probeCoopState.probePackId = nil

      Settings.questGroup.statusText = "KITTY co-op: Team already confirms group membership"
      return true
