function Settings.slotParkingAudit4(characterSlot, confirmedRootPart, ...)
  local slotParkingAuditConfig6 = Settings.slotParkingAudit

  if not slotParkingAuditConfig6 or slotParkingAuditConfig6.active ~= true then
    return false
  end

  slotParkingAuditConfig6.phase = "reset proof: validate character"
  characterSlot = characterSlot or localPlayer.Character

  confirmedRootPart = confirmedRootPart
    or characterSlot and characterSlot:FindFirstChild("HumanoidRootPart")

  if not characterSlot or not confirmedRootPart or characterSlot ~= localPlayer.Character then
    return false
  end

  slotParkingAuditConfig6.phase = "reset proof: resolve target"
  local resultConfirmed, resultConfirmed, resultConfirmed, confirmedSwitchTarget = Settings.slotSwitchTarget()

  if typeof(resultConfirmed) ~= "Vector3" then
    return false
  end

  if confirmedSwitchTarget and (not resultConfirmed or not resultConfirmed.Parent or resultConfirmed.Name ~= "PrideRockSpawn") then
    return false
  end

  local distanceVec52 = Vector3.new(
    confirmedRootPart.Position.X - resultConfirmed.X, 0, confirmedRootPart.Position.Z - resultConfirmed.Z
  ).Magnitude

  slotParkingAuditConfig6.phase = "reset proof: compute distance"
  local isElephant = Settings.slotSwitchCurrentIsElephant(characterSlot)
  local confirmedMovementFootprint = Settings.movementFootprint and Settings.movementFootprint(characterSlot) or 8

  if distanceVec52 > math.clamp(10 + confirmedMovementFootprint * 0.55, 14, 20) then
    return false
  end

  slotParkingAuditConfig6.phase = "reset proof: dry support"

  if Settings.normalizeDryLandState(characterSlot, confirmedRootPart) then
    return true
  end

  slotParkingAuditConfig6.phase = "reset proof: exclude waterPercent"

  if confirmedRootPart.Position.Y < GameConfig.dangeryForhelper then
    return false
  end

  if Settings.waterCharacter(characterSlot, confirmedRootPart) then
    return false
  end

  if Settings.isDirectWaterContact(confirmedRootPart) then
    return false
  end

  slotParkingAuditConfig6.phase = "reset proof: solid raycast"

  local raycastParamsNext = RaycastParams.new()
  raycastParamsNext.FilterType = Enum.RaycastFilterType.Exclude
  raycastParamsNext.FilterDescendantsInstances = { characterSlot }
  raycastParamsNext.IgnoreWater = false

  local raycastbPrior = workspace:Raycast(
    confirmedRootPart.Position + Vector3.new(0, 4, 0), Vector3.new(0, -26, 0), raycastParamsNext
  )

  if not raycastbPrior or raycastbPrior.Material == Enum.Material.Water then
    return false
  end

  if math.abs(confirmedRootPart.Position.Y - resultConfirmed.Y) > 22 then
    return false
  end

  local targetHumanoidRef = characterSlot:FindFirstChildOfClass("Humanoid")

  if targetHumanoidRef and targetHumanoidRef:GetState() == Enum.HumanoidStateType.Swimming then
    pcall(targetHumanoidRef.ChangeState, targetHumanoidRef, Enum.HumanoidStateType.GettingUp)
  end

  return true
end

