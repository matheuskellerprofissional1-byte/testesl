    end
  end, function(ignored, ...) return tostring(ignored) end)

  if not testTestSmoothMove then
    drinkTestMore.lastError = tostring(testOperationSuccess)
    drinkTestMore.lastResult = "failed"
  end

  local lastError

  if drinkTestMore.cancelRequested then
    lastError = "cancel requested"
  elseif not testTestSmoothMove then
    lastError = drinkTestMore.lastError
  elseif drinkTestMore.lastResult == "water_full" then
    lastError = "waterPercent full"
  else
    lastError = "test complete"
  end

  local finalAntiDrowningRetry = Settings.drinkTestEmergencySurfaceExit(lastError)

  if not finalAntiDrowningRetry then
    finalAntiDrowningRetry = Settings.drinkTestHardEject("final anti-drowning retry")
  end

  if finalAntiDrowningRetry then
    local testUndergroundd = testPlayerCharacter
    local postDrinkLandingWitness = drinkTestMore.postDrinkLandingWitness
    Settings.drinkTestRestoreEnvironment()

    if Settings.terrainEmbedWatch then
      Settings.terrainEmbedWatch.postDrink = postDrinkLandingWitness
      Settings.terrainEmbedWatch.character = localPlayer.Character
      Settings.terrainEmbedWatch.evidenceCharacter = nil
      Settings.terrainEmbedWatch.evidenceCount = 0
      Settings.terrainEmbedWatch.evidenceSince = 0
      Settings.terrainEmbedWatch.evidenceAnchor = nil
      Settings.terrainEmbedWatch.cooldownUntil = tick() + 1
    end

    drinkTestMore.active = false
    drinkTestMore.cancelRequested = false
    drinkTestMore.phase = "idle"

    localGlobal = false

    if isNotJungleLife and testUndergroundd == localPlayer.Character and Settings.safeMovementAnimalKey(testUndergroundd) == "elephant"
      and Settings.elephantHover then
      Settings.drinkTestDryStateStep(Settings.elephantHover, true)
    end

    noCarcassAvailable = false
    emptyReference = nil
    operationTimestamp = nil
    localInglobal2 = nil

    Settings.drinkProgressReset()
    Settings.drinkClearUndergroundMode()
    Settings.questForceFastRecheckUntil = tick() + 20

    if drinkTestMore.lastResult == "failed" or not testTestSmoothMove then
      drinkTestMore.retryAfter = tick() + 20
    else
      drinkTestMore.retryAfter = 0
    end

    strLitInf = testTestSmoothMove and "Underground Drink complete: surface exit confirmed"
      or "Underground Drink aborted safely: " .. tostring(drinkTestMore.lastError or lastError)
  else
    drinkTestMore.lastError = drinkTestMore.lastError
      or "surface exit could not be confirmed because character changed"

    Settings.drinkTestRestoreEnvironment()

    drinkTestMore.active = false
    drinkTestMore.cancelRequested = false
    drinkTestMore.phase = "idle"
    drinkTestMore.retryAfter = tick() + 20

    localGlobal = false
    noCarcassAvailable = false
    emptyReference = nil
    operationTimestamp = nil
    localInglobal2 = nil
    isFalseInf = false
    strLitInf = "Underground Drink recovery transaction ended; survival controller unlocked"
  end

  Settings.drinkTestRender()

  Settings.drinkDiagFinish(string.format(
    "result=%s error=%s surfaceExit=%s hardExitConfirmed=%s", tostring(drinkTestMore.lastResult),
    tostring(drinkTestMore.lastError), tostring(finalAntiDrowningRetry),
    tostring(drinkTestMore.hardExitConfirmed)
  ))
end

local function charHandleChar(...)
