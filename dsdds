function Settings.movementDinoRockEntries(firstArg, ...)
  if not isDinoLifePlaceId then
    return {}
  end

  local dinoRockObstacleCache = Settings.dinoRockObstacleCache
  local movementDinoRocksFolderConfig = Settings.movementDinoRocksFolder()
  local movementDinoSingle = Settings.movementDinoSingleRockModel()
  local timeMove2 = tick()

  if not movementDinoRocksFolderConfig and not movementDinoSingle then
