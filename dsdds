  function Settings.questGroup.coopResumeAfterProbe(firstArg, ...)
    local probeCoopState = Settings.questGroup.coop

    if not probeCoopState.probeLeft then
      return false
    end

    local characterTeamName = Settings.questGroup.getPlayerMMbTeamName(localPlayer)

    if type(characterTeamName) == "string" and type(probeCoopState.probePackName) == "string"
