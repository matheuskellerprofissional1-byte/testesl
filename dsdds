function Settings.mainWaterNearestExitTarget(firstArg, secondArg, ...)
  local targetUnderMainWater, thirdWaterPart = Settings.isUnderMainWaterPart(secondArg)

  if not targetUnderMainWater or not thirdWaterPart then
    return nil, thirdWaterPart
  end

  local localPosition = thirdWaterPart.localPosition

  local waterDataTable = {
    { distance = thirdWaterPart.frameParsedNumber - localPosition.X, axis = "x", sign = 1 },
    { distance = thirdWaterPart.frameParsedNumber + localPosition.X, axis = "x", sign = -1 },
    { distance = thirdWaterPart.convertedNumber - localPosition.Z, axis = "z", sign = 1 },
    { distance = thirdWaterPart.convertedNumber + localPosition.Z, axis = "z", sign = -1 },
  }

  local locaxWater = waterDataTable[1]

  for ibOther = 2, #waterDataTable do
    if waterDataTable[ibOther].distance < locaxWater.distance then
      locaxWater = waterDataTable[ibOther]
    end
  end

  local movementFootpriSetting5 = firstArg and Settings.movementFootprint(firstArg) or 8
  local waterLimit5 = math.clamp(movementFootpriSetting5 * 0.14, 2.5, 4)
  local waterLimit6 = math.clamp(Settings.movementRootClearance(firstArg) * 0.24, 0.65, 1.65)
  local waterLimit7 = math.clamp(localPosition.X, -thirdWaterPart.frameParsedNumber, thirdWaterPart.frameParsedNumber)
  local waterLimit8 = math.clamp(localPosition.Z, -thirdWaterPart.convertedNumber, thirdWaterPart.convertedNumber)

  if locaxWater.axis == "x" then
    waterClampValgValue = locaxWater.sign * (thirdWaterPart.frameParsedNumber + clampedValueDrinkfindmainwaterbank2)
  else
    waterClampValhValue = locaxWater.sign * (thirdWaterPart.convertedNumber + clampedValueDrinkfindmainwaterbank2)
  end

  local vectorgTarget = Vector3.new(waterClampValgValue, thirdWaterPart.infoHalfy + waterClampValfValue, waterClampValhValue)
  return thirdWaterPart.part.cFrame:PointToWorldSpace(vectorgTarget), thirdWaterPart
end

