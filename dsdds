      local partCFrame, halfSize = firstArg.cFrame, firstArg.Size * 0.5

      local xExtent = math.abs(partCFrame.RightVector.X) * halfSize.X
        + math.abs(partCFrame.UpVector.X) * halfSize.Y + math.abs(partCFrame.LookVector.X) * halfSize.Z

      local zExtent = math.abs(partCFrame.RightVector.Z) * halfSize.X
        + math.abs(partCFrame.UpVector.Z) * halfSize.Y + math.abs(partCFrame.LookVector.Z) * halfSize.Z

      for gridX = math.floor((firstArg.Position.X - xExtent - 3) / 64), math.floor((firstArg.Position.X + xExtent + 3) / 64) do
        for gridZ = math.floor((firstArg.Position.Z - zExtent - 3) / 64), math.floor((firstArg.Position.Z + zExtent + 3) / 64) do
