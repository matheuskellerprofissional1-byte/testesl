    or not Settings.characterQuestCanyonBlocked(firstArg) or localGlobal or mmbaiConfig.active or postureInvalid
    or Settings.questGrowthReset.exclusive or Settings.slotSwitchStagingActive == true then
    return false
  end

  secondArg = tonumber(secondArg) or tonumber(firstArg:GetAttribute("Food")) or 100
  thirdArg = tonumber(thirdArg) or tonumber(firstArg:GetAttribute("Water")) or 100

  if Settings.autoEat and secondArg < 50 or Settings.autoDrink and thirdArg < 50 then
    return false
  end

  local flagState13 = false
  local switchDietType = Settings.activeAuthoritativeSurvival()

  if switchDietType == "Food" or carcassBlocked or safeMoveOff or localParentGlobal ~= nil or Settings.questCarnivoreFeeding then
    carcassBlocked = false
    respawnLocation = nil
    nilRefInf = nil
    abortReference = nil

    Settings.questCarnivoreFeeding = false
    Settings.carcassController.cancelRequested = true
    Settings.carcassController.token = Settings.carcassController.token + 1

    safeMoveOff = false
    handleSurvivalValue(true)

    if Settings.forceStopEatingSubState then
      pcall(
        Settings.forceStopEatingSubState, firstArg,
        "Canyon herbivore slot handoff owns movement above 50% Food"
      )
    end

    if Settings.survivalArbiter and Settings.survivalArbiter.owner == "foodPercent" then
      Settings.survivalArbiterComplete("foodPercent")
    end

    flagState13 = true
  end

  if switchDietType == "Water" or noCarcassAvailable then
    if Settings.forceStopActiveDrink then
      pcall(
        Settings.forceStopActiveDrink, firstArg,
        "Canyon herbivore slot handoff owns movement above 50% Water", true
      )
    else
      noCarcassAvailable = false
      emptyReference = nil
      operationTimestamp = nil
    end

    if Settings.survivalArbiter and Settings.survivalArbiter.owner == "waterPercent" then
      Settings.survivalArbiterComplete("waterPercent")
    end

    flagState13 = true
  end

  if Settings.safeMove
    and Settings.safeMove.active
    and (Settings.safeMove.reason == "foodPercent" or Settings.safeMove.reason == "waterPercent"
      or Settings.safeMove.reason == "water_search"
      or Settings.safeMove.reason == "herbivore_food_recovery") then
    Settings.safeMove.cancelToken = Settings.safeMove.cancelToken + 1
    Settings.safeMove.active = false
    Settings.safeMove.target = nil
    Settings.safeMove.reason = nil
    Settings.safeMove.owner = nil
    Settings.safeMove.aiLeaseToken = nil
    Settings.safeMove.landQuestWork = false

    flagState13 = true
  end

  local MMBAISetting9 = Settings.MMBAI
  local movementManagerMore = MMBAISetting9 and MMBAISetting9.MovementManager

  if movementManagerMore and movementManagerMore.lease
    and (movementManagerMore.lease.owner == "Food" or movementManagerMore.lease.owner == "Water")
    and type(movementManagerMore.CancelOwner) == "function" then
    pcall(
      movementManagerMore.CancelOwner, movementManagerMore, movementManagerMore.lease.owner,
      "Tshukudu Canyon herbivore slot handoff", true
    )

    flagState13 = true
  end

  if Settings.survivalArbiter
    and (Settings.survivalArbiter.owner == "foodPercent" or Settings.survivalArbiter.owner == "waterPercent") then
    Settings.survivalArbiterReset("Tshukudu Canyon herbivore slot handoff")
    flagState13 = true
  end

  if MMBAISetting9 and MMBAISetting9.Blackboard then
    MMBAISetting9.Blackboard.survivalVerdict = nil
  end

  if not (Settings.safeMove and Settings.safeMove.active) then
    Settings.busy = false
  end

  return flagState13
end

function Settings.questEnsureCanyon(firstArg, secondArg, charactereTemp, ...)
  if not isNotJungleLife or not Settings.autoQuests or type(firstArg) ~= "table" then
    return false
  end

  charactereTemp = charactereTemp or localPlayer.Character

  if not charactereTemp or not Settings.characterQuestCanyonBlocked(charactereTemp) then
    return false
  end

  secondArg = secondArg or utilityHelper()
  local attrGetQuest = tonumber(charactereTemp:GetAttribute("Food")) or 100
  local workerWaterAttribute = tonumber(charactereTemp:GetAttribute("Water")) or 100

  if localGlobal or mmbaiConfig.active or postureInvalid or Settings.questGrowthReset.exclusive or Settings.questSlots.busy or isFalseInglobal1 then
    autoQuests = "Tshukudu Canyon: waiting for safe herbivore slot handoff"
    return true
  end

  if Settings.autoEat and attrGetQuest < 50 or Settings.autoDrink and workerWaterAttribute < 50 then
    autoQuests = string.format(
      "Tshukudu Canyon: Survival to 50%% before herbivore swap (Food %d%% / Water %d%%)",
      math.floor(attrGetQuest), math.floor(workerWaterAttribute)
    )

    return true
  end

  if Settings.switchQuestCanyon then
    Settings.switchQuestCanyon(charactereTemp, attrGetQuest, workerWaterAttribute)
  end

  local characterNameV2 = charactereTemp:GetAttribute("CharacterName")
  local questFindCanyon2 = Settings.questFindCanyonHerbivoreSlot(secondArg, characterNameV2)

  if Settings.questStopLandAutoRun then
    pcall(
      Settings.questStopLandAutoRun,
      "Tshukudu Canyon requires a compatible herbivore; current Land Auto Run yielded"
    )
  end

  if Settings.safeMove and Settings.safeMove.active and Settings.safeMove.reason == "quest" then
    Settings.safeMove.cancelToken = Settings.safeMove.cancelToken + 1
    Settings.releaseMovementNow(charactereTemp, true)
  end

  isFalseInglobalA2 = false

  Settings.questTravelActive = false
  Settings.questLandInputActive = false
  Settings.questMotionMoving = false
  Settings.questMotionMode = nil
  Settings.autoRunMoveOwnsInput = false
  Settings.questSetWork(false)

  if Settings.questSetLandPermanentWork then
    Settings.questSetLandPermanentWork(false)
  end

  if questFindCanyon2 then
    autoQuests = string.format(
      "Tshukudu Canyon: switching to herbivore %s",
      tostring(questFindCanyon2.AnimalName or questFindCanyon2.CharacterName or "slot")
    )

    strLitInf = "Canyon ZoneTime requires a herbivore; reusing a compatible saved slot"
    Settings.questCanyonSwitchRetryAt = tonumber(Settings.questCanyonSwitchRetryAt) or 0

    if tick() >= Settings.questCanyonSwitchRetryAt then
      if tick() - numLitInf < 20 then
        numLitInf = 0
      end

      Settings.questCanyonSwitchRetryAt = tick() + 1.5

      if Settings.trySwitchToQuestAnimal
        and Settings.trySwitchToQuestAnimal(firstArg, secondArg, questFindCanyon2.AnimalName) then
        Settings.questForceFastRecheckUntil = tick() + 25
        return true
      end
    end

    Settings.questForceFastRecheckUntil = math.max(Settings.questForceFastRecheckUntil or 0, tick() + 8)
    autoQuests = "Tshukudu Canyon: compatible herbivore queued for switch"
    return true
  end

  local workerAnimalName = Settings.questFindCanyon(secondArg)

  if workerAnimalName and Settings.questSlots.creAnimal
    and Settings.questSlots.creAnimal(firstArg, workerAnimalName, secondArg) then
    autoQuests = "Tshukudu Canyon: creating herbivore worker " .. tostring(workerAnimalName)
    strLitInf = "Canyon ZoneTime requires a herbivore; preparing one with the existing quest-slot transaction"
    Settings.questForceFastRecheckUntil = tick() + 25
    return true
  end

  autoQuests = "Tshukudu Canyon pending: no compatible herbivore slot available"
  strLitInf = "Canyon remains pending until a compatible Savannah herbivore can be spawned"
  Settings.questForceFastRecheckUntil = math.max(Settings.questForceFastRecheckUntil or 0, tick() + 10)
  return true
end

function Settings.questFindGroundedSlot(firstArg, secondArg, thirdArg, ...)
  firstArg = firstArg or {}

  if thirdArg ~= false then
    local slotDietType = Settings.questFindHerbivoreSlot(firstArg, false, secondArg)

    if slotDietType then
      return slotDietType
    end
  end

  local slotHerbivoreSlot = Settings.questFindHerbivoreSlot(firstArg, true, secondArg)

  if slotHerbivoreSlot then
    return slotHerbivoreSlot
  end

  local conditionalResult4
  local conditionalResultTwelve

  for slotLoopIdx10, slotextraLoopItem in ipairs(firstArg) do
    if type(slotextraLoopItem) == "table" and slotextraLoopItem.CharacterName ~= secondArg
      and type(slotextraLoopItem.AnimalName) == "string"
      and Settings.questDinoGeneric(slotextraLoopItem.AnimalName)
      and not Settings.questIsFlyingAnimalName(slotextraLoopItem.AnimalName) then
      if isGrowthComplete(slotextraLoopItem.GrowthPercentage) then
        conditionalResultTwelve = conditionalResultTwelve or slotextraLoopItem
      else
        conditionalResult4 = conditionalResult4 or slotextraLoopItem
      end
    end
  end

  if thirdArg == false then
    return conditionalResultTwelve or conditionalResult4
  end

  return conditionalResult4 or conditionalResultTwelve
end

function Settings.questGrowthResetFindTracked(firstArg, secondArg, ...)
  if type(secondArg) ~= "table" then
    return nil
  end

  for growthLoopIdxValue, growthLoopItemValue in ipairs(firstArg or {}) do
    if type(growthLoopItemValue) == "table" then
      if secondArg.uniqueName and growthLoopItemValue.UniqueCharacterName == secondArg.uniqueName
        or secondArg.characterName and growthLoopItemValue.CharacterName == secondArg.characterName then
        return growthLoopItemValue
      end
    end
  end
end

function Settings.questGrowthResetIsZero(firstArg, ...)
  firstArg = tonumber(firstArg)

  if firstArg == nil then
    return false
  end

  if firstArg <= 1 then
    return firstArg <= 0.02
  end

  return firstArg <= 1
end

function Settings.questGrowthResetStageDebt(firstArg, ...)
  local questGrowthReset = Settings.questGrowthReset
  local debtActiveValue = questGrowthReset.active

  if not debtActiveValue then
    return false
  end

  if questGrowthReset.stagingBusy then
    return true
  end

  if tick() < (questGrowthReset.stagingRetryAt or 0) then
    return true
  end

  local charactereYield = localPlayer.Character

  if not charactereYield then
    return true
  end

  local characterNameMore = charactereYield:GetAttribute("CharacterName")

  if type(debtActiveValue.characterName) == "string" and debtActiveValue.characterName ~= ""
    and characterNameMore ~= debtActiveValue.characterName then
    questGrowthReset.stagingRetryAt = tick() + 2
    return true
  end

  if Settings.atSlotSwitchPoint and Settings.atSlotSwitchPoint() then
    questGrowthReset.debtStageCharacterName = debtActiveValue.characterName
    questGrowthReset.debtStageDone = true
    return false
  end

  questGrowthReset.stagingBusy = true
  strLitInf = firstArg or "Growth debt: moving slot to switch point"

  task.spawn(function(...)
    local moveBeforeSlotChange = Settings.moveBeforeSlotChange and Settings.moveBeforeSlotChange()
    questGrowthReset.stagingBusy = false

    if moveBeforeSlotChange then
      questGrowthReset.debtStageCharacterName = debtActiveValue.characterName
      questGrowthReset.debtStageDone = true
      questGrowthReset.stagingRetryAt = 0

      strLitInf = "Growth debt: slot staged at switch point"
    else
      questGrowthReset.debtStageDone = false
      questGrowthReset.stagingRetryAt = tick() + 3
      strLitInf = "Growth debt: staging failed; retrying"
    end

    Settings.questForceFastRecheckUntil = tick() + 8
  end)

  return true
end

function Settings.questGrowthResetMaintain(firstArg, secondArg, ...)
  if GameConfig.name == "JungleLife" then
    return false
  end

  local questGrowthReseSetting = Settings.questGrowthReset.active

  if not questGrowthReseSetting then
    return false
  end

  if questGrowthReseSetting.questOnly == true and type(secondArg) == "table" then
    if Settings.questHasIncompleteGrowth(secondArg) then
      Settings.questGrowthReset.questOnlyCompleteSince = 0
    else
      if (Settings.questGrowthReset.questOnlyCompleteSince or 0) <= 0 then
        Settings.questGrowthReset.questOnlyCompleteSince = tick()
      end

      if tick() - (Settings.questGrowthReset.questOnlyCompleteSince or tick()) >= 2 then
        Settings.questGrowthReset.active = nil
        Settings.questGrowthReset.busy = false
        Settings.questGrowthReset.zoneResetName = nil
        Settings.questGrowthReset.pendingZoneName = nil
        Settings.questGrowthReset.debtStageCharacterName = nil
        Settings.questGrowthReset.debtStageDone = false
        Settings.questGrowthReset.preparing = false
        Settings.questGrowthReset.preparingCharacter = nil
        Settings.questGrowthReset.preparingSince = 0
        Settings.questGrowthReset.stagingRetryAt = 0
        Settings.questGrowthReset.questOnlyCompleteSince = 0
        Settings.questGrowthOwnsCurrent = false
        Settings.questForceFastRecheckUntil = tick() + 12

        autoQuests = "GrowTime complete; quest-only Growth slot released"
        strLitInf = "Quest-only Growth objective complete; slot no longer forced to 100%"
        return false
      end
    end
  end

  firstArg = firstArg or utilityHelper()
  local growthFindTracked = Settings.questGrowthResetFindTracked(firstArg, questGrowthReseSetting)

  if not growthFindTracked then
    Settings.questForceFastRecheckUntil = tick() + 10
    return Settings.questGrowthReset.busy
  end

  if isGrowthComplete(growthFindTracked.GrowthPercentage) then
    if questGrowthReseSetting.questOnly == true
      and Settings.questHasIncompleteGrowth(type(secondArg) == "table" and secondArg or Settings._getAllQuests()) then
      Settings.questGrowthReset.active = nil
      Settings.questGrowthReset.busy = false
      Settings.questGrowthReset.zoneResetName = nil
      Settings.questGrowthReset.debtStageCharacterName = nil
      Settings.questGrowthReset.debtStageDone = false
      Settings.questGrowthReset.stagingRetryAt = 0
      Settings.questGrowthReset.questOnlyCompleteSince = 0
      Settings.questGrowthReset.failedUntil = 0
      Settings.questGrowthReset.lastBlockReason = nil
      Settings.questGrowthReset.takeoverSince = 0
      Settings.questGrowthOwnsCurrent = true
      Settings.questForceFastRecheckUntil = tick() + 30

      autoQuests = "GrowTime still incomplete: same 100% slot queued for immediate reset"
      strLitInf = "Quest Growth cycle reached 100%; final handoff skipped because GrowTime still needs progress"
      return false
    end

    local questZone = Settings.questzoneQuestGrowth()

    if not questZone and (not Settings.atSlotSwitchPoint or not Settings.atSlotSwitchPoint()) then
      Settings.questGrowthResetStageDebt("Growth debt 100%: returning slot to switch point before final handoff")
      return true
    end

    Settings.questGrowthReset.active = nil
    Settings.questGrowthReset.busy = false
    Settings.questGrowthReset.zoneResetName = nil
    Settings.questGrowthReset.pendingZoneName = nil
    Settings.questGrowthReset.debtStageCharacterName = nil
    Settings.questGrowthReset.debtStageDone = false
    Settings.questGrowthReset.stagingRetryAt = 0
    Settings.questGrowthReset.questOnlyCompleteSince = 0

    strLitInf = questZone and "Quest Growth reached 100% inside active Zone; staying in zone"
      or "Quest growth reset slot returned to 100% at switch point"

    Settings.questForceFastRecheckUntil = tick() + 12
    return false
  end

  return true
end

function Settings.questGrowthResetLeaveGame(...)
  if not waitInvokeGlobal then
    return false
  end

  local charactereFinal = localPlayer.Character
  local targetHumanoidRef = charactereFinal and charactereFinal:FindFirstChildOfClass("Humanoid")

  if charactereFinal and targetHumanoidRef and targetHumanoidRef.Health > 0 and not Settings.atSlotSwitchPoint()
    and not Settings.questzoneQuestGrowth() then
    if not Settings.switchPrepareCurrentSlot("Growth reset: PrideRockSpawn required before leaving slot") then
      return false
    end
  end

  if Settings.slotGuardianMarkPlanned then
    Settings.slotGuardianMarkPlanned("intentional script reset", 24)
  end

  if not Settings.slotGuardianInvokePlannedReset() then
    return false
  end

  local gameTimestamp = tick() + 8

  repeat
    task.wait(0.15)
    local targetCharacterRef = localPlayer.Character

    if not charactereFinal or not charactereFinal.Parent
      or not charactereFinal:FindFirstChild("HumanoidRootPart") or targetCharacterRef ~= charactereFinal then
      task.wait(0.45)
      return true
    end
  until tick() >= gameTimestamp

  return true
end

function Settings.questGrowthResetRealBlocker(firstArg, ...)
  if not firstArg or firstArg ~= localPlayer.Character then
    return true, "character unavailable"
  end

  local blockerStateFlag = tonumber(firstArg:GetAttribute("Food")) or 100
  local blockerGrowthAttribute = tonumber(firstArg:GetAttribute("Water")) or 100
  local blockerFoodReady

  if isNotJungleLife and isValidQuestTarget(firstArg) and Settings.completedSavannahCarnivore then
    blockerFoodReady = Settings.completedSavannahCarnivore(firstArg, blockerStateFlag, true) == true
  else
    blockerFoodReady = blockerStateFlag >= Settings.completedSlotResetFloor(firstArg, "foodPercent")
  end

  if not blockerFoodReady then
    return true, "Food below pre-Reset admission contract"
  end

  if blockerGrowthAttribute < Settings.completedSlotResetFloor(firstArg, "waterPercent") then
    return true, "Water below reset safety floor"
  end

  if mmbaiConfig.active then
    return true, "damage recovery active"
  end

  if localGlobal then
    return true, "safety recovery active"
  end

  if postureInvalid then
    return true, "post-drink safety move active"
  end

  if Settings.slotParkingAudit and Settings.slotParkingAudit.active then
    return true, "slot parking audit active"
  end

  if Settings.slotSwitchStagingActive == true or Settings.questSlots and Settings.questSlots.busy
    or Settings.slotGuardian and Settings.slotGuardian.recovering then
    return true, "another Slots transaction active"
  end

  local authority3 = Settings.MMBAI and Settings.MMBAI.Authority

  if authority3 and authority3.exclusive and authority3.currentOwner == "Safety" then
    return true, "Safety authority owns character"
  end

  local movementManagerNext = Settings.MMBAI and Settings.MMBAI.MovementManager

  if movementManagerNext and movementManagerNext.lease and movementManagerNext.lease.owner == "Safety" then
    return true, "protected Safety movement lease active"
  end

  return false, nil
end

