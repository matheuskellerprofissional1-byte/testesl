        return
      end

      if fourthHealthProperty - ignored >= maxValInbind * mmbaiConfig.slowDropFraction then
        local localInbind = fourthHealthProperty
        nilRefInbind = nil
        nilRefInbind1 = nil
        secondHealthProperty = ignored
        fourthHealthProperty = ignored
        timestampInbind = currentTickBind
        task.spawn(mmbaiConfig.recover, firstArg, targetHumanoidRef, localInbind, ignored, "slow", true)
        return
      end
    elseif ignored > secondHealthProperty then
      nilRefInbind = nil
      nilRefInbind1 = nil

