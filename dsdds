    function mmbaiUserIntent.QuestTracker.Classify(firstArg, secondArg, ...)
      local classifyConditionalResult = secondArg and secondArg.props or {}
      local lowerPrior = tostring(classifyConditionalResult.Title or secondArg and secondArg.id or "Quest"):lower()

      if Settings._isSwimQuest(classifyConditionalResult) then
        return "Swim", true, mmbaiUserIntent.Capabilities.Current.swimQuest == true
      end

      if Settings._isLandDistanceQuest(classifyConditionalResult) then
        return "Run", true, mmbaiUserIntent.Capabilities.Current.runQuest == true
      end

      if Settings.findQuestZone(secondArg) then
        return "Zone", true, mmbaiUserIntent.Capabilities.Current.zoneQuest == true
      end

      if lowerPrior:find("group", 1, true) or lowerPrior:find("pack", 1, true) then
        return "Group", false, mmbaiUserIntent.Capabilities.Current.groups == true
      end

      if lowerPrior:find("grow", 1, true) then
        return "Crescimento", false, mmbaiUserIntent.Capabilities.Current.growth == true
      end

      if lowerPrior:find("survive", 1, true) or lowerPrior:find("play", 1, true) then
        return "Passive", false, true
      end

      return tostring(classifyConditionalResult.QuestType or "Generic"), false, mmbaiUserIntent.Capabilities.Current.quests == true
    end

