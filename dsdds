local function handleSurvivalFinal(...)
  if Settings.savedSlotResetPending == true then
    return
  end

  if not shared.__kittyLicenseControl or not shared.__kittyLicenseControl.foodPercent() then
    return
  end

  if Settings.undergroundDrinkWaterLock and Settings.undergroundDrinkWaterLock(localPlayer.Character) then
    return
  end

  if Settings.dinoShorelineRecovery and Settings.dinoShorelineRecovery.active then
    return
  end

  local survivalTargetAlive, localInfcSource = handleChar()

  if Settings.dinoSemiAquatic2
    and Settings.dinoSemiAquatic2(survivalTargetAlive, localInfcSource) then
    return
  end

  if isDinoLifePlaceId and survivalTargetAlive and localInfcSource and Settings.isDinoHerbivore(survivalTargetAlive) then
    if Settings.dinoRockEmergency and Settings.dinoRockEmergency.supervisorActive
      and Settings.dinoRockEmergency.supervisorCharacter == survivalTargetAlive then
      Settings.dinoHerbivoreRetire(
        survivalTargetAlive, localInfcSource, "Auto Eat revalidated open rock topology"
      )
    end

    if Settings.dinoHerbivoreRockClearance and Settings.dinoHerbivoreRockClearance.active then
      return
    end

    local foodPercent = tonumber(survivalTargetAlive:GetAttribute("Food")) or 100
    local waterPercent = tonumber(survivalTargetAlive:GetAttribute("Water")) or 100

    if foodPercent < 92 and waterPercent > 70 and Settings.dinoHerbivoreRock(survivalTargetAlive, localInfcSource) then
      if Settings.dinoHerbivoreStart(
        survivalTargetAlive, localInfcSource, "Food", "Food waiting for safe distance from blocked rocks"
      ) then
        return
      end
    end
  end

  if Settings.dinoRockEmergency and Settings.dinoRockEmergency.supervisorActive
    and Settings.dinoRockEmergency.supervisorCharacter == localPlayer.Character then
    return
  end

  local currentPlayerChar = localPlayer.Character
  local foodLevel2 = currentPlayerChar and tonumber(currentPlayerChar:GetAttribute("Food")) or 100
  local waterLevel2 = currentPlayerChar and tonumber(currentPlayerChar:GetAttribute("Water")) or 100

  if isDinoLifePlaceId
    and currentPlayerChar
    and Settings.autoGrowCurrentSlotComplete(currentPlayerChar)
    and Settings.dinoSlotSwitchExpressReady(currentPlayerChar, foodLevel2, waterLevel2)
    and (Settings.slotSwitchStagingActive == true
      or Settings.MMBAI and Settings.MMBAI.Authority and Settings.MMBAI.Authority.currentOwner == "Slots") then
    return
  end

  if isDinoLifePlaceId and currentPlayerChar and Settings.carnivoreSurvivalLivenessStep then
    pcall(Settings.carnivoreSurvivalLivenessStep, currentPlayerChar, foodLevel2, waterLevel2)
  end

  if currentPlayerChar and Settings.isSavannahFlamingo(currentPlayerChar) then
    carcassBlocked = false
    respawnLocation = nil
    nilRefInf = nil
    abortReference = nil

    if Settings.herbivoreFoodRecovery and Settings.herbivoreFoodRecovery.active
      and Settings.herbivoreFoodRecovery.character == currentPlayerChar and Settings.herbivoreFoodRecoveryFinish then
      Settings.herbivoreFoodRecoveryFinish(
