function Settings.aquaticRiverInfinityFlyExit(firstArg, secondArg, thirdArg, ...)
  if not firstArg or not secondArg or not Settings.isCrocOrHippoMovementCharacter(firstArg) then
    return false
  end

  local targetHumanoidRef = firstArg:FindFirstChildOfClass("Humanoid")

  if not targetHumanoidRef or targetHumanoidRef.Health <= 0 then
    return false
  end

  local exitUnderMainWater, exitWaterPart = Settings.isUnderMainWaterPart(secondArg)

  if not exitWaterPart then
    strLitInf = "Water Fly: MainWaterPart not found"
    return false
  end

  if Settings.crocHippoDeepAquaticTrap and Settings.crocHippoDeepAquaticTrap(firstArg, secondArg)
    and Settings.aquaticHardReseatToDryTerrain then
    if Settings.aquaticHardReseatToDryTerrain(firstArg, secondArg, "deep trap detected before aquatic Fly") then
      return true
    end
  end

  if Settings.mainWaterDryBankReached(firstArg, secondArg, exitWaterPart.part) then
    Settings.aquaticSurvivalResume(firstArg)
    return true
  end

  if not exitUnderMainWater and not (Settings.aquaticRiverEscape and Settings.aquaticRiverEscape.survivalSuspended) then
    return false
  end

  local exitUnderMainWater, findNearbyMain = pcall(Settings.findNearbyMainWaterBankTarget, firstArg, secondArg, thirdArg)

  if not exitUnderMainWater then
    strLitInf = "Aquatic bank scan error: " .. tostring(findNearbyMain)
    return false
  end

  if typeof(findNearbyMain) ~= "Vector3" then
    strLitInf = animalNameResolver.isCharacter(firstArg)
        and "Croc waterPercent exit: no ABOVE-WATER Terrain bank nearby; retrying"
      or "Hippo waterPercent exit: no ABOVE-WATER Terrain bank nearby; retrying"

    return false
  end

  local exitPartProperty = exitWaterPart.part

  Settings.aquaticSurvivalSuspend(firstArg)
  Settings.releaseMovementNow(firstArg, true)

  local aquaticRiverEscape2 = Settings.aquaticRiverEscape

  pcall(function(...)
    local mmbAquaticFlyVelocity = secondArg:FindFirstChild("MMB_AquaticFlyVelocity")

    if mmbAquaticFlyVelocity then
      mmbAquaticFlyVelocity:Destroy()
    end
  end)

  pcall(function(...)
    local mmbAquaticFlyGyro = secondArg:FindFirstChild("MMB_AquaticFlyGyro")

    if mmbAquaticFlyGyro then
      mmbAquaticFlyGyro:Destroy()
    end
  end)

  pcall(function(...)
    local mmbAquaticFlyPosition = secondArg:FindFirstChild("MMB_AquaticFlyPosition")

    if mmbAquaticFlyPosition then
      mmbAquaticFlyPosition:Destroy()
    end
  end)

  local exitAutoRotate = targetHumanoidRef.AutoRotate
  local exitMovementDisabled = firstArg:GetAttribute("MovementDisabled")
  local exitCanCollide = exitPartProperty.CanCollide
  Settings.aquaticFlyEnableFallGuard(firstArg)
  exitPartProperty.CanCollide = false
  local mmbAquaticFlyGyro = Instance.new("BodyGyro")
  local mmbAquaticFlyPosition = Instance.new("BodyPosition")
  mmbAquaticFlyGyro.Name = "MMB_AquaticFlyGyro"
  mmbAquaticFlyPosition.Name = "MMB_AquaticFlyPosition"

  mmbAquaticFlyGyro.P = 90000
  mmbAquaticFlyGyro.MaxTorque = Vector3.new(9000000000, 9000000000, 9000000000)
  mmbAquaticFlyGyro.cFrame = secondArg.cFrame

  mmbAquaticFlyPosition.P = 26000
  mmbAquaticFlyPosition.D = 3200
  mmbAquaticFlyPosition.MaxForce = Vector3.new(900000000, 900000000, 900000000)
  mmbAquaticFlyPosition.Position = secondArg.Position

  mmbAquaticFlyGyro.Parent = secondArg
  mmbAquaticFlyPosition.Parent = secondArg

  aquaticRiverEscape2.bodyGyro = mmbAquaticFlyGyro
  aquaticRiverEscape2.bodyPosition = mmbAquaticFlyPosition
  aquaticRiverEscape2.bodyVelocity = nil

  strLitInf = animalNameResolver.isCharacter(firstArg) and string.format(
    "Croc waterPercent respawnLocation-control START · bank %.0f studs", (findNearbyMain - secondArg.Position).Magnitude
  ) or string.format(
    "Hippo waterPercent respawnLocation-control START · bank %.0f studs", (findNearbyMain - secondArg.Position).Magnitude
  )

  pcall(function(...)
    targetHumanoidRef.PlatformStand = true
    targetHumanoidRef.AutoRotate = false
  end)

  firstArg:SetAttribute("MovementDisabled", true)
  local magnitudecWork = (findNearbyMain - secondArg.Position).Magnitude
  local constrainedValue41 = tick() + math.clamp(magnitudecWork / 50 + 2.5, 3, 12)
  local riverIsFalse = false
  local riverNumLit = 0
  local positionbTarget = secondArg.Position
  local exitTimestamp = tick()

  local exitUnderMainWater, operationSuccessV3 = pcall(function(...)
    while Settings.alive and firstArg.Parent and secondArg.Parent and targetHumanoidRef.Parent
      and targetHumanoidRef.Health > 0 and tick() < constrainedValue41 do
      local currentTimestampSub = tick()

      if currentTimestampSub >= riverNumLit then
        riverNumLit = currentTimestampSub + 0.125

        if Settings.mainWaterDryBankReached(firstArg, secondArg, exitPartProperty) then
          riverIsFalse = true
          break
        end
      end

      local exitWorldPosition = findNearbyMain - secondArg.Position
      local currentTimestampAux = tick()
      local constrainedValue28 = math.clamp(currentTimestampAux - exitTimestamp, 0.0083333333333333, 0.05)
      exitTimestamp = currentTimestampAux
      local locaMagnitudeExit = findNearbyMain - positionbTarget

      if locaMagnitudeExit.Magnitude > 0.05 then
        local clampResult2 = math.clamp(locaMagnitudeExit.Magnitude * 2, 10, 50)
        local exitMinResult = math.min(locaMagnitudeExit.Magnitude, clampResult2 * constrainedValue28)
        positionbTarget = positionbTarget + locaMagnitudeExit.Unit * exitMinResult
      else
        positionbTarget = findNearbyMain
      end

      mmbAquaticFlyPosition.Position = positionbTarget
      local vectorgUpper = Vector3.new(findNearbyMain.X - secondArg.Position.X, 0, findNearbyMain.Z - secondArg.Position.Z)

      if vectorgUpper.Magnitude > 0.2 then
        mmbAquaticFlyGyro.cFrame = cFrame.lookAt(
          secondArg.Position, secondArg.Position + vectorgUpper.Unit, Vector3.yAxis
        )
      end

      secondArg.AssemblyLinearVelocity = secondArg.AssemblyLinearVelocity * 0.18
      secondArg.AssemblyAngularVelocity = Vector3.zero

      strLitInf = animalNameResolver.isCharacter(firstArg)
          and string.format(
            "Croc waterPercent respawnLocation-control -> nearby bank (%.0f)", exitWorldPosition.Magnitude
          )
        or string.format("Hippo waterPercent respawnLocation-control -> nearby bank (%.0f)", exitWorldPosition.Magnitude)

      runService.Heartbeat:Wait()
    end
  end)

  if not riverIsFalse and secondArg and secondArg.Parent and Settings.mainWaterDryBankReached(firstArg, secondArg, exitPartProperty) then
    riverIsFalse = true
  end

  pcall(function(...)
    if mmbAquaticFlyPosition and mmbAquaticFlyPosition.Parent then
      mmbAquaticFlyPosition:Destroy()
    end
  end)

  pcall(function(...)
    if mmbAquaticFlyGyro and mmbAquaticFlyGyro.Parent then
      mmbAquaticFlyGyro:Destroy()
    end
  end)

  aquaticRiverEscape2.bodyPosition = nil
  aquaticRiverEscape2.bodyVelocity = nil
  aquaticRiverEscape2.bodyGyro = nil

  if secondArg and secondArg.Parent then
    secondArg.AssemblyLinearVelocity = Vector3.zero
    secondArg.AssemblyAngularVelocity = Vector3.zero
  end

  pcall(function(...)
    targetHumanoidRef.PlatformStand = false
    targetHumanoidRef.AutoRotate = exitAutoRotate ~= false
    targetHumanoidRef:ChangeState(Enum.HumanoidStateType.GettingUp)
  end)

  if exitMovementDisabled == nil then
    firstArg:SetAttribute("MovementDisabled", false)
  else
    firstArg:SetAttribute("MovementDisabled", exitMovementDisabled)
  end

  if exitPartProperty and exitPartProperty.Parent then
    if Settings.isCrocOrHippoMovementCharacter(firstArg) then
      exitPartProperty.CanCollide = true
    else
      exitPartProperty.CanCollide = exitCanCollide
    end
  end

  if riverIsFalse then
    for ibPrior = 1, 2 do
      runService.Heartbeat:Wait()
    end
  end

  Settings.aquaticFlyDisableFallGuard()

  if riverIsFalse then
    Settings.aquaticSurvivalResume(firstArg)

    strLitInf = animalNameResolver.isCharacter(firstArg) and "Croc waterPercent Fly OFF: outside MainWaterPart"
      or "Hippo waterPercent Fly OFF: outside MainWaterPart"

    return true
  end

  if secondArg and secondArg.Parent and Settings.crocHippoDeepAquaticTrap
    and Settings.crocHippoDeepAquaticTrap(firstArg, secondArg) and Settings.aquaticHardReseatToDryTerrain then
    if Settings.aquaticHardReseatToDryTerrain(
      firstArg, secondArg, "smooth aquatic Fly made no valid dry-bank exit"
    ) then
      return true
    end
  end

  if not exitUnderMainWater then
    strLitInf = "Aquatic Fly error: " .. tostring(operationSuccessV3)
  else
    strLitInf = animalNameResolver.isCharacter(firstArg) and "Croc waterPercent Fly timed out; retrying later"
      or "Hippo waterPercent Fly timed out; retrying later"
  end

  return false
end

function Settings.moveAquaticToDryTerrain(firstArg, secondArg, thirdArg, ...)
  if not firstArg or not secondArg then
    return false
  end

  if Settings.landSlopeAssist and Settings.landSlopeAssist.busy then
    return false
  end

  local aquaticRiverEscapeConfig = Settings.aquaticRiverEscape

  if aquaticRiverEscapeConfig.busy then
    return false
  end

  if tick() < (aquaticRiverEscapeConfig.retryAt or 0) then
    return false
  end

  if Settings.nonAquaticDryBankConfirmed(firstArg, secondArg) then
    if isDinoLifePlaceId and Settings.dinoShorelineResetProbe then
      Settings.dinoShorelineResetProbe()
    end

    return
  end

  if Settings.isCrocOrHippoMovementCharacter(firstArg) then
    local terrainUnderMainWater, terrainWaterPart = Settings.isUnderMainWaterPart(secondArg)

    if terrainWaterPart and Settings.mainWaterDryBankReached(firstArg, secondArg, terrainWaterPart.part) then
      Settings.aquaticSurvivalResume(firstArg)
      aquaticRiverEscapeConfig.retryAt = 0
      return true
    end

    local terrainAquatica = aquaticRiverEscapeConfig.survivalSuspended == true

    if not terrainUnderMainWater and not terrainAquatica then
      return false
    end

    aquaticRiverEscapeConfig.busy = true
    local flyExit = Settings.aquaticRiverInfinityFlyExit(firstArg, secondArg, thirdArg)

    aquaticRiverEscapeConfig.busy = false
    aquaticRiverEscapeConfig.retryAt = flyExit and 0 or tick() + 2.5

    return flyExit
  end

  local terrainExit = Settings.findAquaticDryTerrainExit(firstArg, secondArg, thirdArg)

  if not terrainExit then
    return false
  end

  handleSurvival(firstArg, true)

  local terrainAquaticd = isPositionReachable(terrainExit, 7, nil, {
    purpose = "safety",
    tolerance = math.clamp(Settings.movementFootprint(firstArg) * 0.65, 8, 15),
    vertical = false,
    forceMoveToLand = true,
    constantSpeed = true,
    stopOnDryGround = true,
    maxDuration = 180,
  })

  firstArg, secondArg = handleChar()

  if terrainAquaticd and firstArg and secondArg and Settings.normalizeDryLandState(firstArg, secondArg) then
    handleSurvival(firstArg, false)
    Settings.releaseMovementNow(firstArg, true)
    return true
