          owner = refreshScoreOwner,
          result = "forwarded to Supervisor Authority",
          debounce = 10,
        }, "watchdog-eat-drink-deadlock", "Watchdog conflict forwarded to Supervisor")
      end

      local locRefresh

      for refreshLoopKey, refreshLoopItem in pairs(firstArg.records) do
        if refreshLoopItem.active and (not locRefresh or refreshLoopItem.startedAt < locRefresh.startedAt) then
          locRefresh = refreshLoopItem
        end
      end

      firstArg.current = locRefresh

      secondArg.activeWatchdog = locRefresh and locRefresh.name or "None"
      secondArg.lastWatchdog = locRefresh and locRefresh.reason or nil

      if strLitInf ~= firstArg.lastRuntimeMessage then
