  local function helperbRef(...)
    local mmbaiModuleRegistry = Settings.MMBAI
    mmbaiModuleRegistry.ModuleRegistry = { modules = {}, order = {} }

    function mmbaiModuleRegistry.ModuleRegistry.Register(firstArg, secondArg, thirdArg, ...)
      if type(secondArg) ~= "string" or secondArg == "" or type(thirdArg) ~= "table" then
        return nil, "invalid module registration"
      end

      if firstArg.modules[secondArg] then
        return nil, "module already registered"
      end

      thirdArg.name = secondArg
      thirdArg.owner = thirdArg.owner or secondArg
      thirdArg.priority = tonumber(thirdArg.priority) or 0
      thirdArg.dependencies = thirdArg.dependencies or {}
      thirdArg.conflicts = thirdArg.conflicts or {}
      thirdArg.interruptible = thirdArg.interruptible ~= false
      thirdArg.cancelMovementOnCircuit = thirdArg.cancelMovementOnCircuit ~= false

      if thirdArg.vital == nil then
        thirdArg.vital = thirdArg.owner == "Safety" or thirdArg.owner == "Water" or thirdArg.owner == "Food"
      else
        thirdArg.vital = thirdArg.vital == true
      end

      if thirdArg.needsMovement == nil then
        thirdArg.needsMovement = thirdArg.owner == "Safety" or thirdArg.owner == "Water"
          or thirdArg.owner == "Food" or thirdArg.owner == "Quest" or thirdArg.owner == "Crescimento"
          or thirdArg.owner == "Slots"
      else
        thirdArg.needsMovement = thirdArg.needsMovement == true
      end

      thirdArg.objective = thirdArg.objective or secondArg

      thirdArg.runtime = {
        active = false,
        activeSince = 0,
        lastProgressAt = tick(),
        lastValue = nil,
        lastExpected = nil,
        status = "idle",
        failureReason = nil,
        recoveryLevel = 0,
        consecutiveFailures = 0,
        lastRecoveryAt = 0,
        verificationDeadline = 0,
        circuitOpenUntil = 0,
        circuitHalfOpen = false,
        circuitProbeBaselinePending = false,
        circuitProbeStartedAt = 0,
        circuitReason = nil,
        circuitTrips = 0,
        vitalFallbackUntil = 0,
        recoveryGeneration = 0,
      }

      firstArg.modules[secondArg] = thirdArg
      table.insert(firstArg.order, secondArg)

      mmbaiModuleRegistry.Telemetry:Push("ModuleRegistry", "registered", {
        reason = secondArg,
        owner = thirdArg.owner,
      })

      return thirdArg
    end

    function mmbaiModuleRegistry.ModuleRegistry.Get(firstArg, secondArg, ...)
      return firstArg.modules[secondArg]
    end

    function mmbaiModuleRegistry.ModuleRegistry.Desired(firstArg, secondArg, thirdArg, ...)
      if type(secondArg) ~= "table" then
        return false
      end

      if type(secondArg.enabled) == "function" then
        local resultDesired, safeCall = mmbaiModuleRegistry:SafeCall(
          "module.enabled:" .. tostring(secondArg.name), secondArg.enabled, thirdArg
        )

        return resultDesired and safeCall == true
      end

      return secondArg.enabled == true
    end

    function mmbaiModuleRegistry.ModuleRegistry.CircuitBlocked(firstArg, secondArg, thirdArg, ...)
      if type(secondArg) ~= "table" or type(secondArg.runtime) ~= "table" then
        return false, 0
      end

      thirdArg = tonumber(thirdArg) or tick()
      local blockedRuntimeState = secondArg.runtime
      local resultBlocked, resultBlocked, circuitIsFalse = false, 0, nil

      if not secondArg.vital then
        resultBlocked, resultBlocked, circuitIsFalse = mmbaiModuleRegistry.Memory:IsBlocked("module", secondArg.name)
      end

      if resultBlocked then
        blockedRuntimeState.circuitOpenUntil = math.max(blockedRuntimeState.circuitOpenUntil or 0, thirdArg + resultBlocked)
        blockedRuntimeState.circuitReason = blockedRuntimeState.circuitReason or circuitIsFalse
      end

      local circuitopenuntilProperty = (blockedRuntimeState.circuitOpenUntil or 0) - thirdArg

      if circuitopenuntilProperty > 0 then
        return true, circuitopenuntilProperty, blockedRuntimeState.circuitReason
      end

      if (blockedRuntimeState.circuitOpenUntil or 0) > 0 then
        blockedRuntimeState.circuitOpenUntil = 0
        blockedRuntimeState.circuitHalfOpen = true
        blockedRuntimeState.circuitProbeBaselinePending = true
