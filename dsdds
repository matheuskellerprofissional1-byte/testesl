function mmbaiConfig.preserveManualMove(moveReason, ...)
  local safeMoveOther = Settings.safeMove

  if not safeMoveOther then
    return nil
  end

  local moveStateFlag = safeMoveOther.active == true and safeMoveOther.reason == "manual"
    and typeof(safeMoveOther.target) == "Vector3"

  local movementap = safeMoveOther.manualRequestPending == true
    and typeof(safeMoveOther.manualPendingTarget) == "Vector3"

  if not moveStateFlag and not movementap then
    return nil
  end

  local moveConditionalResult = moveStateFlag and safeMoveOther.target or safeMoveOther.manualPendingTarget

  local moveDataTable = {
    goal = "Manual Move",
    owner = "Manual",
    target = moveConditionalResult,
    manualLabel = moveStateFlag and (safeMoveOther.manualLabel or safeMoveOther.manualPendingLabel)
      or safeMoveOther.manualPendingLabel or "resumed destination",
    manualCancelledAt = tonumber(safeMoveOther.manualCancelledAt) or 0,
    animal = localPlayer.Character and localPlayer.Character:GetAttribute("AnimalName") or nil,
    slot = Settings.currentSlotIndex,
    at = tick(),
    damagePreserved = true,
    reason = moveReason,
  }

  safeMoveOther.manualRequestPending = true
  safeMoveOther.manualPendingTarget = moveConditionalResult
  safeMoveOther.manualPendingLabel = moveDataTable.manualLabel

  local goalManager = Settings.MMBAI and Settings.MMBAI.GoalManager

  if goalManager and type(goalManager.suspended) == "table" then
    for moveIterator = #goalManager.suspended, 1, -1 do
      if goalManager.suspended[moveIterator].goal == "Manual Move" then
        table.remove(goalManager.suspended, moveIterator)
      end
    end

    table.insert(goalManager.suspended, moveDataTable)

    while #goalManager.suspended > 8 do
      table.remove(goalManager.suspended, 1)
    end
  end

  return moveDataTable
end

function mmbaiConfig.deferResumePreservedManual(firstArg, secondArg, ...)
  if type(firstArg) ~= "table" or typeof(firstArg.target) ~= "Vector3" then
