  end

  helper(function(...)
    task.wait(0.12)

    if not Settings.alive or mmbaiConfig.active or mmbaiConfig.monitoring then
      return
    end

    local safeMovePrior = Settings.safeMove

    if not safeMovePrior then
      return
    end

    if (tonumber(safeMovePrior.manualCancelledAt) or 0)
      > math.max(tonumber(firstArg.manualCancelledAt) or 0, tonumber(firstArg.at) or 0) then
      return
    end

    local goalManager = Settings.MMBAI and Settings.MMBAI.GoalManager

    if goalManager and type(goalManager.Resume) == "function" then
      pcall(
        goalManager.Resume, goalManager, Settings.MMBAI.Blackboard,
        secondArg or "damage watchdog released Manual Move"
      )
    end
  end)
end

