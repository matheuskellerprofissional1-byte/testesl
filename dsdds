          and not (Settings.questIsFlyingAnimalName(questGroupGetplayeranimal3)
            and (Settings.questBlockFlying or (Settings.questPendingLandCount or 0) > 0)) then
          if Settings.questGroup.findOwnedSlot(firstArg, questGroupGetplayeranimal3)
            or #firstArg < (Settings.questSlots.maxSlots or 40) then
            return true
          end
        end
      end
    end
