function Settings.findNearestDryWaterExit(firstArg, secondArg, thirdArg, ...)
  if not firstArg then
    return nil
  end

  local positionbSource = firstArg.Position
  local exitWaterLocalValue = localPlayer.UserId % 360 * math.pi / 180

  local function scanDescendantParts(firstArg, secondArg, ...)
    local hugeValue = math.huge
    local localInfcValue

    for idx, item in ipairs(firstArg) do
      for itemsIdx2 = 0, secondArg - 1 do
        local val = exitWaterLocalValue + itemsIdx2 / secondArg * math.pi * 2
        local itemsCalcValue = positionbSource.X + math.cos(val) * item
        local itemsCalcValue = positionbSource.Z + math.sin(val) * item

        local raycast = workspace:Raycast(
          Vector3.new(itemsCalcValue, positionbSource.Y + 90, itemsCalcValue), Vector3.new(0, -220, 0), raycastParams
        )

        if raycast and raycast.Material ~= Enum.Material.Water and raycast.Normal.Y >= 0.4 then
          local respawnLocation = raycast.Position + Vector3.new(0, 2.5, 0)
          local itemsIsTrue = true

          for itemsLoopIdx, itemsLoopItem in ipairs(type(secondArg) == "table" and secondArg or { secondArg }) do
            if typeof(itemsLoopItem) == "Vector3"
              and Vector3.new(respawnLocation.X - itemsLoopItem.X, 0, respawnLocation.Z - itemsLoopItem.Z).Magnitude < 22 then
              itemsIsTrue = false
              break
            end
          end

          if itemsIsTrue and not conditionCheckCondition(respawnLocation, 2.5, 3) and Settings.waterExitPointIsTrulyDry(respawnLocation)
            and not Settings.dinoNavigationBarrier9(respawnLocation, localPlayer.Character, 0) then
            local respawnLocation = item + math.abs(raycast.Position.Y - positionbSource.Y) * 0.65

            if respawnLocation < hugeValue then
              hugeValue = respawnLocation
              localInfcValue = respawnLocation
            end
          end
        end
      end

      if localInfcValue then
        return localInfcValue
      end
    end

    return nil
  end

  local local = scanDescendantParts({ 6, 10, 16, 24 }, 8)

  if local then
    return local
  end

  local local = scanDescendantParts({ 34, 48, 66, 90, 120, 150 }, 12)

  if local then
    return local
  end

  if thirdArg and isNotJungleLife then
    local local = scanDescendantParts({ 185, 230, 290 }, 16)

    if local then
      return local
    end
  end

  if typeof(secondArg) == "Vector3" then
    return Settings.findNearestDryWaterExit(firstArg)
  end

  return nil
end

function Settings.savannahFoodDryBankExit(firstArg, secondArg, thirdArg, ...)
  if not isNotJungleLife or not firstArg or not secondArg or not secondArg.active or secondArg.token ~= thirdArg then
    return false
  end

  local bankConfirmed, localPositionFood2, localMoveFood = handleChar()

  if bankConfirmed ~= firstArg or not localPositionFood2 or not localMoveFood then
    return false
  end

  if Settings.nonAquaticDryBankConfirmed(firstArg, localPositionFood2) then
    secondArg.waterExitActive = false
    return true
  end

  secondArg.waterExitActive = true

  if not secondArg.waterExitStartedAt or secondArg.waterExitStartedAt <= 0 then
    secondArg.waterExitStartedAt = tick()
  end

  local failedWaterExits = secondArg.failedWaterExits or {}
  secondArg.failedWaterExits = failedWaterExits
  local currentWaterExitTarget = secondArg.currentWaterExitTarget

  if typeof(currentWaterExitTarget) ~= "Vector3" then
    currentWaterExitTarget = Settings.findNearestDryWaterExit(localPositionFood2, failedWaterExits, true)
  end

  if typeof(currentWaterExitTarget) ~= "Vector3" then
    if tick() - (secondArg.lastWaterExitResetAt or 0) >= 12 then
      secondArg.failedWaterExits = {}
      secondArg.lastWaterExitResetAt = tick()
    end

    strLitInf = "Food recovery: no dry bank in local scan; rescanning"
    return false
  end

  Settings.releaseMovementNow(firstArg, true)
  local currentTimestampMain = tick()
  local hugeWork = math.huge
  local locFood = currentTimestampMain

  while Settings.alive and secondArg.active and secondArg.token == thirdArg and localPlayer.Character == firstArg
    and tick() - currentTimestampMain < 9 do
    bankConfirmed, localPositionFood2, localMoveFood = handleChar()

    if bankConfirmed ~= firstArg or not localPositionFood2 or not localMoveFood or localMoveFood.Health <= 0 then
      break
    end

    if Settings.nonAquaticDryBankConfirmed(firstArg, localPositionFood2) then
      pcall(localMoveFood.Move, localMoveFood, Vector3.zero, false)

      secondArg.failedWaterExits = {}
      secondArg.currentWaterExitTarget = nil
      secondArg.waterExitActive = false
      secondArg.waterExitStartedAt = 0
      secondArg.lastProgressAt = tick()

      strLitInf = "Food recovery: dry bank confirmed; resuming grass search"
      return true
    end

    local vectorgRef = Vector3.new(
      currentWaterExitTarget.X - localPositionFood2.Position.X, 0,
      currentWaterExitTarget.Z - localPositionFood2.Position.Z
    )

    local targetDistance = vectorgRef.Magnitude

    if targetDistance + 0.65 < hugeWork then
      hugeWork = targetDistance
      locFood = tick()
      secondArg.lastProgressAt = tick()

      if tick() > currentTimestampMain then
        secondArg.lastWaterApproachAt = tick()
      end
    end

    if targetDistance <= 1.5 or tick() - locFood >= 2.5 then
      break
    end

    Settings.moveToWorldSteer(firstArg, localPositionFood2, vectorgRef)
    firstArg:SetAttribute("MovementDisabled", false)
    pcall(localMoveFood.Move, localMoveFood, vectorgRef.Unit, false)
    strLitInf = "Food recovery: swimming toward a dry bank"
    runService.Heartbeat:Wait()
  end

  if localMoveFood then
    pcall(localMoveFood.Move, localMoveFood, Vector3.zero, false)
  end

  if not secondArg.active or secondArg.token ~= thirdArg then
    return false
  end

  bankConfirmed, localPositionFood2 = handleChar()

  if bankConfirmed == firstArg and localPositionFood2 and Settings.nonAquaticDryBankConfirmed(firstArg, localPositionFood2) then
    secondArg.failedWaterExits = {}
    secondArg.currentWaterExitTarget = nil
    secondArg.waterExitActive = false
    secondArg.waterExitStartedAt = 0
    secondArg.lastProgressAt = tick()

    return true
  end

  if tick() - locFood < 1.5 and hugeWork > 1.5 then
    secondArg.currentWaterExitTarget = currentWaterExitTarget
    strLitInf = "Food recovery: crossing wide waterPercent toward dry bank"
    return false
  end

  secondArg.currentWaterExitTarget = nil

  if #failedWaterExits >= 7 then
    table.remove(failedWaterExits, 1)
  end

  table.insert(failedWaterExits, currentWaterExitTarget)
  strLitInf = "Food recovery: bank blocked; selecting another dry exit"
  return false
end

