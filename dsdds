      secondHealthProperty = ignored
      nilRefInbind = nil
      nilRefInbind1 = nil
      fourthHealthProperty = math.max(fourthHealthProperty, ignored)
      return
    end

    if ignored > fourthHealthProperty then
      fourthHealthProperty = ignored
      timestampInbind = currentTickBind
    elseif currentTickBind - timestampInbind > mmbaiConfig.slowWindowSeconds then
      fourthHealthProperty = math.max(ignored, secondHealthProperty)
