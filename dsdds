      firstArg.activeGeneration = firstArg.activeGeneration + 1
      triggerRuntimeState.recoveryGeneration = (triggerRuntimeState.recoveryGeneration or 0) + 1
      local recoveryGeneration = triggerRuntimeState.recoveryGeneration

      triggerRuntimeState.consecutiveFailures = (triggerRuntimeState.consecutiveFailures or 0) + 1
