      if hazardCheckResult.dangerousWater == true
        and not locSafe
        and not hazardCheckResult.drinking
        and not hazardCheckResult.intentionalWaterTransit
        and not (isDinoLifePlaceId and Settings.dinoShorelineFoodOwnerActive()
          and not Settings.dinoShorelineRecovery.deadlocked) then
