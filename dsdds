          return timeoutQuestTracker <= mmbaiAuthority.Policy.Survival.critical and 8
            or timeoutQuestTracker <= mmbaiAuthority.Policy.Survival.emergency and 11 or 14
        end

        return timeoutQuestTracker <= mmbaiAuthority.Policy.Survival.critical and 5.5
          or timeoutQuestTracker <= mmbaiAuthority.Policy.Survival.emergency and 8 or 10
      end

      if secondArg == "Water" then
        return timeoutVitalsResult <= mmbaiAuthority.Policy.Survival.critical and 8
          or timeoutVitalsResult <= mmbaiAuthority.Policy.Survival.emergency and 11 or 14
      end

      if secondArg == "Manual" then
        return 9
      end

      if secondArg == "Quest" then
        return 12
      end

      if secondArg == "Crescimento" then
        return 14
      end

      if secondArg == "Slots" then
        return 12
