  end

  local pcallResultPack, packOperationSuccess = pcall(firstArg.GetData)

  if not pcallResultPack or type(packOperationSuccess) ~= "table" then
    return nil
  end

  local bestDataTable1

  for bestLoopKey, secondBestItem in pairs(packOperationSuccess) do
    if type(secondBestItem) == "table" and type(secondBestItem.AnimalName) == "string"
      and secondBestItem.AnimalName ~= "" and secondBestItem.Owner
      and not Settings.questGroup.samePlayer(secondBestItem.Owner, localPlayer)
      and secondBestItem.JoinRequirements == "AutoAccept" then
