  local waterPromptVisible = carcassBlocked or Settings.eatStopPromptVisible and Settings.eatStopPromptVisible()
    or waterSafemoveProperty == "foodPercent" or waterSafemoveProperty == "herbivore_food_recovery"
    or Settings.herbivoreFoodRecovery and Settings.herbivoreFoodRecovery.active

  if not isNotJungleLife or not characterbMore or characterbMore ~= localPlayer.Character
    or Settings.isSavannahFlamingo(characterbMore) or not Settings.autoEat
    or not Settings.isGrowthHerbivore(characterbMore) or utilityHelper(characterbMore) or conditionCheckCondition(characterbMore)
    or isValidQuestTarget(characterbMore) or Settings.isCrocOrHippoMovementCharacter(characterbMore) or not foodSurvivalTransaction
    or not waterPromptVisible then
    return false
  end

  local waterFoodTarget = Settings.questTravelRefillFoodTarget()

  if secondArg >= waterFoodTarget then
    waterSurvivalArbiter.suspendedFoodCommitment = nil
    return false
  end

  waterSurvivalArbiter.suspendedFoodCommitment = {
    character = characterbMore,
    target = waterFoodTarget,
    sourcePosition = typeof(respawnLocation) == "Vector3" and respawnLocation
      or characterbMore:FindFirstChild("HumanoidRootPart")
        and characterbMore.HumanoidRootPart.Position
      or nil,
    suspendedAt = tick(),
    reason = thirdArg or "Water temporarily preempted committed Food",
  }

  if Settings.MMBAI and Settings.MMBAI.Blackboard then
    Settings.MMBAI.Blackboard.survivalVerdict = nil
  end

  return true
end

