        if Settings.questhandoffGrowthFood(preemptionAllowed.character, resultPreemption) then
          return false, "healthy Growth Food refill finishes before Quest"
        end

        return true, "verified Quest locomotion intent supersedes idle Growth"
      end

      if preemptionVitalsResult <= 0.2 and secondArg == "Safety" then
        return true, "critical health"
      end

      if secondArg == "Manual"
        and (thirdArg == "Quest" or thirdArg == "Crescimento" or thirdArg == "AFkCoins" or thirdArg == "Movement") then
        return true, "user Manual Move requested"
      end

      return false, nil
    end

