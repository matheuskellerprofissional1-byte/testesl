function Settings.dinoCarnivoreForce(firstArg, secondArg, thirdArg, ...)
  if not isDinoLifePlaceId or not firstArg or firstArg ~= localPlayer.Character or not isValidQuestTarget(firstArg)
    or secondArg ~= "Food" and secondArg ~= "Water" then
    return false
  end

  if secondArg == "Food" and Settings.dinoSemiAquatic2
    and Settings.dinoSemiAquatic2(firstArg, firstArg:FindFirstChild("HumanoidRootPart")) then
    return false
  end

  if secondArg == "Water" and Settings.dinoCarcassWater2(firstArg) then
    return false
  end

  local executorAttribute = tonumber(firstArg:GetAttribute("Food")) or 100
  local executorWaterAttribute = tonumber(firstArg:GetAttribute("Water")) or 100

  if Settings.survivalArbiterChoose(executorAttribute, executorWaterAttribute) ~= string.lower(secondArg) then
    return false
  end

  local MMBAIConfig12 = Settings.MMBAI
  local executorLocalValue = MMBAIConfig12 and MMBAIConfig12.Authority

  if secondArg == "Water" then
    if Settings.carcassWaterTransit and Settings.carcassWaterTransit.active then
      Settings.carcassWaterTransitReset()
    end

    if Settings.safeMove and Settings.safeMove.active and Settings.safeMove.reason == "foodPercent" then
      Settings.safeMove.cancelToken = Settings.safeMove.cancelToken + 1
      Settings.safeMove.active = false
      Settings.safeMove.target = nil
      Settings.safeMove.reason = nil
      Settings.safeMove.owner = nil
    end

    Settings.carcassController.cancelRequested = true
    Settings.carcassController.token = Settings.carcassController.token + 1

    safeMoveOff = false
    carcassBlocked = false
    respawnLocation = nil
    nilRefInf = nil
    abortReference = nil

    if Settings.forceStopEatingSubState then
      pcall(
        Settings.forceStopEatingSubState, firstArg,
        thirdArg or "Dino Water preempted stalled Food executor"
      )
    end

    noCarcassAvailable = true

    if Settings.drinkSearch then
      Settings.drinkSearch.retryAfter = 0
      Settings.drinkSearch.failedCount = 0
    end
  else
    if Settings.safeMove and Settings.safeMove.active
      and (Settings.safeMove.reason == "waterPercent" or Settings.safeMove.reason == "water_search") then
      Settings.safeMove.cancelToken = Settings.safeMove.cancelToken + 1
      Settings.safeMove.active = false
      Settings.safeMove.target = nil
      Settings.safeMove.reason = nil
      Settings.safeMove.owner = nil
    end

    if Settings.forceStopActiveDrink then
      pcall(
        Settings.forceStopActiveDrink, firstArg, thirdArg or "Dino Food preempted stalled Water executor"
      )
    else
      noCarcassAvailable = false
      emptyReference = nil
      drinkingStuckSince = nil
    end

    carcassBlocked = true
    survivalBaseValue = 0
  end

  if not (Settings.safeMove and Settings.safeMove.active) and not mmbaiConfig.active and not localGlobal then
    Settings.busy = false
  end

  Settings.survivalArbiterReset(thirdArg or "Dino " .. secondArg .. " executor liveness reset")

  Settings.survivalArbiterAcquire(
    string.lower(secondArg), executorAttribute, executorWaterAttribute, thirdArg or "Dino " .. secondArg .. " executor liveness"
  )

  if executorLocalValue then
    if type(executorLocalValue.ForceCancelOwner) == "function" then
      local physicalOwner = executorLocalValue:PhysicalOwner(MMBAIConfig12.Blackboard)

      if physicalOwner and physicalOwner ~= secondArg and physicalOwner ~= "Safety"
        and physicalOwner ~= "Slots" then
        pcall(
          executorLocalValue.ForceCancelOwner, executorLocalValue, physicalOwner,
          "Dino Survival liveness -> " .. secondArg
        )
      end
    end

    if type(executorLocalValue.Signal) == "function" then
      executorLocalValue:Signal("DinoVitalExecutor:" .. secondArg, secondArg, thirdArg or "Dino Survival has no physical executor", (secondArg == "Water" and executorWaterAttribute <= 35 or secondArg == "Food" and executorAttribute <= 35)
          and 995
        or 975, 4)
    end

    if type(executorLocalValue.ClearHandoffIfReleased) == "function" then
      pcall(executorLocalValue.ClearHandoffIfReleased, executorLocalValue, MMBAIConfig12.Blackboard)
    end

    if type(executorLocalValue.Elect) == "function" then
      pcall(executorLocalValue.Elect, executorLocalValue, MMBAIConfig12.Blackboard)
    end
  end

  Settings.dinoCarnivoreClearOrphanBusy(firstArg, secondArg)

  if MMBAIConfig12 and type(MMBAIConfig12.RequestWorker) == "function" then
    pcall(
      MMBAIConfig12.RequestWorker, MMBAIConfig12, secondArg == "Water" and "AutoDrink" or "AutoEat",
      thirdArg or "Dino " .. secondArg .. " liveness forced worker restart", 0.01
    )
  end

  return true
end

function Settings.carnivoreSurvivalLivenessStep(firstArg, secondArg, thirdArg, ...)
  local carnivoreLivenessTracker = Settings.carnivoreSurvivalLiveness

  if not isDinoLifePlaceId or not carnivoreLivenessTracker or not firstArg or firstArg ~= localPlayer.Character
    or not Settings.autoEat or not isValidQuestTarget(firstArg) or Settings.isSavannahFlamingo(firstArg) then
    Settings.carnivoreSurvivalLivenessReset(firstArg)
    return false
  end

  local humanoidRootPartYield = firstArg:FindFirstChild("HumanoidRootPart")
  local stepChildRef = firstArg:FindFirstChildOfClass("Humanoid")

  if not humanoidRootPartYield or not stepChildRef or stepChildRef.Health <= 0 then
    Settings.carnivoreSurvivalLivenessReset(firstArg)
    return false
  end

  secondArg = tonumber(secondArg) or tonumber(firstArg:GetAttribute("Food")) or 100
  thirdArg = tonumber(thirdArg) or tonumber(firstArg:GetAttribute("Water")) or 100
  local currentTime = tick()

  if Settings.survivalArbiterChoose(secondArg, thirdArg) == "foodPercent" and Settings.dinoSemiAquatic2
    and Settings.dinoSemiAquatic2(firstArg, humanoidRootPartYield) then
    carnivoreLivenessTracker.lastMotionAt = currentTime
    carnivoreLivenessTracker.lastMeaningfulMotionAt = currentTime
    carnivoreLivenessTracker.lastFoodProgressAt = currentTime
    carnivoreLivenessTracker.motionAnchor = humanoidRootPartYield.Position
    carnivoreLivenessTracker.motionAnchorAt = currentTime

    return false
  end

  if carnivoreLivenessTracker.character ~= firstArg then
    Settings.carnivoreSurvivalLivenessReset(firstArg)

    carnivoreLivenessTracker.character = firstArg
    carnivoreLivenessTracker.lastFood = secondArg
    carnivoreLivenessTracker.lastWater = thirdArg
    carnivoreLivenessTracker.lastPosition = humanoidRootPartYield.Position
    carnivoreLivenessTracker.lastFoodProgressAt = currentTime
    carnivoreLivenessTracker.lastWaterProgressAt = currentTime
    carnivoreLivenessTracker.lastMotionAt = currentTime

    return false
  end

  if carnivoreLivenessTracker.lastFood == nil
    or secondArg > carnivoreLivenessTracker.lastFood + 0.02 then
    carnivoreLivenessTracker.lastFoodProgressAt = currentTime
    carnivoreLivenessTracker.repairs = 0
  end

  if carnivoreLivenessTracker.lastWater == nil
    or thirdArg > carnivoreLivenessTracker.lastWater + 0.02 then
    carnivoreLivenessTracker.lastWaterProgressAt = currentTime
  end

  carnivoreLivenessTracker.lastFood = secondArg
  carnivoreLivenessTracker.lastWater = thirdArg

  local arbiterChoose3 = Settings.survivalArbiterChoose(secondArg, thirdArg)

  if carnivoreLivenessTracker.motionOwner ~= arbiterChoose3
    or typeof(carnivoreLivenessTracker.motionAnchor) ~= "Vector3" then
    carnivoreLivenessTracker.motionOwner = arbiterChoose3
    carnivoreLivenessTracker.motionAnchor = humanoidRootPartYield.Position
    carnivoreLivenessTracker.motionAnchorAt = currentTime
    carnivoreLivenessTracker.lastMeaningfulMotionAt = currentTime
  end

  if typeof(carnivoreLivenessTracker.motionAnchor) == "Vector3" then
    if Vector3.new(
      humanoidRootPartYield.Position.X - carnivoreLivenessTracker.motionAnchor.X, 0,
      humanoidRootPartYield.Position.Z - carnivoreLivenessTracker.motionAnchor.Z
    ).Magnitude >= 3.25 then
      carnivoreLivenessTracker.lastMeaningfulMotionAt = currentTime
      carnivoreLivenessTracker.lastMotionAt = currentTime
      carnivoreLivenessTracker.motionAnchor = humanoidRootPartYield.Position
      carnivoreLivenessTracker.motionAnchorAt = currentTime
    elseif currentTime - (tonumber(carnivoreLivenessTracker.motionAnchorAt) or currentTime) >= 3 then
      carnivoreLivenessTracker.motionAnchor = humanoidRootPartYield.Position
      carnivoreLivenessTracker.motionAnchorAt = currentTime
    end
  end

  carnivoreLivenessTracker.lastPosition = humanoidRootPartYield.Position

  local stepSafemoveProperty = Settings.safeMove and Settings.safeMove.active
    and (Settings.safeMove.reason == "waterPercent" or Settings.safeMove.reason == "water_search")
    and typeof(Settings.safeMove.target) == "Vector3"

  if stepSafemoveProperty then
    local targetProperty = Settings.safeMove.target

    local magnitudecTarget = Vector3.new(
      targetProperty.X - humanoidRootPartYield.Position.X, 0, targetProperty.Z - humanoidRootPartYield.Position.Z
    ).Magnitude

    if typeof(carnivoreLivenessTracker.waterRouteTarget) ~= "Vector3"
      or (carnivoreLivenessTracker.waterRouteTarget - targetProperty).Magnitude > 2 then
      carnivoreLivenessTracker.waterRouteTarget = targetProperty
      carnivoreLivenessTracker.waterRouteBestDistance = magnitudecTarget
      carnivoreLivenessTracker.waterRouteAnchor = humanoidRootPartYield.Position
    elseif not carnivoreLivenessTracker.waterRouteActive then
      carnivoreLivenessTracker.waterRouteAnchor = humanoidRootPartYield.Position
    elseif (typeof(carnivoreLivenessTracker.waterRouteAnchor) == "Vector3" and Vector3.new(
      humanoidRootPartYield.Position.X - carnivoreLivenessTracker.waterRouteAnchor.X, 0,
      humanoidRootPartYield.Position.Z - carnivoreLivenessTracker.waterRouteAnchor.Z
    ).Magnitude or 0) >= 0.85 and magnitudecTarget <= (carnivoreLivenessTracker.waterRouteBestDistance or math.huge) - 0.75 then
      carnivoreLivenessTracker.waterRouteBestDistance = magnitudecTarget
      carnivoreLivenessTracker.waterRouteAnchor = humanoidRootPartYield.Position
      carnivoreLivenessTracker.lastWaterApproachAt = currentTime
    end

    carnivoreLivenessTracker.waterRouteActive = true
  else
    carnivoreLivenessTracker.waterRouteActive = false
  end

  if mmbaiConfig.active or localGlobal or postureInvalid or Settings.questGrowthReset.exclusive
    or Settings.slotSwitchStagingActive == true
    or Settings.aquaticRiverEscape and Settings.aquaticRiverEscape.survivalSuspended
    or Settings.dinoPostDrinkExit and Settings.dinoPostDrinkExit.active then
    carnivoreLivenessTracker.lastMotionAt = currentTime
    carnivoreLivenessTracker.lastFoodProgressAt = currentTime
    return false
  end

  local stepCurrentOwner = Settings.MMBAI and Settings.MMBAI.Authority and Settings.MMBAI.Authority.currentOwner
    or nil

  if stepCurrentOwner == "Safety" or stepCurrentOwner == "Slots" and secondArg > 30 and thirdArg > 30 then
    return false
  end

  if arbiterChoose3 == "waterPercent" and Settings.autoDrink then
    if stepSafemoveProperty and stepCurrentOwner == "Water" then
      return false
    end

    local safeMoveSetting10 = Settings.safeMove and Settings.safeMove.active
      and (Settings.safeMove.reason == "waterPercent" or Settings.safeMove.reason == "water_search")
      and currentTime - (tonumber(carnivoreLivenessTracker.lastWaterApproachAt) or 0) <= 6

    local confirmed = noCarcassAvailable and Settings.drinkProgress and Settings.drinkProgress.confirmed
      and currentTime - (tonumber(Settings.drinkProgress.lastProgressAt) or currentTime) < 6.5

    local drinkTransactionProtected = noCarcassAvailable and Settings.drinkTransactionProtected
      and Settings.drinkTransactionProtected(firstArg)

    if safeMoveSetting10 or confirmed or drinkTransactionProtected
      or currentTime - (tonumber(carnivoreLivenessTracker.lastWaterProgressAt) or 0) <= 2.5 then
      return false
    end

    if thirdArg < 70 then
      if currentTime - math.max(
        tonumber(carnivoreLivenessTracker.lastWaterProgressAt) or 0,
        stepSafemoveProperty and (tonumber(carnivoreLivenessTracker.lastWaterApproachAt) or 0) or 0
      ) >= (stepSafemoveProperty and 6 or thirdArg <= 30 and 2 or thirdArg <= 45 and 2.8 or 4) and currentTime - (tonumber(carnivoreLivenessTracker.lastRepairAt) or 0) >= 4.5 then
        carnivoreLivenessTracker.lastRepairAt = currentTime
        carnivoreLivenessTracker.lastWaterWakeAt = currentTime

        local safeMoveSetting9 = Settings.safeMove and Settings.safeMove.active
            and tostring(Settings.safeMove.reason or "unknown")
          or "none"

        local vitalExecutor = Settings.dinoCarnivoreForce(
          firstArg, "Water", "Carnivore Water priority had no real movement/drink progress"
        )

        if Settings.slotGuardianNoteWaterRepair then
          pcall(Settings.slotGuardianNoteWaterRepair, firstArg, vitalExecutor, safeMoveSetting9)
        end

        if not vitalExecutor then
          strLitInf = "Dino Water liveness: handoff rejected; waiting for valid owner"
          return false
        end

        carnivoreLivenessTracker.motionOwner = "waterPercent"
        carnivoreLivenessTracker.motionAnchor = humanoidRootPartYield.Position
        carnivoreLivenessTracker.motionAnchorAt = currentTime

        strLitInf = "Dino Water liveness: worker requested; checking real movement"
        return true
      end

      if currentTime - (tonumber(carnivoreLivenessTracker.lastWaterWakeAt) or 0) >= 1.25 then
        carnivoreLivenessTracker.lastWaterWakeAt = currentTime

        if Settings.drinkSearch then
          Settings.drinkSearch.retryAfter = 0
        end

        if Settings.MMBAI and type(Settings.MMBAI.RequestWorker) == "function" then
          pcall(
            Settings.MMBAI.RequestWorker, Settings.MMBAI, "AutoDrink", "Carnivore Water liveness wake",
            0.01
          )
        end
      end
    end

    return false
  end

  if not (secondArg < 80 or carcassBlocked or Settings.questCarnivoreFeeding or localParentGlobal ~= nil or closestFood ~= nil) then
    Settings.carnivoreSurvivalLivenessReset(firstArg)
    return false
  end

  local safeMoveSetting2 = Settings.safeMove and Settings.safeMove.active and Settings.safeMove.reason == "foodPercent"
    and currentTime - (tonumber(carnivoreLivenessTracker.lastMeaningfulMotionAt) or 0) <= 3

  if localParentGlobal and not recoveryBlocked then
    safeMoveSetting2 = Settings.carnivoreCriticalFood(firstArg)
  end

  if localParentGlobal and localParentGlobal.Parent and Settings.carcassAcquireLiveness
    and Settings.carcassAcquireLiveness.target == localParentGlobal then
    safeMoveSetting2 = safeMoveSetting2
      or currentTime - (tonumber(Settings.carcassAcquireLiveness.lastProgressAt) or 0) <= 3
  end

  if safeMoveSetting2 then
    return false
  end

  local stepPromptReady = Settings.carcassEatPromptReady and Settings.carcassEatPromptReady(firstArg)
    or false

  if stepPromptReady
    and currentTime - (tonumber(carnivoreLivenessTracker.lastFoodProgressAt) or currentTime) < 5.5 then
    return false
  end

  local limitValue27 = math.max(tonumber(carnivoreLivenessTracker.lastFoodProgressAt) or 0, localParentGlobal and not recoveryBlocked and Settings.carcassRuntimeWatch
      and Settings.carcassRuntimeWatch.target == localParentGlobal
      and (tonumber(Settings.carcassRuntimeWatch.lastTargetApproachAt) or 0)
    or tonumber(carnivoreLivenessTracker.lastMeaningfulMotionAt)
    or 0, localParentGlobal and Settings.carcassAcquireLiveness
      and Settings.carcassAcquireLiveness.target == localParentGlobal
      and tonumber(Settings.carcassAcquireLiveness.lastProgressAt)
    or 0)

  local stepSurvivalLocalValue = secondArg <= 35 and 2.6 or secondArg <= 50 and 3.4 or secondArg <= 65 and 4.5 or 6

  if currentTime - limitValue27 < stepSurvivalLocalValue then
    return false
  end

  if currentTime - (tonumber(carnivoreLivenessTracker.lastRepairAt) or 0) < 1.5 then
    return false
  end

  carnivoreLivenessTracker.lastRepairAt = currentTime
  carnivoreLivenessTracker.repairs = (tonumber(carnivoreLivenessTracker.repairs) or 0) + 1

  if Settings.safeMove and Settings.safeMove.active and Settings.safeMove.reason == "foodPercent" then
    Settings.safeMove.cancelToken = Settings.safeMove.cancelToken + 1
    Settings.safeMove.active = false
    Settings.safeMove.target = nil
    Settings.safeMove.reason = nil
    Settings.safeMove.owner = nil
  end

  if safeMoveOff and not stepPromptReady then
    Settings.carcassController.cancelRequested = true
    Settings.carcassController.token = Settings.carcassController.token + 1
    safeMoveOff = false
  end

  if localParentGlobal and not recoveryBlocked then
    checkConditionSource(localParentGlobal, 10)
    handleSurvivalValue(true)
  end

  survivalBaseValue = 0
  nilRefInglobalA2 = nil

  if not (Settings.safeMove and Settings.safeMove.active) and not mmbaiConfig.active and not localGlobal then
    Settings.busy = false
  end

  carcassBlocked = true
  abortReference = currentTime

  Settings.dinoCarnivoreForce(
    firstArg, "Food", "Carnivore Food due without verified movement/eating progress"
  )

  strLitInf = recoveryBlocked and "Carnivore Food liveness: retrying SAME committed carcass immediately"
    or "Carnivore Food liveness: idle Food executor repaired; searching carcass immediately"

  carnivoreLivenessTracker.lastMotionAt = currentTime
  carnivoreLivenessTracker.lastFoodProgressAt = currentTime

  return true
end

