function Settings.applySurvivalDefaults(firstArg, ...)
  local automationRequested = firstArg == true or Settings.survivalAutomationRequested()
  local userIntent = Settings.MMBAI and Settings.MMBAI.UserIntent
  local autoEatManualDisabledSetting
  local autoDrinkManualDisabledSetting

  if automationRequested then
    autoEatManualDisabledSetting = Settings.autoEatManualDisabled ~= true
    autoDrinkManualDisabledSetting = Settings.autoDrinkManualDisabled ~= true
  else
    autoEatManualDisabledSetting = Settings.autoEat == true
    autoDrinkManualDisabledSetting = Settings.autoDrink == true

    if userIntent and type(userIntent.values) == "table" then
      autoEatManualDisabledSetting = userIntent.values.autoEat == true
      autoDrinkManualDisabledSetting = userIntent.values.autoDrink == true
    end

    autoEatManualDisabledSetting = autoEatManualDisabledSetting and Settings.autoEatManualDisabled ~= true
    autoDrinkManualDisabledSetting = autoDrinkManualDisabledSetting and Settings.autoDrinkManualDisabled ~= true
  end

  if Settings.autoGrowModeActive and Settings.autoGrowModeActive() == true or Settings.questPostGrowAll == true
    or Settings.questGrowthOwnsCurrent == true then
    Settings.autoEatManualDisabled = false
    Settings.autoDrinkManualDisabled = false

    autoEatManualDisabledSetting = true
    autoDrinkManualDisabledSetting = true
  end

  local dinoVitalRescue = Settings.dinoVitalRescue

  if dinoVitalRescue then
    local playerCharacter = localPlayer.Character

    if dinoVitalRescue.character ~= playerCharacter or not playerCharacter
      or Settings.questGrowthReset and Settings.questGrowthReset.exclusive then
      Settings.dinoVitalRescue = nil
    else
      if dinoVitalRescue.foodPercent and Settings.autoEatManualDisabled ~= true
        and (tonumber(playerCharacter:GetAttribute("Food")) or 100) < 80 then
        autoEatManualDisabledSetting = true
      else
        dinoVitalRescue.foodPercent = nil
      end

      if dinoVitalRescue.waterPercent and Settings.autoDrinkManualDisabled ~= true
        and (tonumber(playerCharacter:GetAttribute("Water")) or 100) < 70 then
        autoDrinkManualDisabledSetting = true
      else
        dinoVitalRescue.waterPercent = nil
      end

      if not dinoVitalRescue.foodPercent and not dinoVitalRescue.waterPercent then
        Settings.dinoVitalRescue = nil
      end
    end
  end

  if Settings.aquaticRiverEscape and Settings.aquaticRiverEscape.survivalSuspended then
    Settings.aquaticRiverEscape.resumeAutoEat = autoEatManualDisabledSetting
    Settings.aquaticRiverEscape.resumeAutoDrink = autoDrinkManualDisabledSetting
    Settings.autoEat = false
    Settings.autoDrink = false

    return false
  end

  Settings.autoEat = autoEatManualDisabledSetting == true
  Settings.autoDrink = autoDrinkManualDisabledSetting == true

  return Settings.autoEat or Settings.autoDrink
end

