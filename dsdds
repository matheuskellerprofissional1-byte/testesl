  local testPlayerCharacter, testTestSmoothMove, localHealthTest = handleChar()

  if not testPlayerCharacter or not testTestSmoothMove or not localHealthTest or localHealthTest.Health <= 0 then
    strLitInf = "Underground Drink: no valid character"
    Settings.drinkDiagFinish(strLitInf)
    return
  end

  if Settings.isCrocOrHippoMovementCharacter(testPlayerCharacter) then
    strLitInf = "Manual Drink Below test unavailable for Crocodile/Hippo"
    Settings.drinkDiagFinish(strLitInf)
    return
  end

  if Settings.elephantHoverStop then
    Settings.elephantHoverStop()
  end

  drinkTestMore.active = true
  drinkTestMore.cancelRequested = false
  drinkTestMore.hardExitBusy = false
  drinkTestMore.hardExitConfirmed = false
  drinkTestMore.phase = "prepare"
  drinkTestMore.startedAt = tick()
  drinkTestMore.character = testPlayerCharacter
  drinkTestMore.postDrinkLandingWitness = nil

  if Settings.terrainEmbedWatch then
    Settings.terrainEmbedWatch.postDrink = nil
  end

  drinkTestMore.entryPosition = testTestSmoothMove.Position
  drinkTestMore.entryGroundClearance = nil

  if isNotJungleLife and Settings.safeMovementAnimalKey(testPlayerCharacter) == "elephant"
    and not Settings.isCharacterSwimmingState(testPlayerCharacter)
