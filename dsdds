end

function Settings.slotParkingAuditLaunch(...)
  local slotParkingAudiSetting = Settings.slotParkingAudit

  if not slotParkingAudiSetting or not slotParkingAudiSetting.active or slotParkingAudiSetting.busy
    or slotParkingAudiSetting.launchPending then
    return false
  end

  slotParkingAudiSetting.launchPending = true

  task.spawn(function(...)
    slotParkingAudiSetting.launchPending = false

    if not Settings.alive or not slotParkingAudiSetting.active or slotParkingAudiSetting.busy then
      return
    end

    local pcallResultLaunch, slotParkingAuditRunConfig = pcall(Settings.slotParkingAuditRun)

    if pcallResultLaunch or not slotParkingAudiSetting.active then
      return
    end

    slotParkingAudiSetting.busy = false

    slotParkingAudiSetting.executorErrorCount = (tonumber(slotParkingAudiSetting.executorErrorCount) or 0)
      + 1

    slotParkingAudiSetting.lastExecutorError = tostring(slotParkingAuditRunConfig):gsub("[%c]", " "):sub(1, 140)

    local launchLocalValue = tostring(slotParkingAudiSetting.phase or "unknown")
    pcall(warn, "[KITTY final parking audit | " .. launchLocalValue .. "] " .. tostring(slotParkingAuditRunConfig))

    if tostring(slotParkingAuditRunConfig):find("attempt to call a nil value", 1, true) ~= nil
      or slotParkingAudiSetting.executorErrorCount >= 3 then
      Settings.slotParkingAuditAbort("Final parking audit error at " .. launchLocalValue .. ": "
        .. slotParkingAudiSetting.lastExecutorError)

      return
    end

    strLitInf = string.format(
      "Final audit retry %d/3 on slot %d (%s): %s", slotParkingAudiSetting.executorErrorCount,
      tonumber(slotParkingAudiSetting.index) or 1, launchLocalValue, slotParkingAudiSetting.lastExecutorError
    )

    helper(1.5, function(...)
      if Settings.alive and slotParkingAudiSetting.active and not slotParkingAudiSetting.busy then
        Settings.slotParkingAuditLaunch()
      end
    end)
  end)

  return true
end

